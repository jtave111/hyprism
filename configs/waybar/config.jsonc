// Waybar config shipped by Hyprism.
//
// Hyprism rewrites only the three "modules-*" lines (hyprism modules) plus
// "height"/"position" (hyprism bar). Colors and the bar style live in
// style.css, generated by `hyprism render`. Everything else is yours to edit.
//
// Icons are Nerd Font glyphs (install ttf-nerd-fonts-symbols).
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,

  "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/submap", "hyprland/window"],
  "modules-center": ["custom/media"],
  "modules-right": ["hyprland/language", "idle_inhibitor", "cpu", "memory", "disk", "pulseaudio", "network", "battery", "clock", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "hyprism-launcher",
    "on-click-right": "hyprism-open visualconf"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/submap": {
    "format": "󰍹 {}",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 55,
    "separate-outputs": true
  },

  "custom/media": {
    "format": " {}",
    "max-length": 45,
    "interval": 3,
    "exec": "playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null | head -c 55",
    "exec-if": "playerctl status 2>/dev/null | grep -qE 'Playing|Paused'",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "tooltip": false
  },

  "hyprland/language": {
    "format": " {short}",
    "tooltip-format": "{long}"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "", "deactivated": "" },
    "tooltip-format-activated": "Screen stays on",
    "tooltip-format-deactivated": "Normal idle"
  },

  "temperature": {
    "critical-threshold": 85,
    "interval": 15,
    "format": " {temperatureC}°",
    "tooltip-format": "{temperatureC}°C"
  },

  "disk": {
    "path": "/",
    "interval": 60,
    "format": " {percentage_used}%",
    "tooltip-format": "{used} / {total} ({path})",
    "on-click": "hyprism-open hyprism-settings storage"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },

  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip-format": "{load}"
  },

  "backlight": {
    "format": " {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "headphone": "", "headset": "", "default": ["", "", ""] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "hyprism-open hyprism-settings sound",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc}"
  },

  "network": {
    "interval": 5,
    "format-wifi": " {signalStrength}%",
    "format-ethernet": " wired",
    "format-disconnected": " off",
    "tooltip-format-wifi": "{essid}\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "hyprism-open hyprism-settings network"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "interval": 10,
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}",
    "on-click": "hyprism-open hyprism-settings power"
  },

  "clock": {
    "interval": 10,
    "format": " {:%H:%M}",
    "format-alt": " {:%a, %d/%m}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month", "format": { "today": "<b>{}</b>" } }
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "Session",
    "on-click": "hyprism-power"
  }
}
