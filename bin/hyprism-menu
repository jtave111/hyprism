#!/usr/bin/env bash
# =====================================================================
#  hyprism-menu — a BlackArch-style categorized application menu for
#  Hyprland, rendered with rofi and opened at the cursor. Part of Hyprism.
#
#  The taxonomy is data-driven from pacman groups (blackarch-*), so it is
#  always complete and needs no hand-maintenance; only INSTALLED tools show.
#  Tools are grouped into a handful of specialties (submenus) instead of a
#  flat wall of 50+ categories.
#
#  Trigger: right-click on the empty desktop (see hyprism-desktop), or run
#  directly. Navigation: pick a submenu to descend, ESC to go back/close.
# =====================================================================
set -u

have(){ command -v "$1" >/dev/null 2>&1; }
have rofi || { command -v notify-send >/dev/null && notify-send 'Hyprism' 'rofi is required for the app menu'; exit 1; }

ARROW=' ▸'                       # submenu marker (also used to detect submenus)
noarrow(){ printf '%s' "${1%"$ARROW"}"; }   # strip the trailing submenu marker

# ---- installed-package cache (queried many times) --------------------
QLIST=$(pacman -Qq 2>/dev/null | sort -u)

group_tools(){ # group_tools <blackarch-group> -> installed members, sorted
  comm -12 <(pacman -Sqg "$1" 2>/dev/null | sort -u) <(printf '%s\n' "$QLIST")
}
have_pkg(){ printf '%s\n' "$QLIST" | grep -qx "$1"; }

# ---- specialties: label + the blackarch groups they contain ----------
# Order here is the display order. Groups with no installed tool are hidden.
SPEC_LABELS=(
  "Recon & OSINT"
  "Web & Apps"
  "Exploitation & Access"
  "Networks & Wireless"
  "Reversing & Binary"
  "Forensics & Defense"
  "Hardware & Radio"
  "Crypto & Wordlists"
  "Misc"
)
spec_groups(){ # spec_groups <label> -> space-separated blackarch groups
  case "$1" in
    "Recon & OSINT")          echo "recon fingerprint scanner social database" ;;
    "Web & Apps")             echo "webapp code-audit fuzzer proxy mobile" ;;
    "Exploitation & Access")  echo "exploitation backdoor dos malware keylogger honeypot" ;;
    "Networks & Wireless")    echo "networking wireless bluetooth sniffer spoof tunnel nfc voip" ;;
    "Reversing & Binary")     echo "reversing binary debugger disassembler decompiler packer unpacker" ;;
    "Forensics & Defense")    echo "forensic anti-forensic defensive ids threat-model stego" ;;
    "Hardware & Radio")       echo "hardware radio firmware drone automobile gpu" ;;
    "Crypto & Wordlists")     echo "crypto cracker wordlist" ;;
    "Misc")                   echo "automation ai config windows misc" ;;
  esac
}
# Pretty title for a raw blackarch group (hyphens -> spaces, title-ish).
group_title(){ printf '%s' "$1" | sed -E 's/-/ /g; s/\b(.)/\u\1/g'; }

# ---- GUI allow-list: launched directly; everything else via terminal --
GUI_APPS=" wireshark zaproxy burpsuite ghidra cutter jd-gui bettercap-ui \
  ettercap-graphical zenmap remmina hashcat-utils gparted "
is_gui(){ case "$GUI_APPS" in *" $1 "*) return 0;; esac; return 1; }

# ---- launch -----------------------------------------------------------
run_tool(){ # run_tool <pkg>
  local exe="$1"
  # Prefer the package name as the command; fall back to any binary it owns.
  have "$exe" || exe=$(pacman -Ql "$1" 2>/dev/null | awk '$2 ~ /\/bin\/[^/]+$/ {print $2; exit}')
  [ -n "$exe" ] || exe="$1"
  if is_gui "$1"; then
    setsid "$exe" >/dev/null 2>&1 </dev/null &
  else
    setsid kitty -e "$exe" >/dev/null 2>&1 </dev/null &
  fi
}
run_cmd(){ setsid sh -c "$*" >/dev/null 2>&1 </dev/null & }

# ---- rofi positioned at the cursor -----------------------------------
pos_theme(){
  local x y W H mw=340 mh=520
  read -r x y < <(hyprctl cursorpos 2>/dev/null | tr -d ',')
  [ -z "${x:-}" ] && { echo ""; return; }
  read -r W H < <(hyprctl monitors -j 2>/dev/null \
     | awk -F'[:,]' '/"width"/{w=$2} /"height"/{print w, $2; exit}')
  [ -n "${W:-}" ] && [ "$x" -gt "$((W-mw))" ] && x=$((W-mw)); [ "$x" -lt 0 ] && x=0
  [ -n "${H:-}" ] && [ "$y" -gt "$((H-mh))" ] && y=$((H-mh)); [ "$y" -lt 0 ] && y=0
  printf 'window{location:north west;anchor:north west;x-offset:%dpx;y-offset:%dpx;width:%dpx;}' "$x" "$y" "$mw"
}
THEME=$(pos_theme)

menu(){ # menu <prompt> < entries ; echoes selection
  local prompt="$1"
  if [ -n "$THEME" ]; then
    rofi -dmenu -i -p "$prompt" -theme-str "$THEME"
  else
    rofi -dmenu -i -p "$prompt"
  fi
}

# ---- levels -----------------------------------------------------------
level_category(){ # <blackarch-group>
  local g="$1" sel tools
  tools=$(group_tools "$g")
  [ -z "$tools" ] && return 0
  while :; do
    sel=$(printf '%s\n' "$tools" | menu "$(group_title "$g")") || return 0
    [ -z "$sel" ] && return 0
    run_tool "$sel"; exit 0
  done
}

level_specialty(){ # <specialty label>
  local label="$1" g glist sel
  # only groups that actually have installed tools, titled + arrow
  glist=""
  for g in $(spec_groups "$label"); do
    [ -n "$(group_tools "blackarch-$g")" ] && glist+="$(group_title "$g")$ARROW"$'\n'
  done
  [ -z "$glist" ] && return 0
  while :; do
    sel=$(printf '%s' "$glist" | menu "$label") || return 0
    [ -z "$sel" ] && return 0
    # map the titled category back to its raw blackarch group
    local raw; raw=$(noarrow "$sel" | sed -E 's/ /-/g' | tr '[:upper:]' '[:lower:]')
    level_category "blackarch-$raw"
  done
}

level_blackarch(){
  local sel list
  list=""
  local s
  for s in "${SPEC_LABELS[@]}"; do
    # show a specialty only if any of its groups has installed tools
    local any=0 g
    for g in $(spec_groups "$s"); do [ -n "$(group_tools "blackarch-$g")" ] && { any=1; break; }; done
    [ "$any" = 1 ] && list+="$s$ARROW"$'\n'
  done
  while :; do
    sel=$(printf '%s' "$list" | menu "BlackArch") || return 0
    [ -z "$sel" ] && return 0
    level_specialty "$(noarrow "$sel")"
  done
}

level_terminals(){
  local t list="" sel
  for t in kitty alacritty foot wezterm konsole gnome-terminal xterm st urxvt; do
    have "$t" && list+="$t"$'\n'
  done
  sel=$(printf '%s' "$list" | menu "Terminals") || return 0
  [ -n "$sel" ] && { setsid "$sel" >/dev/null 2>&1 </dev/null & exit 0; }
}

level_browsers(){
  local b list="" sel
  for b in firefox librewolf chromium google-chrome-stable brave brave-browser vivaldi-stable qutebrowser tor-browser epiphany; do
    have "$b" && list+="$b"$'\n'
  done
  [ -z "$list" ] && return 0
  sel=$(printf '%s' "$list" | menu "Browsers") || return 0
  [ -n "$sel" ] && { setsid "$sel" >/dev/null 2>&1 </dev/null & exit 0; }
}

root_menu(){
  local sel list
  list="Terminals$ARROW"$'\n'"Browsers$ARROW"$'\n'
  have thunar && list+="Files"$'\n'
  list+="BlackArch$ARROW"$'\n'"Settings (Hyprism)"$'\n'"Lock screen"
  while :; do
    sel=$(printf '%s' "$list" | menu "Apps") || exit 0
    case "$sel" in
      "Terminals$ARROW") level_terminals ;;
      "Browsers$ARROW")  level_browsers ;;
      "Files")           setsid thunar >/dev/null 2>&1 </dev/null & exit 0 ;;
      "BlackArch$ARROW") level_blackarch ;;
      "Settings (Hyprism)") setsid kitty --class hyprism-center -e hyprism menu >/dev/null 2>&1 </dev/null & exit 0 ;;
      "Lock screen")     have hyprlock && { setsid hyprlock >/dev/null 2>&1 </dev/null & exit 0; } ;;
      "" ) exit 0 ;;
    esac
  done
}

root_menu
