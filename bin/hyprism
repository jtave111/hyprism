lang_init(){ LANGX=$(sget lang); case "$LANGX" in pt|en) ;; *) LANGX=en ;; esac
  [ "$LANGX" = pt ] && declare -F load_pt >/dev/null && load_pt; return 0; }

usage(){
  u(){ printf '  %-46s %s\n' "$1" "$2"; }
  printf '%s\n\n' "$(t 'Hyprism — one palette, the whole spectrum.')"
  printf '%s\n' "$(t 'usage'): hyprism [$(t 'command')] [$(t 'argument')]"
  printf '\n'
  u 'hyprism'                                    "$(t 'open the visual center (visualconf); built-in menu if it is missing')"
  u 'hyprism menu'                               "$(t 'same as no argument')"
  u 'hyprism <palette>'                          "$(t 'apply a palette directly')"
  printf '\n'
  u 'palette'                                    "$(t 'pick a palette with a live preview')"
  u 'wallpaper'                                  "$(t 'wallpaper, with a terminal preview')"
  u 'appearance'                                 "$(t 'border width, corners and spacing')"
  u 'borders'                                    "$(t 'window border color')"
  u 'effects [performance|subtle|glass|focus]'   "$(t 'blur, shadow, opacity and focus')"
  u 'animations [off|fast|balanced|smooth|elastic]' "$(t 'presets for windows, layers and workspaces')"
  u 'bar'                                        "$(t 'height and position of the bar')"
  u 'style [flat|pills|segmented]'               "$(t 'bar look: flat / pills / segmented + tuning')"
  u 'modules'                                    "$(t 'what appears on the bar, item by item')"
  u 'windows'                                    "$(t 'opening, layout, snapping and focus')"
  u 'workspaces'                                 "$(t 'count, rules, layout and navigation')"
  u 'input'                                      "$(t 'keyboard, mouse, touchpad and gestures')"
  u 'cursor'                                     "$(t 'theme, size and when to hide')"
  u 'lock'                                       "$(t 'background, clock and cursor of hyprlock')"
  u 'sddm | login'                               "$(t 'login screen theme (SDDM), like picking a wallpaper')"
  u 'notifications'                              "$(t 'position, size, timeout and icons')"
  u 'network'                                    "$(t 'Wi-Fi, VPN, fixed IP, hostname, status')"
  u 'system'                                     "$(t 'network, sound, bluetooth, displays')"
  u 'font'                                       "$(t 'family and size of the bar')"
  u 'binds'                                      "$(t 'see the keybinding list')"
  u 'preset [list|<name>]'                       "$(t 'save or load a whole look')"
  u 'config'                                     "$(t 'see everything active')"
  u 'lang [en|pt]'                               "$(t 'switch the interface language')"
  u 'sync'                                       "$(t 'reapply the global theme to Kitty and Rofi')"
  u 'render'                                     "$(t 'regenerate every file from the current state')"
  printf '\n'
  u '-l, --list'                                 "$(t 'list the palettes')"
  u '-r, --random'                               "$(t 'apply a random palette')"
  u '-g, --generate'                             "$(t 'regenerate the palettes from the kitty themes')"
  u '-V, --version'                              "$(t 'print the version')"
  u '-h, --help'                                 "$(t 'show this help')"
  unset -f u
}

version(){
  local v; v=$(cat "$HYPRISM_ROOT/VERSION" 2>/dev/null)
  printf 'hyprism %s\n' "${v:-unknown}"
}

# ---------- state ----------
sget(){ grep -m1 "^$1=" "$SET" 2>/dev/null | cut -d= -f2-; }
# Writes/removes one key. Values go through the environment (never through a
# sed/awk program or awk -v, which would interpret & | \ and escapes). The file
# is rewritten atomically (tmp + mv), or written through when it is a symlink.
_state_write(){  # _state_write MODE(set|del) KEY [VALUE]
  local tmp
  [ -e "$SET" ] || : > "$SET"
  tmp=$(mktemp "$TD/.state.XXXXXX") || return 1
  HK="$2" HV="${3:-}" HM="$1" awk '
    BEGIN { k = ENVIRON["HK"]; v = ENVIRON["HV"]; m = ENVIRON["HM"]; n = length(k) + 1; done = 0 }
    substr($0, 1, n) == k "=" { if (m == "set" && !done) print k "=" v; done = 1; next }
    { print }
    END { if (m == "set" && !done) print k "=" v }
  ' "$SET" > "$tmp" || { rm -f "$tmp"; return 1; }
  _state_commit "$tmp"
}
_state_commit(){  # replace .state with the finished temp file $1
  if [ -L "$SET" ]; then
    cat "$1" > "$SET"; rm -f "$1"
  else
    chmod --reference="$SET" "$1" 2>/dev/null || chmod 644 "$1"
    mv -f "$1" "$SET"
  fi
}
# Merges a file of key=value lines into .state in one pass: listed keys get the
# new value, every other key is kept untouched, new keys are appended.
_state_merge(){
  local tmp
  [ -e "$SET" ] || : > "$SET"
  tmp=$(mktemp "$TD/.state.XXXXXX") || return 1
  awk '
    NR == FNR { i = index($0, "="); if (i > 1) { k = substr($0, 1, i - 1)
                  if (!(k in val)) order[++n] = k; val[k] = substr($0, i + 1) }; next }
    { i = index($0, "=")
      if (i > 1) { k = substr($0, 1, i - 1)
        if (k in val) { if (!(k in done)) { print k "=" val[k]; done[k] = 1 }; next } }
      print }
    END { for (j = 1; j <= n; j++) { k = order[j]; if (!(k in done)) print k "=" val[k] } }
  ' "$1" "$SET" > "$tmp" || { rm -f "$tmp"; return 1; }
  _state_commit "$tmp"
}
sset(){ local v="${2-}"; v=${v//$'\n'/ }; _state_write set "$1" "$v"; }
sdel(){ grep -q "^$1=" "$SET" 2>/dev/null || return 0; _state_write del "$1"; }
# Default only when the key does not exist at all: an empty value is a valid,
# deliberate choice (e.g. kb_variant=). seed() preloads the existing keys so
# checking ~100 defaults does not fork one grep per key.
declare -A SEEN=()
seen_load(){ SEEN=(); local k _v
  [ -f "$SET" ] || return 0
  while IFS='=' read -r k _v; do [ -n "$k" ] && SEEN[$k]=1; done < "$SET"; }
def(){ [ -n "${SEEN[$1]+x}" ] && return 0
  grep -q "^$1=" "$SET" 2>/dev/null || sset "$1" "$2"; SEEN[$1]=1; }
# Like def, but the default comes from a function, run only when needed.
defl(){ [ -n "${SEEN[$1]+x}" ] && return 0
  grep -q "^$1=" "$SET" 2>/dev/null || sset "$1" "$("$2")"; SEEN[$1]=1; }

# ---------- system-derived defaults ----------
has_battery(){ compgen -G '/sys/class/power_supply/BAT*' >/dev/null; }
has_backlight(){ compgen -G '/sys/class/backlight/*' >/dev/null; }
has_touchpad(){
  if have hyprctl && hyprctl devices -j 2>/dev/null | grep -qi 'touchpad'; then return 0; fi
  grep -qi 'touchpad' /proc/bus/input/devices 2>/dev/null
}
sys_kb_layout(){
  local l=""
  have localectl && l=$(localectl status 2>/dev/null | awk -F': *' '/X11 Layout/{print $2; exit}')
  l=${l// /}
  printf '%s' "${l:-us}"
}
cursor_exists(){
  local d
  for d in "$HOME/.local/share/icons" "$HOME/.icons" /usr/share/icons; do
    [ -d "$d/$1/cursors" ] && return 0
  done
  return 1
}
sys_cursor(){
  local c
  for c in "${HYPRCURSOR_THEME:-}" "${XCURSOR_THEME:-}" \
           "$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")"; do
    [ -n "$c" ] && cursor_exists "$c" && { printf '%s' "$c"; return 0; }
  done
  printf 'Adwaita'
}
sys_barfont(){
  local f
  if have fc-list; then
    for f in "FiraCode Nerd Font Mono" "JetBrainsMono Nerd Font" "Symbols Nerd Font"; do
      fc-list -q ":family=$f" 2>/dev/null && { printf '%s' "$f"; return 0; }
    done
  fi
  printf 'monospace'
}
hw_battery_default(){ has_battery && echo on || echo off; }
hw_backlight_default(){ has_backlight && echo on || echo off; }

seed(){
  seen_load
  def border 1;         def rounding 0;    def rounding_power 2.0
  def gaps_in 2;        def gaps_out 4
  def blur off;         def blur_size 6;   def blur_passes 2
  def blur_xray nao;    def blur_brightness 1.0; def blur_vibrancy 0.17
  def shadow off;       def shadow_range 14; def shadow_power 3
  def shadow_scale 1.0; def shadow_offset_x 0; def shadow_offset_y 2
  def active_op 100;    def inactive_op 100; def fullscreen_op 100
  def dim_inactive nao; def dim_strength 10
  def anim rapida
  def float_all sim;    def win_size "50% 50%"
  def layout dwindle;   def snap sim;      def snap_gap 10
  def snap_overlap nao; def snap_respect_gaps sim
  def resize_border sim; def focus_activate nao; def preserve_split sim
  def workspace_count 9; def workspace_persistent nao
  def workspace_smart_gaps nao; def workspace_layout global
  def workspace_gap 0;  def workspace_wrap nao; def workspace_backforth sim
  def bar_enabled on;   def barh 26;       def barpos bottom
  defl barfont sys_barfont; def barsize 12
  def bar_style flat;   def bar_margin 0;  def bar_radius 0;  def bar_gap 0
  def lang en
  defl kb_layout sys_kb_layout; def kb_variant ""
  def follow_mouse 1;   def mouse_sensitivity 0; def mouse_scroll 1.0
  def mouse_natural nao
  def touch_natural sim; def touch_tap sim; def touch_dwt sim
  def touch_scroll 1.0; def gesture_fingers 3
  defl cursor_theme sys_cursor; def cursor_size 24
  def cursor_hide_key nao; def cursor_timeout 0
  def lock_blur 3;      def lock_brightness 50
  def lock_clock sim;   def lock_hide_cursor sim
  def lock_bg wallpaper; def lock_bg_image ""
  def lock_clock_size 128; def lock_clock_color fg; def lock_clock_24h sim
  def lock_frame nao;   def lock_avatar sim; def lock_message ""
  def lock_field_style square; def lock_field_width 240; def lock_field_pos mid
  def notif_position top-right; def notif_width 360
  def notif_timeout 8;  def notif_icons sim

  # Migrate names used by the old version without losing the choice. An
  # unknown value never reaches Lua: it falls back to the fast, safe preset.
  case "$(sget anim)" in
    rapido)  sset anim rapida ;;
    nenhuma) sset anim desligada ;;
    rapida|equilibrada|suave|elastica|desligada) ;;
    *) sset anim rapida ;;
  esac

  # The old border_active knob was never read (the active border is the
  # accent); drop it from existing states.
  [ -n "${SEEN[border_active]+x}" ] && sdel border_active

  # Current bar modules. The first two stay off to preserve the look without
  # a launcher/workspace number. Battery/backlight default on only when the
  # hardware exists.
  def bar_launcher off; def bar_workspaces off; def bar_window on
  def bar_media on;     def bar_language on;     def bar_idle on
  def bar_temperature on; def bar_disk on;       def bar_memory on
  def bar_cpu on;       defl bar_backlight hw_backlight_default; def bar_audio on
  def bar_network on;   def bar_tray off;        defl bar_battery hw_battery_default
  def bar_clock on;     def bar_power on
  return 0
}

# ---------- color ----------
rgb(){ local h="${1#\#}"; printf '%d %d %d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
mix(){ local ar ag ab br bg bb p="$3"
  read -r ar ag ab <<<"$(rgb "$1")"; read -r br bg bb <<<"$(rgb "$2")"
  printf '#%02x%02x%02x' $(( (ar*p + br*(100-p))/100 )) \
                         $(( (ag*p + bg*(100-p))/100 )) \
                         $(( (ab*p + bb*(100-p))/100 )); }
is_dark(){ local r g b; read -r r g b <<<"$(rgb "$1")"
  [ $(( (r*299 + g*587 + b*114)/1000 )) -lt 128 ]; }
afg(){ local r g b; read -r r g b <<<"$(rgb "$1")"; printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"; }
abg(){ local r g b; read -r r g b <<<"$(rgb "$1")"; printf '\033[48;2;%d;%d;%dm' "$r" "$g" "$b"; }
Z=$'\033[0m'

# ---------- palettes ----------
kval(){ grep -m1 -E "^$2([[:space:]]|\$)" "$1" 2>/dev/null | awk '{print $2}'; }

write_pal(){ cat > "$PAL/$1.env" <<EOF
# palette: $1
# source: ${11}
bg=$2
bg2=$3
fg=$4
dim=$5
line=$6
accent=$7
accent_lit=$8
sel=$9
on_accent=${10}
EOF
}

gen_from_kitty(){
  local f="$1" name bgc fgc active_border active_tab cur c1 selbg accent lit dim line bg2 onacc
  name=$(basename "$f" .conf)
  bgc=$(kval "$f" background); fgc=$(kval "$f" foreground)
  { [ -z "$bgc" ] || [ -z "$fgc" ]; } && return 1
  active_border=$(kval "$f" active_border_color)
  active_tab=$(kval "$f" active_tab_background)
  cur=$(kval "$f" cursor); c1=$(kval "$f" color1)
  selbg=$(kval "$f" selection_background)
  # Kitty's visual accent is the active border/tab, not the cursor. Using the
  # cursor made BlackArch red and almost identical to Terminal Red, even though
  # Kitty shows the violet #5f5faf highlight.
  accent="${active_border:-${active_tab:-${cur:-${c1:-#888888}}}}"
  dim=$(mix "$fgc" "$bgc" 45); line=$(mix "$fgc" "$bgc" 16); bg2=$(mix "$fgc" "$bgc" 6)
  if is_dark "$bgc"; then lit=$(mix "$accent" "#ffffff" 70); onacc="#ffffff"
  else                    lit=$(mix "$accent" "#000000" 72); onacc="#111111"; fi
  selbg="${selbg:-$(mix "$accent" "$bgc" 18)}"
  write_pal "$name" "$bgc" "$bg2" "$fgc" "$dim" "$line" "$accent" "$lit" "$selbg" "$onacc" \
            "${f/#$HOME/\~}"
}

gen_palettes(){
  local n=0 f
  for f in "$KTD"/*.conf; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in current.conf) continue;; esac
    gen_from_kitty "$f" && n=$((n+1))
  done
  write_pal "sddm-terminal-red" "#000000" "#0a0000" "#cccccc" "#666666" "#333333" \
            "#8b0000" "#cc2200" "#8b0000" "#ffffff" "SDDM terminal-red theme"
  n=$((n+1))
  ok "$n $(t 'palettes in') ${PAL/#$HOME/\~}"
}

palettes(){ find "$PAL" -maxdepth 1 -name '*.env' -printf '%f\n' 2>/dev/null | sed 's/\.env$//' | sort; }
# A hand-made palette may define only some colors: derive the missing ones so
# no generator ever expands an unset variable (set -u would abort).
pal_fill(){
  : "${bg:=#000000}" "${fg:=#cccccc}"
  : "${accent:=${accent_lit:-#888888}}"
  [ -n "${bg2:-}" ]  || bg2=$(mix "$fg" "$bg" 6)
  [ -n "${dim:-}" ]  || dim=$(mix "$fg" "$bg" 45)
  [ -n "${line:-}" ] || line=$(mix "$fg" "$bg" 16)
  [ -n "${sel:-}" ]  || sel=$(mix "$accent" "$bg" 18)
  if [ -z "${accent_lit:-}" ]; then
    if is_dark "$bg"; then accent_lit=$(mix "$accent" "#ffffff" 70)
    else                   accent_lit=$(mix "$accent" "#000000" 72); fi
  fi
  if [ -z "${on_accent:-}" ]; then
    if is_dark "$bg"; then on_accent="#ffffff"; else on_accent="#111111"; fi
  fi
  export bg bg2 fg dim line accent accent_lit sel on_accent
}
# shellcheck source=/dev/null
loadpal(){ unset bg bg2 fg dim line accent accent_lit sel on_accent
  [ -f "$PAL/$1.env" ] && { set -a; . "$PAL/$1.env"; set +a; }; pal_fill; }
# The palette to use: the requested/active one, else sddm-terminal-red, else
# the first palette found, else freshly generated ones. Never a missing file.
pal_resolve(){
  local name="${1:-}" f
  [ -n "$name" ] && [ -f "$PAL/$name.env" ] && { printf '%s' "$name"; return 0; }
  [ -f "$PAL/sddm-terminal-red.env" ] && { printf 'sddm-terminal-red'; return 0; }
  f=$(palettes | head -1)
  if [ -z "$f" ]; then gen_palettes >/dev/null 2>&1; f=$(palettes | head -1); fi
  [ -n "$f" ] && { printf '%s' "$f"; return 0; }
  return 1
}
active_pal(){ pal_resolve "$(cat "$STATE" 2>/dev/null)"; }
# One color of the active palette (with the pal_fill defaults), no side effects.
pal_get(){ ( loadpal "$(active_pal)" 2>/dev/null; printf '%s' "${!1:-}" ); }

# ---------- generators ----------
onoff(){ [ "$1" = "on" ] && echo true || echo false; }
yesno(){ [ "$1" = "sim" ] && echo true || echo false; }

gen_look(){
  cat > "$LOOK" <<EOF
-- Generated by Hyprism — do not edit by hand. Use: hyprism
return {
    border           = $(sget border),
    rounding         = $(sget rounding),
    rounding_power   = $(sget rounding_power),
    gaps_in          = $(sget gaps_in),
    gaps_out         = $(sget gaps_out),

    blur             = $(onoff "$(sget blur)"),
    blur_size        = $(sget blur_size),
    blur_passes      = $(sget blur_passes),
    blur_xray        = $(yesno "$(sget blur_xray)"),
    blur_brightness  = $(sget blur_brightness),
    blur_vibrancy    = $(sget blur_vibrancy),

    shadow           = $(onoff "$(sget shadow)"),
    shadow_range     = $(sget shadow_range),
    shadow_power     = $(sget shadow_power),
    shadow_scale     = $(sget shadow_scale),
    shadow_offset_x  = $(sget shadow_offset_x),
    shadow_offset_y  = $(sget shadow_offset_y),

    active_opacity   = $(awk "BEGIN{printf \"%.2f\", $(sget active_op)/100}"),
    inactive_opacity = $(awk "BEGIN{printf \"%.2f\", $(sget inactive_op)/100}"),
    fullscreen_opacity = $(awk "BEGIN{printf \"%.2f\", $(sget fullscreen_op)/100}"),
    dim_inactive     = $(yesno "$(sget dim_inactive)"),
    dim_strength     = $(awk "BEGIN{printf \"%.2f\", $(sget dim_strength)/100}"),
    anim             = "$(sget anim)",

    float_all        = $([ "$(sget float_all)" = "sim" ] && echo true || echo false),
    win_size         = "$(sget win_size)",
    layout           = "$(sget layout)",
    snap             = $(yesno "$(sget snap)"),
    snap_gap         = $(sget snap_gap),
    snap_overlap     = $(yesno "$(sget snap_overlap)"),
    snap_respect_gaps = $(yesno "$(sget snap_respect_gaps)"),
    resize_border    = $(yesno "$(sget resize_border)"),
    focus_activate   = $(yesno "$(sget focus_activate)"),
    preserve_split   = $(yesno "$(sget preserve_split)"),

    workspace_count      = $(sget workspace_count),
    workspace_persistent = $(yesno "$(sget workspace_persistent)"),
    workspace_smart_gaps = $(yesno "$(sget workspace_smart_gaps)"),
    workspace_layout     = "$(sget workspace_layout)",
    workspace_gap        = $(sget workspace_gap),
    workspace_wrap       = $(yesno "$(sget workspace_wrap)"),
    workspace_backforth  = $(yesno "$(sget workspace_backforth)"),

    kb_layout        = "$(sget kb_layout)",
    kb_variant       = "$(sget kb_variant)",
    follow_mouse     = $(sget follow_mouse),
    mouse_sensitivity = $(sget mouse_sensitivity),
    mouse_scroll     = $(sget mouse_scroll),
    mouse_natural    = $(yesno "$(sget mouse_natural)"),
    touch_natural    = $(yesno "$(sget touch_natural)"),
    touch_tap        = $(yesno "$(sget touch_tap)"),
    touch_dwt        = $(yesno "$(sget touch_dwt)"),
    touch_scroll     = $(sget touch_scroll),
    gesture_fingers  = $(sget gesture_fingers),

    cursor_theme     = "$(sget cursor_theme)",
    cursor_size      = $(sget cursor_size),
    cursor_hide_key  = $(yesno "$(sget cursor_hide_key)"),
    cursor_timeout   = $(sget cursor_timeout),

    bar_enabled      = $(onoff "$(sget bar_enabled)"),
}
EOF
}

gen_colors(){
  # Active border = the accent (already adjusted by apply_accent: manual color
  # from the Borders menu + brightness). Inactive = border_inactive or line.
  local ba bi
  ba="$accent"
  bi=$(sget border_inactive); [ -z "$bi" ] && bi="$line"

  cat > "$COLORS" <<EOF
-- Generated by Hyprism — do not edit by hand.
-- Active palette: $1
return {
    name       = "$1",
    bg         = "$bg",
    bg2        = "$bg2",
    fg         = "$fg",
    dim        = "$dim",
    line       = "$line",
    accent     = "$accent",
    accent_lit = "$accent_lit",
    sel        = "$sel",
    on_accent  = "${on_accent:-#ffffff}",

    -- window borders (hyprism appearance)
    border_active   = "$ba",
    border_inactive = "$bi",
}
EOF
}

# The bar stylesheet is generated from the active palette (never hardcoded
# colors, so every theme — light or dark — works) plus the chosen visual
# style. Three styles share one head (colors + font reset) and then emit their
# own structural block: 'flat' (attached, minimal — the default), 'pills'
# (floating, one rounded chip per module) and 'segmented' (attached, rounded
# module clusters). Margin/radius/gap are user knobs read from .state.
gen_waybar(){
  local style margin radius gap edge
  style=$(sget bar_style); case "$style" in flat|pills|segmented) ;; *) style=flat ;; esac
  # The accent rule sits on the edge facing the windows.
  case "$(sget barpos)" in
    top) edge=bottom ;; left) edge=right ;; right) edge=left ;; *) edge=top ;;
  esac
  margin=$(sget bar_margin); [ -z "$margin" ] && margin=0
  radius=$(sget bar_radius); [ -z "$radius" ] && radius=0
  gap=$(sget bar_gap);       [ -z "$gap" ]    && gap=0

  {
  cat <<EOF
/* Generated by Hyprism — palette $1, style $style. Do not edit by hand. */
@define-color bg $bg; @define-color bg2 $bg2; @define-color fg $fg;
@define-color dim $dim; @define-color line $line;
@define-color accent $accent; @define-color lit $accent_lit; @define-color sel $sel;

* { font-family: "$(sget barfont)", "Symbols Nerd Font", monospace; font-size: $(sget barsize)px;
    min-height: 0; border: none; border-radius: 0; box-shadow: none; text-shadow: none; }
window#waybar.hidden { opacity: 0.0; }
EOF

  case "$style" in
  flat) cat <<EOF
window#waybar { background: @bg; color: @fg; border-${edge}: 1px solid @accent; }

#custom-launcher, #workspaces, #window, #tray, #pulseaudio, #network,
#cpu, #memory, #backlight, #battery, #clock, #temperature, #disk,
#language, #idle_inhibitor, #custom-media, #custom-power {
    background: transparent; padding: 0 9px; margin: 0; color: @dim;
}
#custom-launcher { color: @accent; font-size: $(sget barsize)px;
                   padding: 0 14px; background: @bg2; }
#custom-launcher:hover { background: @sel; color: #ffffff; }

/* Indicators: a thin vertical rule between each, without clutter */
#language, #idle_inhibitor, #temperature, #disk, #memory, #cpu,
#backlight, #pulseaudio, #network, #battery {
    border-left: 1px solid @line;
}
#language:hover, #idle_inhibitor:hover, #temperature:hover, #disk:hover,
#memory:hover, #custom-media:hover, #custom-power:hover { color: @lit; }

/* Now playing: a discreet highlight in the center */
#custom-media { color: @dim; font-style: italic; padding: 0 14px; }

/* Alerts */
#temperature.critical { color: #ffffff; background: @sel; }
#idle_inhibitor.activated { color: @accent; }

/* Session button: the only item closing the bar on the right */
#custom-power { color: @accent; background: @bg2; padding: 0 13px;
                border-left: 1px solid @line; }
#custom-power:hover { background: @sel; color: #ffffff; }

#workspaces button { padding: 0 9px; color: @dim; background: transparent;
                     border-bottom: 2px solid transparent; }
#workspaces button.active { color: @fg; background: @bg2; border-bottom: 2px solid @accent; }
#workspaces button.urgent { color: #ffffff; background: @sel; }
#workspaces button:hover { background: @bg2; color: @fg; border-bottom: 2px solid @line; }

#window { color: @fg; padding: 0 12px; }
#tray { background: @bg2; padding: 0 8px; }
#tray menu { background: @bg2; color: @fg; }
#pulseaudio:hover, #network:hover, #cpu:hover, #memory:hover, #backlight:hover { color: @lit; }
#pulseaudio.muted, #network.disconnected { color: @accent; }
#battery.charging { color: @fg; }
#battery.warning:not(.charging) { color: @lit; }
#battery.critical:not(.charging) { color: #ffffff; background: @sel; }
#clock { color: @fg; background: @bg2; padding: 0 14px; border-left: 1px solid @line; }
tooltip { background: @bg2; border: 1px solid @line; color: @fg; }
tooltip label { color: @fg; }
EOF
  ;;
  pills) cat <<EOF
/* Floating pills: transparent bar, each module a rounded chip. The float comes
   from the transparent window + a taller bar (set by bar_style_set) showing the
   wallpaper around the chips; side margin insets from the screen edges. */
window#waybar { background: transparent; color: @fg; margin: 0 ${margin}px; }
#custom-launcher, #window, #custom-media, #language, #idle_inhibitor,
#temperature, #disk, #memory, #cpu, #backlight, #pulseaudio, #network,
#tray, #battery, #clock, #custom-power {
    background: @bg2; color: @dim;
    margin: 4px ${gap}px; padding: 0 10px; border-radius: ${radius}px;
}
#workspaces { margin: 4px ${gap}px; padding: 0; }
#workspaces button { background: @bg2; color: @dim; padding: 0 9px; border-radius: ${radius}px; }
#workspaces button.active { background: @sel; color: @fg; }
#workspaces button.urgent { background: @sel; color: #ffffff; }
#custom-launcher { color: @accent; background: @sel; padding: 0 12px; }
#custom-power { color: @accent; }
#window { color: @fg; }
#custom-media { color: @lit; font-style: italic; padding: 0 14px; }
#language:hover, #idle_inhibitor:hover, #temperature:hover, #disk:hover,
#memory:hover, #cpu:hover, #backlight:hover, #pulseaudio:hover, #network:hover,
#battery:hover, #clock:hover, #custom-media:hover, #custom-power:hover,
#custom-launcher:hover { background: @sel; color: @lit; }
#temperature.critical, #battery.critical:not(.charging) { color: #ffffff; background: @sel; }
#idle_inhibitor.activated { color: @accent; }
#pulseaudio.muted, #network.disconnected { color: @accent; }
#battery.charging { color: @fg; }
#battery.warning:not(.charging) { color: @lit; }
#tray { padding: 0 8px; }
#tray menu { background: @bg2; color: @fg; }
tooltip { background: @bg2; border: 1px solid @line; color: @fg; }
tooltip label { color: @fg; }
EOF
  ;;
  segmented) cat <<EOF
/* Segmented: solid bar with rounded module clusters */
window#waybar { background: @bg; color: @fg; border-${edge}: 1px solid @accent; margin: 0 ${margin}px; }
.modules-left, .modules-center, .modules-right {
    background: @bg2; border-radius: ${radius}px; margin: 4px ${gap}px; padding: 0 4px;
}
#custom-launcher, #window, #custom-media, #language, #idle_inhibitor,
#temperature, #disk, #memory, #cpu, #backlight, #pulseaudio, #network,
#tray, #battery, #clock, #custom-power, #workspaces button {
    background: transparent; color: @dim; padding: 0 9px;
}
#custom-launcher { color: @accent; }
#custom-power { color: @accent; }
#window { color: @fg; padding: 0 12px; }
#custom-media { color: @lit; font-style: italic; }
#clock { color: @fg; }
/* internal separators, discreet */
#idle_inhibitor, #temperature, #disk, #memory, #cpu, #backlight,
#pulseaudio, #network, #battery { border-left: 1px solid @line; }
#language:hover, #idle_inhibitor:hover, #temperature:hover, #disk:hover,
#memory:hover, #cpu:hover, #backlight:hover, #pulseaudio:hover, #network:hover,
#battery:hover, #clock:hover, #custom-media:hover, #custom-power:hover { color: @lit; }
#workspaces button.active { color: @fg; border-bottom: 2px solid @accent; }
#workspaces button.urgent { color: #ffffff; background: @sel; }
#temperature.critical, #battery.critical:not(.charging) { color: #ffffff; background: @sel; }
#idle_inhibitor.activated { color: @accent; }
#pulseaudio.muted, #network.disconnected { color: @accent; }
#battery.charging { color: @fg; }
#battery.warning:not(.charging) { color: @lit; }
#tray menu { background: @bg2; color: @fg; }
tooltip { background: @bg2; border: 1px solid @line; color: @fg; }
tooltip label { color: @fg; }
EOF
  ;;
  esac
  } > "$WBAR/style.css"
}

# Rebuilds only the three module lists in config.jsonc. The module definitions
# stay in the original file, including clicks and tooltips, so the menu can
# show/hide items without destroying hand-made tweaks.
waybar_list(){
  local out="" key module
  while [ "$#" -ge 2 ]; do
    key="$1"; module="$2"; shift 2
    [ "$(sget "$key")" = "on" ] || continue
    [ -n "$out" ] && out="$out, "
    out="$out\"$module\""
  done
  printf '%s' "$out"
}

gen_waybar_layout(){
  local cfg="$WBAR/config.jsonc" tmp left center right h p
  [ -f "$cfg" ] || return 0
  left=$(waybar_list \
    bar_launcher custom/launcher bar_workspaces hyprland/workspaces \
    bar_window hyprland/window)
  center=$(waybar_list bar_media custom/media)
  right=$(waybar_list \
    bar_language hyprland/language bar_idle idle_inhibitor \
    bar_temperature temperature bar_disk disk bar_memory memory bar_cpu cpu \
    bar_backlight backlight bar_audio pulseaudio bar_network network \
    bar_tray tray bar_battery battery bar_clock clock bar_power custom/power)
  # Height and position live in .state too, so render/presets restore them.
  h=$(sget barh);   case "$h" in ''|*[!0-9]*|0) h="" ;; esac
  p=$(sget barpos); case "$p" in top|bottom|left|right) ;; *) p="" ;; esac

  # Only top-level keys (brace depth 1) are touched, so a "height" or a
  # "modules-*" inside a module/group definition is left alone. A module list
  # ends at "]" with an optional "," and/or // comment; the original comma (or
  # its absence) is preserved.
  tmp=$(mktemp "${TMPDIR:-/tmp}/hyprism-waybar.XXXXXX") || return 1
  HL="$left" HC="$center" HR="$right" HH="$h" HP="$p" awk '
    BEGIN { L = ENVIRON["HL"]; C = ENVIRON["HC"]; R = ENVIRON["HR"]
            H = ENVIRON["HH"]; P = ENVIRON["HP"]; depth = 0; skip = 0 }
    function braces(line,   t, o) {
      t = line; gsub(/"([^"\\]|\\.)*"/, "", t); sub(/\/\/.*/, "", t)
      o = gsub(/\{/, "", t); return o - gsub(/\}/, "", t)
    }
    function listend(line) { return line ~ /\][[:space:]]*,?[[:space:]]*(\/\/.*)?$/ }
    function emit(line) {
      printf "%s\"modules-%s\": [%s]%s\n", ind, name, val, (line ~ /\][[:space:]]*,/) ? "," : ""
    }
    skip { if (listend($0)) { emit($0); skip = 0 }; next }
    depth == 1 && /^[[:space:]]*"modules-(left|center|right)"[[:space:]]*:/ {
      ind = $0;  sub(/[^[:space:]].*/, "", ind)
      name = $0; sub(/^[[:space:]]*"modules-/, "", name); sub(/".*/, "", name)
      val = (name == "left") ? L : (name == "center") ? C : R
      if (listend($0)) emit($0); else skip = 1
      next
    }
    depth == 1 && H != "" && /^[[:space:]]*"height"[[:space:]]*:/ { sub(/:[[:space:]]*[0-9]+/, ": " H) }
    depth == 1 && P != "" && /^[[:space:]]*"position"[[:space:]]*:/ { sub(/:[[:space:]]*"[a-z]*"/, ": \"" P "\"") }
    { print; depth += braces($0) }
  ' "$cfg" > "$tmp" && [ -s "$tmp" ] || { rm -f "$tmp"; return 1; }
  # Write through (keeps a symlinked config.jsonc and its permissions).
  cmp -s "$tmp" "$cfg" || cat "$tmp" > "$cfg"
  rm -f "$tmp"
}

# A still image hyprlock can show for PATH: the file itself, or — for an
# animated wallpaper (gif/video) — a cached first frame. Prints nothing and
# fails when no usable image exists.
still_of(){
  local f="${1:-}" ext key
  [ -n "$f" ] && [ -f "$f" ] || return 1
  ext="${f##*.}"; ext="${ext,,}"
  case "$ext" in
    gif|mp4|webm|mkv|mov|avi)
      key="$THUMBS/lock_$(printf '%s' "$f" | md5sum | cut -c1-16).png"
      if [ ! -s "$key" ] || [ "$f" -nt "$key" ]; then
        if have ffmpeg; then
          ffmpeg -y -loglevel error -i "$f" -frames:v 1 "$key" </dev/null >/dev/null 2>&1
        elif have magick; then
          magick "${f}[0]" "$key" </dev/null >/dev/null 2>&1
        fi
      fi
      [ -s "$key" ] || return 1
      printf '%s' "$key" ;;
    *) printf '%s' "$f" ;;
  esac
}

gen_hyprlock(){
  local wall; wall=$(still_of "$(cat "$WALLFILE" 2>/dev/null)") || wall=""
  local a="${accent#\#}" b="${bg#\#}" f="${fg#\#}" d="${dim#\#}" s="${sel#\#}" l="${accent_lit#\#}"
  local bg2="${bg2#\#}" line="${line#\#}"
  local brightness datefmt lockfont
  brightness=$(awk "BEGIN{printf \"%.2f\", $(sget lock_brightness)/100}")
  # The lock screen follows the SYSTEM, which is English here — keep the date in
  # English (weekday/month come from the system locale) regardless of the
  # Hyprism menu language, matching the English "Password" prompt.
  datefmt='%A, %B %d'
  lockfont=$(sget barfont)

  # --- input field: position, width and corner style are all customizable.
  #     The avatar/username follow the field so the cluster stays coherent
  #     wherever you put it (and never collides with the clock/date above).
  local base fieldw fieldround av_y un_y
  case "$(sget lock_field_pos)" in
    high) base=-150 ;; low) base=-230 ;; bottom) base=-285 ;; *) base=-185 ;;
  esac
  av_y=$((base+135)); un_y=$((base+65))
  fieldw=$(sget lock_field_width)
  case "$(sget lock_field_style)" in
    square)  fieldround=6 ;;
    rounded) fieldround=14 ;;
    *)       fieldround=25 ;;
  esac

  # --- background: follow the wallpaper (default), a dedicated image, or a
  #     solid palette color. Image falls back to the wallpaper if it vanished.
  #     With no usable image at all, the solid color is used.
  local bg_block src=""
  case "$(sget lock_bg)" in
    color) src="" ;;
    image) src=$(still_of "$(sget lock_bg_image)") || src="$wall" ;;
    *)     src="$wall" ;;
  esac
  if [ -n "$src" ]; then
    bg_block=$(cat <<EOF
background {
    monitor =
    path = $src
    blur_passes = $(sget lock_blur)
    blur_size = 7
    brightness = $brightness
    contrast = 0.9
    vibrancy = 0.15
}
EOF
)
  else
    bg_block=$(cat <<EOF
background {
    monitor =
    color = rgba(${b}ff)
}
EOF
)
  fi

  # --- clock: size, color (text/accent/light accent) and 24h/12h format ---
  local clock_labels="" clockcol clockfmt
  case "$(sget lock_clock_color)" in
    accent)     clockcol="$a" ;;
    accent_lit) clockcol="$l" ;;
    *)          clockcol="$f" ;;
  esac
  [ "$(sget lock_clock_24h)" = "nao" ] && clockfmt='%I:%M %p' || clockfmt='%H:%M'
  if [ "$(sget lock_clock)" = "sim" ]; then
    clock_labels=$(cat <<EOF
# big clock, high on the screen
label {
    monitor =
    text = cmd[update:1000] echo "\$(date +'$clockfmt')"
    color = rgba(${clockcol}ff)
    font_size = $(sget lock_clock_size)
    font_family = ${lockfont} Bold
    position = 0, 150
    halign = center
    valign = center
    shadow_passes = 3
    shadow_size = 8
    shadow_color = rgba(000000cc)
}
# date, just under the clock, in the accent tone
label {
    monitor =
    text = cmd[update:60000] echo "\$(date +'$datefmt')"
    color = rgba(${l}ff)
    font_size = 17
    font_family = ${lockfont}
    position = 0, 52
    halign = center
    valign = center
}
EOF
)
  fi

  # --- thin accent frame around the screen edges (optional) ---
  local frame_block=""
  if [ "$(sget lock_frame)" = "sim" ]; then
    frame_block=$(cat <<EOF
# thin accent frame hugging the screen edges (uses the lit accent so it stays
# visible even when the base accent is near-black)
shape {
    monitor =
    size = 100%, 100%
    color = rgba(00000000)
    border_size = 2
    border_color = rgba(${l}66)
    rounding = 0
    position = 0, 0
    halign = center
    valign = center
}
EOF
)
  fi

  # --- avatar puck + glyph above the field (optional) ---
  local avatar_block=""
  if [ "$(sget lock_avatar)" = "sim" ]; then
    avatar_block=$(cat <<EOF
# avatar puck above the field — a clean circle with a visible accent-lit ring
shape {
    monitor =
    size = 96, 96
    color = rgba(${bg2}ee)
    border_size = 3
    border_color = rgba(${l}ff)
    rounding = -1
    position = 0, $av_y
    halign = center
    valign = center
    shadow_passes = 2
    shadow_size = 6
    shadow_color = rgba(00000099)
}
EOF
)
  fi

  # --- bottom line: ONLY shown when you set a message. Empty = nothing at all
  #     (no stray hint on the screen).
  local msg_block="" msg; msg=$(sget lock_message)
  if [ -n "$msg" ]; then
    msg_block=$(cat <<EOF
label {
    monitor =
    text = $msg
    color = rgba(${l}ff)
    font_size = 14
    font_family = ${lockfont}
    position = 0, 40
    halign = center
    valign = bottom
}
EOF
)
  fi

  cat > "$HD/hyprlock.conf" <<EOF
# Generated by Hyprism — palette $1. Do not edit by hand.
# Customize it from Hyprism: 'hyprism lock' (or the Lock screen menu).
# A clean, centered lock: background, an optional accent frame, a clock, an
# optional avatar, a pill input field and a bottom line.
general {
    hide_cursor = $(yesno "$(sget lock_hide_cursor)")
    ignore_empty_input = true
    immediate_render = true
}

$bg_block

# a soft dark veil so the foreground always reads, on any background
background {
    monitor =
    color = rgba(0a0a0a55)
}

$frame_block

$clock_labels

$avatar_block

# username under the avatar
label {
    monitor =
    text = \$USER
    color = rgba(${f}ff)
    font_size = 15
    font_family = ${lockfont} Bold
    position = 0, $un_y
    halign = center
    valign = center
}

# the input field — a refined pill: soft glassy inner, a visible accent-lit
# ring and a subtle drop shadow. Width/corners/position come from Hyprism.
input-field {
    monitor =
    size = $fieldw, 40
    outline_thickness = 2
    dots_size = 0.25
    dots_spacing = 0.32
    dots_center = true
    dots_rounding = -1
    outer_color = rgba(${l}ff)
    inner_color = rgba(${b}cc)
    font_color  = rgba(${f}ff)
    check_color = rgba(${l}ff)
    fail_color  = rgba(${s}ff)
    capslock_color = rgba(${l}ff)
    rounding = $fieldround
    shadow_passes = 2
    shadow_size = 5
    shadow_color = rgba(00000099)
    placeholder_text = Password
    fail_text = Wrong password
    position = 0, $base
    halign = center
    valign = center
}

$msg_block
EOF
}

gen_dunst(){
  mkdir -p "$HOME/.config/dunst"
  local icon_position icon_size
  if [ "$(sget notif_icons)" = "sim" ]; then
    icon_position=left; icon_size=48
  else
    icon_position=off; icon_size=0
  fi
  cat > "$HOME/.config/dunst/dunstrc" <<EOF
# Generated by Hyprism — palette $1. Do not edit by hand.
[global]
    monitor = 0
    follow = mouse
    width = $(sget notif_width)
    height = (0, 200)
    origin = $(sget notif_position)
    offset = (12, 38)
    frame_width = $(sget border)
    frame_color = "$accent"
    separator_color = frame
    corner_radius = $(sget rounding)
    font = $(sget barfont) 10
    format = "<b>%s</b>\\n%b"
    icon_theme = Mono-Base
    enable_recursive_icon_lookup = true
    icon_position = $icon_position
    max_icon_size = $icon_size
[urgency_low]
    background = "$bg"
    foreground = "$dim"
    timeout = $(sget notif_timeout)s
[urgency_normal]
    background = "$bg"
    foreground = "$fg"
    timeout = $(sget notif_timeout)s
[urgency_critical]
    background = "$sel"
    foreground = "#ffffff"
    frame_color = "$accent_lit"
    timeout = 0
EOF
}

restart_bar(){
  have waybar || return 0
  pkill -x waybar >/dev/null 2>&1
  [ "$(sget bar_enabled)" = "on" ] || return 0
  sleep 0.4
  setsid waybar >/dev/null 2>&1 < /dev/null & }
# Only (re)start dunst when it is the notification daemon in use: never fight
# mako or swaync for the notification bus.
restart_dunst(){
  have dunst || return 0
  pgrep -x mako >/dev/null 2>&1 && return 0
  pgrep -x swaync >/dev/null 2>&1 && return 0
  pkill -x dunst >/dev/null 2>&1; sleep 0.2
  setsid dunst >/dev/null 2>&1 < /dev/null & }

# Applies a wallpaper without persisting state. Used by the FZF live preview.
# Delegates to set-wallpaper, which picks swaybg or mpvpaper depending on
# whether the file is still or animated.
apply_wall_now(){
  local wall="$1" sw
  [ -f "$wall" ] || return 1
  sw=$(command -v set-wallpaper 2>/dev/null) || sw="$HYPRISM_ROOT/bin/set-wallpaper"
  [ -x "$sw" ] || return 1
  "$sw" "$wall" >/dev/null 2>&1
}

# The FZF preview must respond instantly. Previously each move waited for
# swaybg to stop/start and the picker felt frozen. Now focus only records the
# latest request; a single worker applies just the most recent selection after
# a short debounce.
queue_wall_preview(){
  local wall="$1" tmp="$WALLCACHE/request.$$"
  [ -f "$wall" ] || return 0
  if [ -f "$WALLCACHE/worker.lock/pid" ]; then
    local pid
    pid=$(cat "$WALLCACHE/worker.lock/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      rmdir "$WALLCACHE/worker.lock" 2>/dev/null || true
    fi
  fi
  printf '%s\n' "$wall" > "$tmp"
  mv -f "$tmp" "$WALLCACHE/request"
  if mkdir "$WALLCACHE/worker.lock" 2>/dev/null; then
    setsid -f "$SELF" __wworker >/dev/null 2>&1 < /dev/null
  fi
}

wall_preview_worker(){
  trap 'rm -f "$WALLCACHE/worker.lock/pid"; rmdir "$WALLCACHE/worker.lock" 2>/dev/null || true' EXIT INT TERM
  local requested latest
  printf '%s\n' "$$" > "$WALLCACHE/worker.lock/pid"
  while [ -f "$WALLCACHE/request" ]; do
    requested=$(cat "$WALLCACHE/request" 2>/dev/null) || break
    sleep 0.14
    latest=$(cat "$WALLCACHE/request" 2>/dev/null || true)
    [ "$requested" = "$latest" ] || continue
    rm -f "$WALLCACHE/request"
    apply_wall_now "$requested"
  done
}

stop_wall_preview(){
  rm -f "$WALLCACHE/request"
  local n=0
  while [ -d "$WALLCACHE/worker.lock" ] && [ "$n" -lt 30 ]; do
    sleep 0.05
    n=$((n+1))
  done
}

# Applies the hand-picked accent and brightness tweak ON TOP of the freshly
# loaded palette. Since every generator reads $accent / $accent_lit, touching
# it here propagates on its own to Hyprland, Waybar, Hyprlock and Dunst.
apply_accent(){
  local ov br
  ov=$(sget accent_override)
  [ -n "$ov" ] && accent="$ov"

  br=$(sget accent_bright); [ -z "$br" ] && br=100
  if [ "$br" -gt 100 ] 2>/dev/null; then
    accent=$(mix "#ffffff" "$accent" $(( br - 100 )))
  elif [ "$br" -lt 100 ] 2>/dev/null; then
    accent=$(mix "#000000" "$accent" $(( 100 - br )))
  fi

  # the light tone follows the accent
  if is_dark "$bg"; then accent_lit=$(mix "$accent" "#ffffff" 70)
  else                   accent_lit=$(mix "$accent" "#000000" 72); fi

  # expose it so rofitheme can use the same accent
  printf '%s\n' "$accent" > "$HD/accent"
}

# Ask rofi to adopt the same accent. rofitheme owns its own files; here we just
# ask it to re-render its active palette (which re-reads the shared accent).
sync_rofi(){
  have rofitheme || return 0
  local ra; ra=$(cat "$HOME/.config/rofi/themes/.active" 2>/dev/null)
  [ -n "$ra" ] && rofitheme "$ra" >/dev/null 2>&1
  return 0
}

render(){
  seed
  local name
  name=$(active_pal) || { err "$(t 'no palette')"; return 1; }
  loadpal "$name"
  apply_accent
  gen_look
  gen_colors   "$name"
  gen_waybar   "$name"
  gen_waybar_layout
  gen_hyprlock "$name"
  gen_dunst    "$name"
  if have hyprctl; then
    hyprctl reload >/dev/null 2>&1
    hyprctl setcursor "$(sget cursor_theme)" "$(sget cursor_size)" >/dev/null 2>&1
  fi
  sync_rofi
  restart_bar; restart_dunst
  return 0
}

apply(){
  [ -f "$PAL/$1.env" ] || { err "$(t 'palette') '$1' $(t 'does not exist — try hyprism -l')"; return 1; }
  # Switching palettes must actually show the chosen palette. A manual accent
  # (e.g. #2a2a2a) used to survive and make BlackArch, Rofi and other palettes
  # look like the previous theme. Border tweaks can be reapplied afterwards,
  # explicitly, from the Borders menu.
  sset accent_override ""
  sset accent_bright 100
  sset border_inactive ""
  printf '%s\n' "$1" > "$STATE"
  render
  ok "$(t 'palette'): $1  (Hyprland + Waybar + Hyprlock + Dunst)"
}

# ---------- preview ----------
preview(){
  local p="$PAL/$1.env"; [ -f "$p" ] || { t 'no palette'; echo; return; }
  ( loadpal "$1"
    local src; src=$(grep -m1 -E '^# (origem|source):' "$p" | sed -E 's/^# (origem|source): //')
    printf '%-8s %s\n' "$(t 'palette')" "$1"
    [ -n "$src" ] && printf '%-8s %s\n' "$(t 'source')" "$src"
    printf '\n'
    local W=42 B; B=$(abg "$bg")
    printf '%s%s ┌─ %s %*s%s\n' "$B" "$(afg "$accent")" "$(t 'active window')" $((W-16)) '' "$Z"
    printf '%s%s │ %s%-*s%s\n' "$B" "$(afg "$accent")" "$(afg "$fg")"  $((W-4)) "$(t 'normal text')" "$Z"
    printf '%s%s │ %s%-*s%s\n' "$B" "$(afg "$accent")" "$(afg "$dim")" $((W-4)) "$(t 'dim text')" "$Z"
    printf '%s%s%-*s%s\n' "$(abg "$sel")" "$(afg "${on_accent:-#ffffff}")" "$W" " $(t 'selected item')" "$Z"
    printf '%s%s%-*s%s\n' "$(abg "$bg2")" "$(afg "$accent_lit")" "$W" " $(t 'bar / highlight')" "$Z"
    printf '\n'
    printf '%s    %s bg        %s\n' "$(abg "$bg")" "$Z" "$bg"
    printf '%s    %s fg        %s\n' "$(abg "$fg")" "$Z" "$fg"
    printf '%s    %s %-9s %s\n' "$(abg "$accent")" "$Z" "$(t 'accent')" "$accent"
    printf '%s    %s %-9s %s\n' "$(abg "$accent_lit")" "$Z" "$(t 'highlight')" "$accent_lit"
    printf '%s    %s %-9s %s\n' "$(abg "$sel")" "$Z" "$(t 'selection')" "$sel" )
}

preview_wall(){
  local name="$1" f="$WALLDIR/$1" ext img thumbkey
  ext="${name##*.}"; ext="${ext,,}"
  thumbkey="$THUMBS/$(printf '%s' "$name" | tr -c '[:alnum:]._-' '_')"

  printf '%-10s %s\n' "$(t 'file')" "$name"

  case "$ext" in
    gif|mp4|webm|mkv|mov|avi)
      printf '%-10s %s (%s)\n' "$(t 'type')" "$(t 'animated')" "$ext"
      have mpvpaper || printf '%-10s %s\n' "$(t 'note')" "$(t 'mpvpaper missing: it will stay a still frame')"
      img="$thumbkey.frame.png"
      if [ ! -f "$img" ] || [ "$f" -nt "$img" ]; then
        if have ffmpeg; then ffmpeg -y -loglevel error -i "$f" -vframes 1 -vf 'scale=900:-1' "$img" >/dev/null 2>&1
        elif have magick; then magick "${f}[0]" -resize 900x "$img" >/dev/null 2>&1; fi
      fi
      ;;
    *)
      # Cache a downscaled thumbnail so kitten icat transfers little data. Big
      # JPGs (several MB) were re-encoded on every arrow key; this makes the
      # preview feel instant. Falls back to the original if magick is missing.
      img="$thumbkey.thumb.png"
      if have magick; then
        if [ ! -f "$img" ] || [ "$f" -nt "$img" ]; then
          magick "$f" -auto-orient -resize '1200x1200>' "$img" >/dev/null 2>&1 || img="$f"
        fi
      else img="$f"; fi
      [ -f "$img" ] || img="$f"
      ;;
  esac

  if have magick && [ -f "$f" ]; then
    printf '%-10s %s\n' "$(t 'resolution')" "$(magick identify -format '%wx%h' "$f" 2>/dev/null)"
  fi
  printf '%-10s %s\n' "$(t 'size')" "$(du -h "$f" 2>/dev/null | cut -f1)"
  printf '\n'

  [ -f "${img:-}" ] || { printf '(%s)\n' "$(t 'could not build the thumbnail')"; return 0; }

  # The image sits inside the fzf panel. icat draws over the whole terminal, so
  # --place uses the panel geometry that fzf exports in FZF_PREVIEW_*; the 4
  # subtracted lines are the text header above.
  local cols=${FZF_PREVIEW_COLUMNS:-44}
  local rows=${FZF_PREVIEW_LINES:-24}
  local left=${FZF_PREVIEW_LEFT:-0}
  local top=${FZF_PREVIEW_TOP:-0}
  local ih=$(( rows - 5 )); [ "$ih" -lt 4 ] && ih=4

  if have kitten && [ -n "${KITTY_WINDOW_ID:-}" ]; then
    kitten icat --clear --transfer-mode=memory --stdin=no --scale-up \
      --place="${cols}x${ih}@${left}x$(( top + 4 ))" "$img" 2>/dev/null
  elif have chafa; then
    chafa --size="${cols}x${ih}" "$img" 2>/dev/null
  else
    printf '(%s)\n' "$(t 'no image viewer: inside kitty the image shows on its own; otherwise install chafa')"
  fi
}

clear_wall_preview(){
  # Kitty's graphics protocol draws over the terminal grid. The preview process
  # exits with fzf, but the image stays until it receives an explicit clear.
  if have kitten && [ -n "${KITTY_WINDOW_ID:-}" ]; then
    kitten icat --clear 2>/dev/null || true
  fi
}

# ---------- menus ----------
pick_palette(){
  [ -z "$(palettes)" ] && gen_palettes >/dev/null
  local sel; sel=$(palettes | FZF --prompt="$(t 'palette') > " \
      --preview "$SELF __prev {1}" --preview-window='right,54%,border-left' \
      --header="$(t 'ENTER applies to Hyprland, Waybar, Hyprlock and Dunst')")
  [ -n "${sel:-}" ] && apply "$sel"
}

# The list of wallpapers, one filename per line (spaces preserved).
wall_find(){
  cd "$WALLDIR" 2>/dev/null || return 0
  find . -maxdepth 1 -type f \
    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \
       -o -iname '*.gif' -o -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.avi' \) \
    -printf '%f\n' | sort
}

pick_wallpaper(){
  mkdir -p "$WALLDIR" 2>/dev/null
  [ -d "$WALLDIR" ] || { err "$(t 'folder not found'): $WALLDIR"; return 1; }
  local old sel clip qdir qself; old=$(cat "$WALLFILE" 2>/dev/null)
  clip=''; have wl-copy && clip='wl-copy'
  [ -z "$clip" ] && have xclip && clip='xclip -selection clipboard'
  # fzf runs these with bash (see FZF) and replaces {} with a quoted string.
  qdir=$(printf '%q' "$WALLDIR"); qself=$(printf '%q' "$SELF")

  local -a binds=(
    --bind "focus:execute-silent($qself __wlive {})"
    --bind "ctrl-s:reload($qself __wfind | shuf)"
    --bind "alt-o:execute-silent(xdg-open $qdir >/dev/null 2>&1)"
  )
  [ -n "$clip" ] && binds+=( --bind "ctrl-y:execute-silent(printf '%s/%s' $qdir {} | $clip)" )

  sel=$(wall_find \
      | FZF --prompt="$(t 'wallpaper') > " --preview "$qself __wprev {}" \
        --preview-window='right,52%,border-left' "${binds[@]}" \
        --header="$(t 'arrows preview live · ENTER apply · ESC restore · Ctrl-S shuffle · Alt-O folder')")
  clear_wall_preview
  if [ -z "${sel:-}" ]; then
    stop_wall_preview
    [ -n "${old:-}" ] && apply_wall_now "$old"
    return 0
  fi
  stop_wall_preview
  printf '%s\n' "$WALLDIR/$sel" > "$WALLFILE"
  apply_wall_now "$WALLDIR/$sel"
  render
  ok "$(t 'wallpaper'): $sel ($(t 'also on the lock screen'))"
}

# ---------- SDDM login theme (the system greeter / "tela de inicio") ----------
# Pick an installed SDDM theme the SAME way you pick a wallpaper: a list with a
# live thumbnail on the side. Applying writes the choice under /etc/sddm.conf.d
# via pkexec (a graphical password prompt) — nothing here touches /etc without
# your OK. The file is named to sort AFTER the KDE one, so our choice wins.
SDDM_THEMES_DIR="/usr/share/sddm/themes"

# Current= of the [Theme] section in one file (empty when not set there).
sddm_theme_of(){
  awk '/^[[:space:]]*\[/ { sec = $0; gsub(/[][[:space:]\r]/, "", sec) }
       sec == "Theme" && /^[[:space:]]*Current[[:space:]]*=/ {
         v = $0; sub(/^[^=]*=[[:space:]]*/, "", v); gsub(/[[:space:]\r]+$/, "", v); cur = v }
       END { if (cur != "") print cur }' "$1" 2>/dev/null
}
sddm_current(){
  # SDDM reads the drop-in dirs in name order (later wins) and /etc/sddm.conf
  # LAST, so sddm.conf has the highest precedence: the last value is effective.
  local f v cur=""
  for f in /usr/lib/sddm/sddm.conf.d/*.conf /etc/sddm.conf.d/*.conf /etc/sddm.conf; do
    [ -f "$f" ] || continue
    v=$(sddm_theme_of "$f"); [ -n "$v" ] && cur="$v"
  done
  printf '%s' "$cur"
}

sddm_shot(){
  # Best-effort screenshot/preview image for a theme dir.
  # 1) the Screenshot= declared in metadata.desktop, 2) a file named like a
  # preview, 3) as a last resort the biggest image in the theme (almost always
  # the background/screenshot — this is what saves themes like astronaut whose
  # background is just "blackarch.png").
  local dir="$1" shot
  shot=$(grep -m1 '^Screenshot=' "$dir/metadata.desktop" 2>/dev/null | cut -d= -f2- | tr -d '\r')
  if [ -n "$shot" ] && [ -f "$dir/$shot" ]; then printf '%s' "$dir/$shot"; return; fi
  shot=$(find "$dir" -maxdepth 3 -type f \
    -iregex '.*\(preview\|screenshot\|screen\|thumbnail\|background\).*\.\(png\|jpg\|jpeg\|webp\)' \
    2>/dev/null | head -1)
  [ -n "$shot" ] && { printf '%s' "$shot"; return; }
  find "$dir" -maxdepth 3 -type f -iregex '.*\.\(png\|jpg\|jpeg\|webp\)' -printf '%s\t%p\n' \
    2>/dev/null | sort -rn | head -1 | cut -f2-
}

preview_sddm(){
  local name="$1" dir="$SDDM_THEMES_DIR/$1" cur shot img thumbkey desc
  cur=$(sddm_current)
  printf '%-10s %s\n' "$(t 'theme')" "$name"
  [ "$name" = "$cur" ] && printf '%-10s • %s\n' '' "$(t 'active now')"
  desc=$(grep -m1 '^Description=' "$dir/metadata.desktop" 2>/dev/null | cut -d= -f2- | tr -d '\r')
  [ -n "$desc" ] && printf '%-10s %s\n' "$(t 'about')" "$desc"
  printf '\n'

  shot=$(sddm_shot "$dir")
  if [ -z "$shot" ] || [ ! -f "$shot" ]; then printf '(%s)\n' "$(t 'no preview image')"; return 0; fi

  thumbkey="$THUMBS/sddm_$(printf '%s' "$name" | tr -c '[:alnum:]._-' '_').png"
  img="$shot"
  if have magick; then
    mkdir -p "$THUMBS"
    if [ ! -f "$thumbkey" ] || [ "$shot" -nt "$thumbkey" ]; then
      magick "$shot" -auto-orient -resize '1200x1200>' "$thumbkey" >/dev/null 2>&1 && img="$thumbkey"
    else img="$thumbkey"; fi
  fi

  local cols=${FZF_PREVIEW_COLUMNS:-44} rows=${FZF_PREVIEW_LINES:-24}
  local left=${FZF_PREVIEW_LEFT:-0} top=${FZF_PREVIEW_TOP:-0}
  local ih=$(( rows - 5 )); [ "$ih" -lt 4 ] && ih=4
  if have kitten && [ -n "${KITTY_WINDOW_ID:-}" ]; then
    kitten icat --clear --transfer-mode=memory --stdin=no --scale-up \
      --place="${cols}x${ih}@${left}x$(( top + 4 ))" "$img" 2>/dev/null
  elif have chafa; then
    chafa --size="${cols}x${ih}" "$img" 2>/dev/null
  else
    printf '(%s)\n' "$(t 'inside kitty the image shows on its own; otherwise install chafa')"
  fi
}

apply_sddm(){
  local theme="$1" conf="/etc/sddm.conf.d/zz-hyprism.conf" tmp inst
  inst=$(command -v install)
  have pkexec && [ -n "$inst" ] || { err "$(t 'pkexec not found — cannot change the login theme')"; return 1; }
  tmp=$(mktemp) || return 1
  printf '# Generated by Hyprism.\n[Theme]\nCurrent=%s\n' "$theme" > "$tmp"
  if pkexec "$inst" -Dm644 "$tmp" "$conf" 2>/dev/null; then
    ok "$(t 'login theme'): $theme  ($(t 'takes effect at the next login'))"
  else
    err "$(t 'could not apply the login theme (password cancelled or failed)')"
  fi
  rm -f "$tmp"
}

pick_sddm(){
  [ -d "$SDDM_THEMES_DIR" ] || { err "$(t 'no SDDM themes installed')"; return 1; }
  local sel cur; cur=$(sddm_current)
  # /etc/sddm.conf is read last: a Current= there overrides zz-hyprism.conf.
  if [ -n "$(sddm_theme_of /etc/sddm.conf)" ]; then
    warn "$(t '/etc/sddm.conf sets Current= itself and overrides the theme chosen here; remove that line (as root) for the choice to take effect')"
  fi
  sel=$(ls -1 "$SDDM_THEMES_DIR" 2>/dev/null \
      | FZF --prompt="$(t 'login screen (SDDM)') > " \
        --preview "$SELF __sddmprev {}" \
        --preview-window='right,58%,border-left' \
        --header="$(t 'arrows preview · ENTER apply (asks password) · ESC cancel')  ·  $(t 'now'): ${cur:-?}")
  [ -z "${sel:-}" ] && return 0
  apply_sddm "$sel"
}

# ---------- border color ----------
# Applies just the border, live, without persisting. Used by the FZF preview.
# The inactive border in effect: the Borders-menu choice, else the palette line.
border_inactive_eff(){ local i; i=$(sget border_inactive); [ -n "$i" ] || i=$(pal_get line); printf '%s' "$i"; }
# A Borders-menu key -> hex. 'follow' = the palette's own accent, unadjusted.
border_hex(){ if [ "$1" = follow ]; then bright_of 100 "$(pal_get accent)"; else printf '%s' "$1"; fi; }

border_live(){
  have hyprctl || return 0
  local a="${1#\#}" i="${2#\#}"
  [ -n "$i" ] || i=$(border_inactive_eff); i="${i#\#}"
  hyprctl eval "hl.config({ general = { col = { active_border = \"rgba(${a}ff)\", inactive_border = \"rgba(${i}ff)\" } } })" >/dev/null 2>&1
}

# Offered colors: the palette's own first, then a handful of common tones.
# Format: "hex  name" (the hex stays as the canonical first token).
border_options(){
  local name; name=$(active_pal) && ( loadpal "$name"
    printf '%s  %s\n' "$accent"     "$(t 'palette accent')"
    printf '%s  %s\n' "$accent_lit" "$(t 'light accent')"
    printf '%s  %s\n' "$line"       "$(t 'palette line')"
    printf '%s  %s\n' "$sel"        "$(t 'selection')"
    printf '%s  %s\n' "$fg"         "$(t 'text')" )
  cat <<EOF
#ff2b2b  $(t 'bright red')
#8b0000  $(t 'dark red')
#cc2200  $(t 'brick red')
#ff6a6a  $(t 'light red')
#ffffff  $(t 'white')
#888888  $(t 'medium gray')
#2a2a2a  $(t 'dark gray')
#000000  $(t 'black')
#00ff9c  $(t 'phosphor green')
#39d353  $(t 'green')
#ffcf40  $(t 'amber')
#ff8800  $(t 'orange')
#00b4d8  $(t 'cyan')
#7c5cff  $(t 'purple')
EOF
}

preview_border(){
  local hex; hex=$(border_hex "$1")
  local name; name=$(active_pal) && loadpal "$name"
  local inactive; inactive=$(sget border_inactive)
  [ -n "$inactive" ] || inactive="${line:-#2a2a2a}"

  printf '%-14s %s\n' "$(t 'active border')" "$hex"
  printf '%-14s %s\n\n' "$(t 'inactive border')" "$inactive"

  # draw two little windows, active and inactive
  local W=34 lblA lblI
  lblA=$(t 'active window'); lblI=$(t 'inactive window')
  printf '%s%s' "$(afg "$hex")" ""
  printf '  ┌%s┐\n' "$(printf '─%.0s' $(seq 1 $W))"
  printf '  │%s│\n' "$(printf ' %.0s' $(seq 1 $W))"
  printf '  │%*s%*s│\n' $(( (W+${#lblA})/2 )) "$lblA" $(( W - (W+${#lblA})/2 )) ""
  printf '  │%s│\n' "$(printf ' %.0s' $(seq 1 $W))"
  printf '  └%s┘%s\n\n' "$(printf '─%.0s' $(seq 1 $W))" "$Z"

  printf '%s' "$(afg "$inactive")"
  printf '  ┌%s┐\n' "$(printf '─%.0s' $(seq 1 $W))"
  printf '  │%*s%*s│\n' $(( (W+${#lblI})/2 )) "$lblI" $(( W - (W+${#lblI})/2 )) ""
  printf '  └%s┘%s\n' "$(printf '─%.0s' $(seq 1 $W))" "$Z"

  printf '\n%s        %s  %s\n' "$(abg "$hex")" "$Z" "$hex"
}

pick_bordas(){
  local sel
  sel=$( { printf 'follow  %s\n' "$(t 'the palette color (default)')"; border_options; } \
      | FZF --prompt="$(t 'accent color') > " \
        --preview "$SELF __bprev {1}" --preview-window='right,50%,border-left' \
        --bind "focus:execute-silent($SELF __blive {1})" \
        --header="$(t 'arrows show on screen · ENTER apply · ESC restore')")

  if [ -z "${sel:-}" ]; then render >/dev/null 2>&1; return 0; fi

  local hex="${sel%% *}"
  if [ "$hex" = "follow" ]; then
    sset accent_override ""
  else
    sset accent_override "$hex"
  fi

  # Brightness: lighten or darken the chosen accent, live.
  local b
  b=$(printf '%s\n' \
        "160  $(t 'much lighter')" \
        "140  $(t 'lighter')" \
        "120  $(t 'a bit lighter')" \
        "100  $(t 'original color')" \
        " 85  $(t 'a bit darker')" \
        " 70  $(t 'darker')" \
        " 55  $(t 'much darker')" \
      | FZF --prompt="$(t 'brightness') > " \
        --preview "$SELF __brprev {1}" --preview-window='right,50%,border-left' \
        --bind "focus:execute-silent($SELF __brlive {1})" \
        --header="$(t 'arrows show on screen · ENTER apply')")
  [ -n "${b:-}" ] && sset accent_bright "$(printf '%s' "${b%% *}" | tr -d ' ')"

  render
  ok "$(t 'accent'): $(cat "$HD/accent" 2>/dev/null)  $(t 'brightness') $(sget accent_bright)%  (Hyprland · bar · rofi · lock · notifications)"
}

# Computes the effective accent for a given brightness percentage, no writes.
bright_of(){
  local base="${2:-}" br="$1"
  [ -n "$base" ] || base=$(sget accent_override)
  [ -n "$base" ] || base=$(pal_get accent)
  [ -n "$base" ] || base="#888888"
  if [ "$br" -gt 100 ] 2>/dev/null; then mix "#ffffff" "$base" $(( br - 100 ))
  elif [ "$br" -lt 100 ] 2>/dev/null; then mix "#000000" "$base" $(( 100 - br ))
  else printf '%s' "$base"; fi
}

preview_bright(){
  local br="${1// /}" hex
  hex=$(bright_of "$br")
  printf '%-11s %s%%\n' "$(t 'brightness')" "$br"
  printf '%-11s %s\n\n' "$(t 'color')" "$hex"
  preview_border "$hex" | tail -n +3
}

bright_live(){
  border_live "$(bright_of "${1// /}")" "$(border_inactive_eff)"
}

pick_aparencia(){
  local c v pair gi go changed
  while true; do
    c=$( {
      row border  "$(t 'border') · $(sget border)px"
      row corners "$(t 'corners') · $(sget rounding)px, $(t 'power') $(sget rounding_power)"
      row spacing "$(t 'spacing') · $(t 'inner') $(sget gaps_in)px / $(t 'outer') $(sget gaps_out)px"
      row back    "$(t 'back')"
      } | FZFM --prompt="$(t 'appearance') > " \
          --header="$(t 'border, corner shape and breathing room between windows')" )
    changed=0
    case "$(mkey "$c")" in
      border)
        v=$(printf '%s\n' "0  $(t 'no border')" "1  $(t 'thin (recommended)')" "2  $(t 'medium')" "3  $(t 'marked')" "5  $(t 'thick')" \
          | FZF --prompt="$(t 'border') > " --header="$(t 'window border width')")
        [ -n "${v:-}" ] && { sset border "${v%% *}"; changed=1; }
        ;;
      corners)
        v=$(printf '%s\n' "0  $(t 'square')" "4  $(t 'almost square')" "8  $(t 'discreet')" "12 $(t 'rounded')" "16 $(t 'very round')" "24 $(t 'capsule')" \
          | FZF --prompt="$(t 'corner radius') > ")
        [ -n "${v:-}" ] && { sset rounding "${v%% *}"; changed=1; }
        v=$(printf '%s\n' "1.0  $(t 'beveled')" "2.0  $(t 'circular (default)')" "3.0  $(t 'soft')" "4.0  $(t 'squircle')" \
          | FZF --prompt="$(t 'corner shape') > " --header="$(t 'higher power makes the arc more square')")
        [ -n "${v:-}" ] && { sset rounding_power "${v%% *}"; changed=1; }
        ;;
      spacing)
        v=$(printf '%s\n' "0/0   $(t 'no gaps')" "2/4   $(t 'compact (default)')" "4/8   $(t 'balanced')" "6/12  $(t 'airy')" "10/20 $(t 'spacious')" "14/28 $(t 'very spacious')" \
          | FZF --prompt="$(t 'gaps inner/outer') > ")
        if [ -n "${v:-}" ]; then
          pair="${v%% *}"; gi="${pair%%/*}"; go="${pair#*/}"
          sset gaps_in "$gi"; sset gaps_out "$go"; changed=1
        fi
        ;;
      back|"") break ;;
    esac
    [ "$changed" -eq 1 ] && render >/dev/null 2>&1
  done
  ok "$(t 'border') $(sget border) · $(t 'corners') $(sget rounding) ($(t 'power') $(sget rounding_power)) · $(t 'gaps') $(sget gaps_in)/$(sget gaps_out)"
}

effects_preset(){
  case "$1" in
    performance|desempenho)
      sset blur off; sset blur_xray nao
      sset shadow off
      sset active_op 100; sset inactive_op 100; sset fullscreen_op 100
      sset dim_inactive nao
      ;;
    subtle|discreto)
      sset blur off; sset blur_xray nao
      sset shadow on; sset shadow_range 8; sset shadow_power 3
      sset shadow_scale 0.98; sset shadow_offset_x 0; sset shadow_offset_y 2
      sset active_op 100; sset inactive_op 96; sset fullscreen_op 100
      sset dim_inactive nao
      ;;
    glass|vidro)
      sset blur on; sset blur_size 6; sset blur_passes 2; sset blur_xray nao
      sset blur_brightness 1.0; sset blur_vibrancy 0.17
      sset shadow on; sset shadow_range 14; sset shadow_power 3
      sset shadow_scale 0.98; sset shadow_offset_x 0; sset shadow_offset_y 2
      sset active_op 98; sset inactive_op 92; sset fullscreen_op 100
      sset dim_inactive nao
      ;;
    focus|foco)
      sset blur on; sset blur_size 5; sset blur_passes 2; sset blur_xray nao
      sset blur_brightness 0.95; sset blur_vibrancy 0.10
      sset shadow on; sset shadow_range 12; sset shadow_power 3
      sset shadow_scale 0.98; sset shadow_offset_x 0; sset shadow_offset_y 2
      sset active_op 100; sset inactive_op 92; sset fullscreen_op 100
      sset dim_inactive sim; sset dim_strength 8
      ;;
    *) return 1 ;;
  esac
}

pick_blur_advanced(){
  local c v pair changed
  while true; do
    c=$( {
      row state     "$(t 'state') · $(sget blur)"
      row intensity "$(t 'intensity') · $(t 'size') $(sget blur_size), $(t 'passes') $(sget blur_passes)"
      row xray      "xray · $(sget blur_xray)"
      row brightness "$(t 'brightness') · $(sget blur_brightness)"
      row vibrancy  "$(t 'vibrancy') · $(sget blur_vibrancy)"
      row back      "$(t 'back')"
      } | FZFM --prompt="$(t 'advanced blur') > " \
          --header="$(t 'values kept within GPU-safe ranges')" )
    changed=0
    case "$(mkey "$c")" in
      state)
        v=$( { row off "$(t 'no blur')"; row on "$(t 'blur behind windows')"; } | FZFM --prompt="$(t 'blur') > ")
        [ -n "${v:-}" ] && { sset blur "$(mkey "$v")"; changed=1; }
        ;;
      intensity)
        v=$(printf '%s\n' "3/1   $(t 'light and cheap')" "5/2   $(t 'balanced')" "6/2   $(t 'soft glass')" "8/3   $(t 'strong')" "10/3  $(t 'very strong')" \
          | FZF --prompt="$(t 'size/passes') > ")
        if [ -n "${v:-}" ]; then
          pair="${v%% *}"; sset blur_size "${pair%%/*}"; sset blur_passes "${pair#*/}"; changed=1
        fi
        ;;
      xray)
        v=$( { row nao "$(t 'limit blur to normal surfaces (default)')"; row sim "$(t 'pass through transparent surfaces')"; } \
          | FZFM --prompt="blur xray > ")
        [ -n "${v:-}" ] && { sset blur_xray "$(mkey "$v")"; changed=1; }
        ;;
      brightness)
        v=$(printf '%s\n' "0.80 $(t 'dark')" "0.90 $(t 'slightly dark')" "1.00 $(t 'neutral')" "1.10 $(t 'light')" "1.20 $(t 'very light')" \
          | FZF --prompt="$(t 'blur brightness') > ")
        [ -n "${v:-}" ] && { sset blur_brightness "${v%% *}"; changed=1; }
        ;;
      vibrancy)
        v=$(printf '%s\n' "0.00 $(t 'neutral')" "0.10 $(t 'discreet')" "0.17 $(t 'default')" "0.25 $(t 'vivid')" "0.35 $(t 'intense')" \
          | FZF --prompt="$(t 'blur vibrancy') > ")
        [ -n "${v:-}" ] && { sset blur_vibrancy "${v%% *}"; changed=1; }
        ;;
      back|"") break ;;
    esac
    [ "$changed" -eq 1 ] && render >/dev/null 2>&1
  done
}

pick_shadow_advanced(){
  local c v pair x y changed
  while true; do
    c=$( {
      row state     "$(t 'state') · $(sget shadow)"
      row intensity "$(t 'intensity') · $(t 'range') $(sget shadow_range), $(t 'power') $(sget shadow_power)"
      row scale     "$(t 'scale') · $(sget shadow_scale)"
      row offset    "$(t 'offset') · $(sget shadow_offset_x),$(sget shadow_offset_y)"
      row back      "$(t 'back')"
      } | FZFM --prompt="$(t 'advanced shadow') > " )
    changed=0
    case "$(mkey "$c")" in
      state)
        v=$( { row off "$(t 'no shadow')"; row on "$(t 'shadow under windows')"; } | FZFM --prompt="$(t 'shadow') > ")
        [ -n "${v:-}" ] && { sset shadow "$(mkey "$v")"; changed=1; }
        ;;
      intensity)
        v=$(printf '%s\n' "6/2   $(t 'light')" "10/3  $(t 'discreet')" "14/3  $(t 'balanced')" "20/4  $(t 'strong')" "28/4  $(t 'wide')" \
          | FZF --prompt="$(t 'range/power') > ")
        if [ -n "${v:-}" ]; then
          pair="${v%% *}"; sset shadow_range "${pair%%/*}"; sset shadow_power "${pair#*/}"; changed=1
        fi
        ;;
      scale)
        v=$(printf '%s\n' "0.90 $(t 'compact')" "0.95 $(t 'smaller')" "0.98 $(t 'discreet')" "1.00 $(t 'window size')" \
          | FZF --prompt="$(t 'shadow scale') > ")
        [ -n "${v:-}" ] && { sset shadow_scale "${v%% *}"; changed=1; }
        ;;
      offset)
        v=$(printf '%s\n' "0,0  $(t 'centered')" "0,2  $(t 'below, discreet')" "0,4  $(t 'below')" "2,4  $(t 'right and below')" "-2,4 $(t 'left and below')" \
          | FZF --prompt="$(t 'offset x,y') > ")
        if [ -n "${v:-}" ]; then
          pair="${v%% *}"; x="${pair%%,*}"; y="${pair#*,}"
          sset shadow_offset_x "$x"; sset shadow_offset_y "$y"; changed=1
        fi
        ;;
      back|"") break ;;
    esac
    [ "$changed" -eq 1 ] && render >/dev/null 2>&1
  done
}

pick_opacity_advanced(){
  local c v key changed
  while true; do
    c=$( {
      row active     "$(t 'active') · $(sget active_op)%"
      row inactive   "$(t 'inactive') · $(sget inactive_op)%"
      row fullscreen "$(t 'fullscreen') · $(sget fullscreen_op)%"
      row back       "$(t 'back')"
      } | FZFM --prompt="$(t 'opacity') > " \
          --header="$(t 'an 80% floor keeps things readable')" )
    changed=0; key=""
    case "$(mkey "$c")" in
      active) key=active_op ;;
      inactive) key=inactive_op ;;
      fullscreen) key=fullscreen_op ;;
      back|"") break ;;
    esac
    if [ -n "$key" ]; then
      v=$(printf '%s\n' "100 $(t 'opaque')" "98 $(t 'almost opaque')" "95 $(t 'translucent')" "92 $(t 'transparent')" "88 $(t 'marked')" "80 $(t 'safe floor')" \
        | FZF --prompt="$(t 'opacity percentage') > ")
      [ -n "${v:-}" ] && { sset "$key" "${v%% *}"; changed=1; }
    fi
    [ "$changed" -eq 1 ] && render >/dev/null 2>&1
  done
}

pick_dim_advanced(){
  local v
  v=$( { row nao "$(t 'do not dim inactive windows')"; row sim "$(t 'highlight the focused window')"; } \
    | FZFM --prompt="$(t 'dim inactive') > ")
  [ -n "${v:-}" ] || return 0
  sset dim_inactive "$(mkey "$v")"
  if [ "$(sget dim_inactive)" = sim ]; then
    v=$(printf '%s\n' "5  $(t 'very light')" "8  $(t 'discreet')" "10 $(t 'balanced')" "15 $(t 'strong')" "20 $(t 'very strong')" \
      | FZF --prompt="$(t 'dim strength (%)') > ")
    [ -n "${v:-}" ] && sset dim_strength "${v%% *}"
  fi
  render >/dev/null 2>&1
}

pick_efeitos(){
  local requested="${1:-}" c v
  if [ -n "$requested" ]; then
    if ! effects_preset "$requested"; then
      err "$(t 'invalid preset') '$requested' ($(t 'use performance, subtle, glass or focus'))"
      return 2
    fi
    render
    ok "$(t 'effects'): $(t 'preset') $requested"
    return 0
  fi
  while true; do
    c=$( {
      row preset  "$(t 'preset') · $(t 'a ready, safe profile')"
      row blur    "blur · $(sget blur), $(sget blur_size)x$(sget blur_passes), xray $(sget blur_xray)"
      row shadow  "$(t 'shadow') · $(sget shadow), $(t 'range') $(sget shadow_range), $(t 'power') $(sget shadow_power)"
      row opacity "$(t 'opacity') · $(t 'active') $(sget active_op)%, $(t 'inactive') $(sget inactive_op)%, $(t 'fullscreen') $(sget fullscreen_op)%"
      row dim     "$(t 'dim') · $(t 'inactive') $(sget dim_inactive), $(t 'strength') $(sget dim_strength)%"
      row back    "$(t 'back')"
      } | FZFM --prompt="$(t 'effects') > " \
          --header="$(t 'blur, shadow, transparency and focus; no experimental shaders')" )
    case "$(mkey "$c")" in
      preset)
        v=$( {
          row performance "$(t 'everything opaque, no blur or shadow')"
          row subtle      "$(t 'light shadow and inactive at 96%')"
          row glass       "$(t 'moderate blur and readable transparency')"
          row focus       "$(t 'light blur and dimmed inactive windows')"
          } | FZFM --prompt="$(t 'effects preset') > ")
        if [ -n "${v:-}" ]; then effects_preset "$(mkey "$v")" && render >/dev/null 2>&1; fi
        ;;
      blur) pick_blur_advanced ;;
      shadow) pick_shadow_advanced ;;
      opacity) pick_opacity_advanced ;;
      dim) pick_dim_advanced ;;
      back|"") break ;;
    esac
  done
  ok "blur $(sget blur) · $(t 'shadow') $(sget shadow) · $(t 'opacity') $(sget active_op)/$(sget inactive_op)/$(sget fullscreen_op) · $(t 'dim') $(sget dim_inactive)/$(sget dim_strength)%"
}

# The stored animation value is canonical (consumed by look.lua / hyprland.lua),
# so keep the Portuguese-derived keys but accept English aliases on the CLI.
anim_canon(){ case "$1" in
  off|desligada) echo desligada;; fast|rapida) echo rapida;;
  balanced|equilibrada) echo equilibrada;; smooth|suave) echo suave;;
  elastic|elastica) echo elastica;; esac; }

pick_animacoes(){
  local requested="${1:-}" v canon
  if [ -n "$requested" ]; then
    canon=$(anim_canon "$requested")
    [ -z "$canon" ] && { err "$(t 'invalid preset') '$requested' ($(t 'use off, fast, balanced, smooth or elastic'))"; return 2; }
    sset anim "$canon"; render; ok "$(t 'animations'): $canon"; return 0
  fi
  v=$( {
    row desligada   "$(t 'off — no animations')"
    row rapida      "$(t 'fast — short and responsive')"
    row equilibrada "$(t 'balanced — fluid without lagging the UI')"
    row suave       "$(t 'smooth — longer transitions')"
    row elastica    "$(t 'elastic — windows and workspaces with a damped spring')"
    } | FZFM --prompt="$(t 'animations') ($(sget anim)) > " \
        --header="$(t 'complete presets: windows, fade, layers and workspaces')" )
  [ -n "${v:-}" ] || return 0
  sset anim "$(mkey "$v")"; render; ok "$(t 'animations'): $(sget anim)"
}

# Applies a bar style plus its recommended margin/radius/gap. The knobs stay in
# .state so the fine-tune submenu can override them afterwards, and so the style
# survives palette switches. Colors are always the palette's — see gen_waybar.
bar_style_set(){
  local s="$1"; case "$s" in flat|pills|segmented) ;; *) return 1 ;; esac
  sset bar_style "$s"
  local h
  case "$s" in
    flat)      sset bar_margin 0; sset bar_radius 0;  sset bar_gap 0; h=26 ;;
    pills)     sset bar_margin 8; sset bar_radius 10; sset bar_gap 3; h=34 ;;
    segmented) sset bar_margin 0; sset bar_radius 8;  sset bar_gap 6; h=30 ;;
  esac
  # Pills/segmented need a bit more height so chips are not squished; flat is 26.
  # config.jsonc gets the height from .state on the next render
  # (gen_waybar_layout), written through so a symlinked config survives.
  sset bar_enabled on; sset barh "$h"
}

pick_estilo(){
  local s; s=$( { row flat      "$(t 'flat — attached, minimal (default)')"
                  row pills     "$(t 'pills — floating, one rounded chip per module')"
                  row segmented "$(t 'segmented — attached, rounded module clusters')"
                } | FZFM --prompt="$(t 'bar style') > " \
                    --header="$(t 'the overall look of the bar; colors follow the active palette')" )
  [ -n "${s:-}" ] || return 0
  bar_style_set "$(mkey "$s")"
  render
  # fine-tuning (each keeps current if skipped)
  local m r g
  m=$( { row keep "$(t 'keep current')"; row 0 "0"; row 4 "4px"; row 6 "6px"; row 8 "8px"; row 12 "12px"; } \
       | FZFM --prompt="$(t 'outer margin') > " )
  [ -n "${m:-}" ] && [ "$(mkey "$m")" != keep ] && { sset bar_margin "$(mkey "$m")"; render; }
  r=$( { row keep "$(t 'keep current')"; row 0 "0"; row 4 "4px"; row 8 "8px"; row 12 "12px"; row 999 "$(t 'fully round')"; } \
       | FZFM --prompt="$(t 'corner radius') > " )
  [ -n "${r:-}" ] && [ "$(mkey "$r")" != keep ] && { sset bar_radius "$(mkey "$r")"; render; }
  g=$( { row keep "$(t 'keep current')"; row 0 "0"; row 2 "2px"; row 4 "4px"; row 6 "6px"; row 8 "8px"; } \
       | FZFM --prompt="$(t 'gap between modules') > " )
  [ -n "${g:-}" ] && [ "$(mkey "$g")" != keep ] && { sset bar_gap "$(mkey "$g")"; render; }
  ok "$(t 'style'): $(sget bar_style) · $(t 'margin') $(sget bar_margin) · $(t 'radius') $(sget bar_radius) · $(t 'gap') $(sget bar_gap)"
}

pick_barra(){
  [ -f "$WBAR/config.jsonc" ] || { err "$(t 'Waybar config not found'): ${WBAR/#$HOME/\~}/config.jsonc"; return 1; }
  local h; h=$(printf '%s\n' "0   $(t 'no bar')" "22  $(t 'thin')" "26  $(t 'recommended')" "30  $(t 'tall')" "36  $(t 'thick')" \
      | FZF --prompt="$(t 'bar height') > ")
  if [ -n "${h:-}" ]; then
    if [ "${h%% *}" = "0" ]; then
      sset bar_enabled off
    else
      sset bar_enabled on
      sset barh "${h%% *}"
    fi
  fi
  local p; p=$( { row bottom "$(t 'at the bottom')"; row top "$(t 'at the top')"; } | FZFM --prompt="$(t 'position') > ")
  [ -n "${p:-}" ] && sset barpos "$(mkey "$p")"
  # height/position reach config.jsonc through render -> gen_waybar_layout.
  render
  if [ "$(sget bar_enabled)" = "on" ]; then
    ok "$(t 'bar'): $(sget barh)px, $(sget barpos)"
  else
    warn "$(t 'bar off — run: hyprism bar')"
  fi
}

bar_module_keys(){
  printf '%s\n' bar_launcher bar_workspaces bar_window bar_media bar_language \
    bar_idle bar_temperature bar_disk bar_memory bar_cpu bar_backlight \
    bar_audio bar_network bar_tray bar_battery bar_clock bar_power
}

bar_all(){
  local value="$1" key
  while read -r key; do sset "$key" "$value"; done < <(bar_module_keys)
}

bar_preset(){
  local preset="$1"
  bar_all off
  case "$preset" in
    minimo)
      sset bar_window on; sset bar_audio on; sset bar_network on
      sset bar_clock on; sset bar_power on
      ;;
    equilibrado)
      sset bar_window on; sset bar_media on; sset bar_language on
      sset bar_idle on; sset bar_temperature on; sset bar_disk on
      sset bar_memory on; sset bar_cpu on
      sset bar_audio on; sset bar_network on
      sset bar_clock on; sset bar_power on
      ;;
    completo)
      bar_all on
      ;;
  esac
  # Battery and screen brightness only where the hardware exists (a desktop
  # has neither; the modules would just sit there empty or erroring).
  case "$preset" in
    minimo|equilibrado|completo)
      if has_battery; then sset bar_battery on; else sset bar_battery off; fi ;;
  esac
  case "$preset" in
    equilibrado|completo)
      if has_backlight; then sset bar_backlight on; else sset bar_backlight off; fi ;;
  esac
}

bar_toggle(){
  if [ "$(sget "$1")" = "on" ]; then sset "$1" off; else sset "$1" on; fi
}

bar_mark(){ [ "$(sget "$1")" = "on" ] && printf 'ON ' || printf 'off'; }

pick_modulos(){
  local c key
  while true; do
    c=$(printf '%s\n' \
      "preset       $(t 'choose minimal, balanced or full')" \
      "launcher     [$(bar_mark bar_launcher)] $(t 'search button')" \
      "workspaces   [$(bar_mark bar_workspaces)] $(t 'workspaces')" \
      "window       [$(bar_mark bar_window)] $(t 'window title')" \
      "media        [$(bar_mark bar_media)] $(t 'now playing')" \
      "language     [$(bar_mark bar_language)] $(t 'keyboard language')" \
      "idle         [$(bar_mark bar_idle)] $(t 'prevent sleep')" \
      "temperature  [$(bar_mark bar_temperature)] $(t 'temperature')" \
      "disk         [$(bar_mark bar_disk)] $(t 'disk usage')" \
      "memory       [$(bar_mark bar_memory)] $(t 'RAM')" \
      "cpu          [$(bar_mark bar_cpu)] $(t 'processor usage')" \
      "backlight    [$(bar_mark bar_backlight)] $(t 'screen brightness')" \
      "audio        [$(bar_mark bar_audio)] $(t 'volume')" \
      "network      [$(bar_mark bar_network)] $(t 'clickable Wi-Fi')" \
      "tray         [$(bar_mark bar_tray)] $(t 'app icons')" \
      "battery      [$(bar_mark bar_battery)] $(t 'battery')" \
      "clock        [$(bar_mark bar_clock)] $(t 'clock')" \
      "power        [$(bar_mark bar_power)] $(t 'session menu')" \
      "back         $(t 'back')" | FZF --prompt="$(t 'bar modules') > " \
        --header="$(t 'ENTER toggles the item; applied instantly')")
    key="${c%% *}"
    case "$key" in
      preset)
        local p; p=$( {
          row minimo      "$(t 'window, sound, network, battery and clock')"
          row equilibrado "$(t 'the current look, without tray icons')"
          row completo    "$(t 'every module, including the tray')"
          } | FZFM --prompt="$(t 'bar profile') > ")
        [ -n "${p:-}" ] && bar_preset "$(mkey "$p")"
        ;;
      launcher) key=bar_launcher;; workspaces) key=bar_workspaces;;
      window) key=bar_window;; media) key=bar_media;; language) key=bar_language;;
      idle) key=bar_idle;; temperature) key=bar_temperature;; disk) key=bar_disk;;
      memory) key=bar_memory;; cpu) key=bar_cpu;; backlight) key=bar_backlight;;
      audio) key=bar_audio;; network) key=bar_network;; tray) key=bar_tray;;
      battery) key=bar_battery;; clock) key=bar_clock;; power) key=bar_power;;
      back|"") break;;
    esac
    case "$key" in bar_*) bar_toggle "$key";; esac
    render >/dev/null 2>&1
  done
}

pick_janelas(){
  local c v
  while true; do
    c=$( {
      row mode       "$(t 'mode') · $(sget float_all) ($(t 'sim = floating; nao = tiling'))"
      row size       "$(t 'size') · $(sget win_size) $(t 'when opening floating')"
      row layout     "$(t 'layout') · $(sget layout) $(t 'for tiled windows')"
      row snap       "$(t 'snapping') · $(sget snap), $(sget snap_gap)px, $(t 'overlap') $(sget snap_overlap), $(t 'gaps') $(sget snap_respect_gaps)"
      row resize     "$(t 'resize from the border') · $(sget resize_border)"
      row activation "$(t 'apps may request focus') · $(sget focus_activate)"
      row split      "$(t 'preserve the tiling split') · $(sget preserve_split)"
      row back       "$(t 'back')"
      } | FZFM --prompt="$(t 'window behavior') > " \
          --header="$(t 'opening, focus, snapping and tiling options')" )
    case "$(mkey "$c")" in
      mode)
        v=$( { row sim "$(t 'floating, free control like KDE')"; row nao "$(t 'tiling, Hyprland arranges')"; } \
          | FZFM --prompt="$(t 'new window') > "); [ -n "${v:-}" ] && sset float_all "$(mkey "$v")"
        ;;
      size)
        v=$(printf '%s\n' "40% 40%" "50% 50%  $(t 'recommended')" "60% 65%" "70% 75%" "85% 85%" "100% 100%  $(t 'full')" \
          | FZF --prompt="$(t 'opening size') > ")
        [ -n "${v:-}" ] && sset win_size "$(echo "$v" | sed 's/  .*//')"
        ;;
      layout)
        v=$( { row dwindle "$(t 'tree tiling')"; row master "$(t 'one master window')"; row scrolling "$(t 'scrolling columns')"; } \
          | FZFM --prompt="$(t 'layout') > "); [ -n "${v:-}" ] && sset layout "$(mkey "$v")"
        ;;
      snap)
        v=$( { row sim "$(t 'sticks to edges and other windows')"; row nao "$(t 'fully free movement')"; } \
          | FZFM --prompt="$(t 'magnetic snapping') > "); [ -n "${v:-}" ] && sset snap "$(mkey "$v")"
        if [ "$(sget snap)" = sim ]; then
          v=$(printf '%s\n' "5  $(t 'very close')" "10 $(t 'recommended')" "15 " "20 $(t 'easier to snap')" "30 " | FZF --prompt="$(t 'snap distance') > ")
          [ -n "${v:-}" ] && sset snap_gap "${v%% *}"
          v=$( { row nao "$(t 'edges only touch')"; row sim "$(t 'allow overlapping edges')"; } | FZFM --prompt="$(t 'overlap on snap') > ")
          [ -n "${v:-}" ] && sset snap_overlap "$(mkey "$v")"
          v=$( { row sim "$(t 'respect configured gaps')"; row nao "$(t 'snap to the real edge')"; } | FZFM --prompt="$(t 'respect gaps') > ")
          [ -n "${v:-}" ] && sset snap_respect_gaps "$(mkey "$v")"
        fi
        ;;
      resize)
        v=$( { row sim "$(t 'dragging the border resizes')"; row nao "$(t 'only SUPER + right button')"; } \
          | FZFM --prompt="$(t 'resize on border') > "); [ -n "${v:-}" ] && sset resize_border "$(mkey "$v")"
        ;;
      activation)
        v=$( { row nao "$(t 'prevents focus stealing (recommended)')"; row sim "$(t 'apps may bring their window forward')"; } \
          | FZFM --prompt="$(t 'focus request') > "); [ -n "${v:-}" ] && sset focus_activate "$(mkey "$v")"
        ;;
      split)
        v=$( { row sim "$(t 'keeps the chosen split')"; row nao "$(t 'recomputes with the size')"; } \
          | FZFM --prompt="$(t 'preserve split') > "); [ -n "${v:-}" ] && sset preserve_split "$(mkey "$v")"
        ;;
      back|"") break;;
    esac
    render >/dev/null 2>&1
  done
}

pick_workspaces(){
  local c v changed
  while true; do
    c=$( {
      row count      "$(t 'count') · $(sget workspace_count) $(t 'numbered areas')"
      row persistent "$(t 'persistent') · $(sget workspace_persistent)"
      row smartgaps  "smart-gaps · $(sget workspace_smart_gaps)"
      row layout     "$(t 'layout') · $(sget workspace_layout)"
      row gap        "$(t 'gap') · $(sget workspace_gap)px $(t 'between areas')"
      row wrap       "$(t 'wrap') · $(sget workspace_wrap)"
      row backforth  "$(t 'back-and-forth') · $(sget workspace_backforth)"
      row back       "$(t 'back')"
      } | FZFM --prompt="$(t 'workspaces') > " \
          --header="$(t 'rules, shortcuts and workspace behavior')" )
    changed=0
    case "$(mkey "$c")" in
      count)
        v=$(printf '%s\n' "4  $(t 'compact')" "5 " "6 " "7 " "8 " "9  $(t 'default (SUPER+1..9)')" "10 $(t 'includes SUPER+0')" \
          | FZF --prompt="$(t 'number of areas') > ")
        [ -n "${v:-}" ] && { sset workspace_count "${v%% *}"; changed=1; }
        ;;
      persistent)
        v=$( { row nao "$(t 'empty areas disappear')"; row sim "$(t 'keep all numbered areas')"; } \
          | FZFM --prompt="$(t 'persistent areas') > ")
        [ -n "${v:-}" ] && { sset workspace_persistent "$(mkey "$v")"; changed=1; }
        ;;
      smartgaps)
        v=$( { row nao "$(t 'always keep border and gaps')"; row sim "$(t 'drop border and gaps with a single tiled window')"; } \
          | FZFM --prompt="smart gaps > ")
        [ -n "${v:-}" ] && { sset workspace_smart_gaps "$(mkey "$v")"; changed=1; }
        ;;
      layout)
        v=$( { row global "$(t 'follow the general window layout')"; row dwindle "$(t 'dynamic tree everywhere')"; \
               row master "$(t 'one master window everywhere')"; row scrolling "$(t 'scrolling columns everywhere')"; } \
          | FZFM --prompt="$(t 'workspace layout') > ")
        [ -n "${v:-}" ] && { sset workspace_layout "$(mkey "$v")"; changed=1; }
        ;;
      gap)
        v=$(printf '%s\n' "0  $(t 'no extra space')" "2  $(t 'minimal')" "4  $(t 'discreet')" "8  $(t 'visible')" "12 $(t 'wide')" "20 $(t 'very wide')" \
          | FZF --prompt="$(t 'gap between workspaces') > " \
            --header="$(t 'mostly visible during the transition')")
        [ -n "${v:-}" ] && { sset workspace_gap "${v%% *}"; changed=1; }
        ;;
      wrap)
        v=$( { row nao "$(t 'animation follows numeric order')"; row sim "$(t 'shortest visual path at the ends')"; } \
          | FZFM --prompt="$(t 'wrap transition') > ")
        [ -n "${v:-}" ] && { sset workspace_wrap "$(mkey "$v")"; changed=1; }
        ;;
      backforth)
        v=$( { row sim "$(t 'repeat the shortcut returns to the previous area')"; row nao "$(t 'repeating keeps the current area')"; } \
          | FZFM --prompt="$(t 'back to previous area') > ")
        [ -n "${v:-}" ] && { sset workspace_backforth "$(mkey "$v")"; changed=1; }
        ;;
      back|"") break ;;
    esac
    [ "$changed" -eq 1 ] && render >/dev/null 2>&1
  done
  ok "workspaces: $(sget workspace_count) · $(t 'persistent') $(sget workspace_persistent) · smart-gaps $(sget workspace_smart_gaps) · $(t 'layout') $(sget workspace_layout) · $(t 'wrap') $(sget workspace_wrap)"
}

pick_entrada(){
  local c v k kbv touch=0
  # Touchpad rows (and touchpad gestures) only when a touchpad exists.
  has_touchpad && touch=1
  while true; do
    kbv=$(sget kb_variant)
    c=$( {
      row keyboard    "$(t 'keyboard') · $(sget kb_layout)${kbv:+ / $kbv}"
      row focus       "$(t 'focus') · $(t 'mouse mode') $(sget follow_mouse)"
      row sensitivity "$(t 'sensitivity') · $(sget mouse_sensitivity)"
      row wheel       "$(t 'wheel') · $(t 'speed') $(sget mouse_scroll), $(t 'natural') $(sget mouse_natural)"
      if [ "$touch" -eq 1 ]; then
        row touchscroll "touch-scroll · $(t 'speed') $(sget touch_scroll), $(t 'natural') $(sget touch_natural)"
        row touchtap    "$(t 'touch-tap') · $(t 'tap to click') $(sget touch_tap)"
        row touchtype   "$(t 'touch-typing') · $(t 'disable while typing') $(sget touch_dwt)"
        row gestures    "$(t 'gestures') · $(sget gesture_fingers) $(t 'fingers to switch area')"
      fi
      row back        "$(t 'back')"
      } | FZFM --prompt="$(t 'keyboard, mouse and touchpad') > " \
          --header="$(t 'all values are applied by Hyprland')" )
    case "$(mkey "$c")" in
      keyboard)
        # KEY = layout|variant (an empty variant is the plain layout).
        v=$( {
          row "br|"            "br           $(t 'Portuguese Brazil, ABNT2 (no variant)')"
          row "br|thinkpad"    "br thinkpad  $(t 'Portuguese Brazil, ThinkPad')"
          row "br|nodeadkeys"  "br nodeadkeys $(t 'Portuguese Brazil, no dead keys')"
          row "us|"            "us           $(t 'US English')"
          row "us|intl"        "us intl      $(t 'US English, international')"
          row "us|altgr-intl"  "us altgr-intl $(t 'US English, international AltGr')"
          } | FZFM --prompt="$(t 'keyboard layout') > ")
        if [ -n "${v:-}" ]; then
          k=$(mkey "$v")
          sset kb_layout "${k%%|*}"; sset kb_variant "${k#*|}"
        fi
        ;;
      focus)
        v=$(printf '%s\n' \
          "0  $(t 'focus changes on click')" \
          "1  $(t 'focus follows the pointer (current/recommended)')" \
          "2  $(t 'pointer and keyboard separate; click gives focus')" \
          | FZF --prompt="$(t 'mouse focus') > ")
        [ -n "${v:-}" ] && sset follow_mouse "${v%% *}"
        ;;
      sensitivity)
        v=$(printf '%s\n' "-1.0 $(t 'very slow')" "-0.5 $(t 'slower')" "0 $(t 'normal')" "0.5 $(t 'faster')" "1.0 $(t 'very fast')" \
          | FZF --prompt="$(t 'sensitivity') > ")
        [ -n "${v:-}" ] && sset mouse_sensitivity "${v%% *}"
        ;;
      wheel)
        v=$( { row nao "$(t 'traditional scrolling')"; row sim "$(t 'natural/inverted scrolling')"; } | FZFM --prompt="$(t 'natural mouse scroll') > ")
        [ -n "${v:-}" ] && sset mouse_natural "$(mkey "$v")"
        v=$(printf '%s\n' "0.50 $(t 'slow')" "0.75 $(t 'soft')" "1.00 $(t 'normal')" "1.25 $(t 'fast')" "1.50 $(t 'very fast')" "2.00 $(t 'super fast')" | FZF --prompt="$(t 'wheel speed') > ")
        [ -n "${v:-}" ] && sset mouse_scroll "${v%% *}"
        ;;
      touchscroll)
        v=$( { row sim "$(t 'content follows the fingers')"; row nao "$(t 'traditional scrolling')"; } | FZFM --prompt="$(t 'natural touchpad scroll') > ")
        [ -n "${v:-}" ] && sset touch_natural "$(mkey "$v")"
        v=$(printf '%s\n' "0.50 $(t 'slow')" "0.75 $(t 'soft')" "1.00 $(t 'normal')" "1.25 $(t 'fast')" "1.50 $(t 'very fast')" "2.00 $(t 'super fast')" | FZF --prompt="$(t 'touchpad speed') > ")
        [ -n "${v:-}" ] && sset touch_scroll "${v%% *}"
        ;;
      touchtap)
        v=$( { row sim "$(t 'a tap equals a click')"; row nao "$(t 'requires pressing the touchpad')"; } | FZFM --prompt="$(t 'tap to click') > ")
        [ -n "${v:-}" ] && sset touch_tap "$(mkey "$v")"
        ;;
      touchtype)
        v=$( { row sim "$(t 'avoids accidental taps while typing')"; row nao "$(t 'touchpad always active')"; } | FZFM --prompt="$(t 'touchpad while typing') > ")
        [ -n "${v:-}" ] && sset touch_dwt "$(mkey "$v")"
        ;;
      gestures)
        v=$(printf '%s\n' "3  $(t 'three fingers')" "4  $(t 'four fingers')" | FZF --prompt="$(t 'gesture fingers') > ")
        [ -n "${v:-}" ] && sset gesture_fingers "${v%% *}"
        ;;
      back|"") break;;
    esac
    render >/dev/null 2>&1
  done
}

cursor_themes(){
  find /usr/share/icons "$HOME/.local/share/icons" "$HOME/.icons" \
    -maxdepth 2 -type d -name cursors -printf '%h\n' 2>/dev/null \
    | sed 's#/$##' | xargs -r -n1 basename | sort -u
}

pick_cursor(){
  local c v
  while true; do
    c=$( {
      row theme   "$(t 'theme') · $(sget cursor_theme)"
      row size    "$(t 'size') · $(sget cursor_size)px"
      row typing  "$(t 'typing') · $(t 'hide while typing') $(sget cursor_hide_key)"
      row idle    "$(t 'idle') · $(t 'hide after') $(sget cursor_timeout)s (0 = $(t 'never'))"
      row back    "$(t 'back')"
      } | FZFM --prompt="$(t 'cursor') > " \
          --header="$(t 'theme and size change live; some apps need a restart')" )
    case "$(mkey "$c")" in
      theme)
        v=$(cursor_themes | FZF --prompt="$(t 'cursor theme') > ")
        [ -n "${v:-}" ] && sset cursor_theme "$v"
        ;;
      size)
        v=$(printf '%s\n' "16 $(t 'small')" "20 $(t 'compact')" "24 $(t 'normal')" "28 $(t 'medium')" "32 $(t 'large')" "40 $(t 'accessible')" "48 $(t 'very large')" | FZF --prompt="$(t 'cursor size') > ")
        [ -n "${v:-}" ] && sset cursor_size "${v%% *}"
        ;;
      typing)
        v=$( { row nao "$(t 'cursor always visible')"; row sim "$(t 'hide until the mouse moves')"; } | FZFM --prompt="$(t 'hide while typing') > ")
        [ -n "${v:-}" ] && sset cursor_hide_key "$(mkey "$v")"
        ;;
      idle)
        v=$(printf '%s\n' "0  $(t 'never hide')" "2  $(t 'after 2 seconds')" "5  $(t 'after 5 seconds')" "10 $(t 'after 10 seconds')" "30 $(t 'after 30 seconds')" | FZF --prompt="$(t 'idle time') > ")
        [ -n "${v:-}" ] && sset cursor_timeout "${v%% *}"
        ;;
      back|"") break;;
    esac
    render >/dev/null 2>&1
  done
}

pick_bloqueio(){
  local c v img msgnow sub
  while true; do
    msgnow=$(sget lock_message)
    [ -n "$msgnow" ] && msgnow="\"$msgnow\"" || msgnow="$(t 'none')"
    c=$( {
      row background  "$(t 'background') · $(sget lock_bg)"
      row brightness  "$(t 'brightness') · $(sget lock_brightness)% $(t 'of the background')"
      row blur        "$(t 'blur') · $(sget lock_blur) $(t 'passes')"
      row clock       "$(t 'clock') · $(t 'show time and date') $(sget lock_clock)"
      row clock_size  "$(t 'clock size') · $(sget lock_clock_size)px"
      row clock_color "$(t 'clock color') · $(sget lock_clock_color)"
      row clock_fmt   "$(t 'clock format') · $([ "$(sget lock_clock_24h)" = nao ] && echo 12h || echo 24h)"
      row frame       "$(t 'accent frame') · $(sget lock_frame)"
      row avatar      "$(t 'avatar') · $(sget lock_avatar)"
      row campo       "$(t 'password field') · $(sget lock_field_style), $(sget lock_field_width)px, $(sget lock_field_pos)"
      row cursor      "$(t 'cursor') · $(t 'hide on the locked screen') $(sget lock_hide_cursor)"
      row message     "$(t 'message') · $msgnow"
      row test        "$(t 'test') · $(t 'open hyprlock now')"
      row back        "$(t 'back')"
      } | FZFM --prompt="$(t 'lock screen') > " \
          --header="$(t 'customizes hyprlock without changing your password')" )
    case "$(mkey "$c")" in
      background)
        v=$( { row wallpaper "$(t 'follow the wallpaper')"; row image "$(t 'a dedicated image')"; row color "$(t 'a solid color')"; } | FZFM --prompt="$(t 'lock background') > ")
        case "$(mkey "$v")" in
          wallpaper) sset lock_bg wallpaper ;;
          color)     sset lock_bg color ;;
          image)
            img=$(find "$WALLDIR" "$HOME/Pictures" "$HOME/Pictures/Screenshots" -maxdepth 1 -type f \
                    \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null \
                  | sort -u | FZF --delimiter=/ --with-nth=-1 --prompt="$(t 'choose an image') > ")
            [ -n "$img" ] && { sset lock_bg_image "$img"; sset lock_bg image; }
            ;;
        esac
        ;;
      brightness)
        v=$(printf '%s\n' "25 $(t 'very dark')" "35 $(t 'dark')" "50 $(t 'balanced')" "65 $(t 'light')" "80 $(t 'very light')" "100 $(t 'original')" | FZF --prompt="$(t 'background brightness') > ")
        [ -n "${v:-}" ] && sset lock_brightness "${v%% *}"
        ;;
      blur)
        v=$(printf '%s\n' "0  $(t 'no blur')" "1  $(t 'light')" "2  $(t 'medium')" "3  $(t 'strong')" "4  $(t 'very strong')" | FZF --prompt="$(t 'background blur') > ")
        [ -n "${v:-}" ] && sset lock_blur "${v%% *}"
        ;;
      clock)
        v=$( { row sim "$(t 'show time and date')"; row nao "$(t 'user and password only')"; } | FZFM --prompt="$(t 'clock') > ")
        [ -n "${v:-}" ] && sset lock_clock "$(mkey "$v")"
        ;;
      clock_size)
        v=$(printf '%s\n' "96 $(t 'small')" "128 $(t 'medium')" "160 $(t 'large')" "200 $(t 'huge')" | FZF --prompt="$(t 'clock size') > ")
        [ -n "${v:-}" ] && { sset lock_clock_size "${v%% *}"; sset lock_clock sim; }
        ;;
      clock_color)
        v=$( { row fg "$(t 'text')"; row accent "$(t 'accent')"; row accent_lit "$(t 'light accent')"; } | FZFM --prompt="$(t 'clock color') > ")
        [ -n "${v:-}" ] && { sset lock_clock_color "$(mkey "$v")"; sset lock_clock sim; }
        ;;
      clock_fmt)
        v=$( { row sim "$(t '24-hour')"; row nao "$(t '12-hour (AM/PM)')"; } | FZFM --prompt="$(t 'clock format') > ")
        [ -n "${v:-}" ] && { sset lock_clock_24h "$(mkey "$v")"; sset lock_clock sim; }
        ;;
      frame)
        v=$( { row sim "$(t 'show the accent frame')"; row nao "$(t 'no frame')"; } | FZFM --prompt="$(t 'accent frame') > ")
        [ -n "${v:-}" ] && sset lock_frame "$(mkey "$v")"
        ;;
      avatar)
        v=$( { row sim "$(t 'show the avatar')"; row nao "$(t 'hide the avatar')"; } | FZFM --prompt="$(t 'avatar') > ")
        [ -n "${v:-}" ] && sset lock_avatar "$(mkey "$v")"
        ;;
      campo)
        sub=$( {
          row style    "$(t 'corner style') · $(sget lock_field_style)"
          row width    "$(t 'width') · $(sget lock_field_width)px"
          row position "$(t 'position on screen') · $(sget lock_field_pos)"
          row back     "$(t 'back')"
          } | FZFM --prompt="$(t 'password field') > " )
        case "$(mkey "$sub")" in
          style)
            v=$( { row pill "$(t 'pill (very round)')"; row rounded "$(t 'rounded')"; row square "$(t 'square corners')"; } | FZFM --prompt="$(t 'corner style') > ")
            [ -n "${v:-}" ] && sset lock_field_style "$(mkey "$v")"
            ;;
          width)
            v=$(printf '%s\n' "200 $(t 'very small')" "240 $(t 'small')" "280 $(t 'normal')" "340 $(t 'wide')" "420 $(t 'very wide')" | FZF --prompt="$(t 'width') > ")
            [ -n "${v:-}" ] && sset lock_field_width "${v%% *}"
            ;;
          position)
            v=$( { row high "$(t 'higher')"; row mid "$(t 'centered')"; row low "$(t 'lower')"; row bottom "$(t 'near the bottom')"; } | FZFM --prompt="$(t 'position on screen') > ")
            [ -n "${v:-}" ] && sset lock_field_pos "$(mkey "$v")"
            ;;
        esac
        ;;
      cursor)
        v=$( { row sim "$(t 'hide the cursor')"; row nao "$(t 'keep it visible')"; } | FZFM --prompt="$(t 'cursor on lock') > ")
        [ -n "${v:-}" ] && sset lock_hide_cursor "$(mkey "$v")"
        ;;
      message)
        printf '\n  %s\n  %s: ' "$(t 'Type a line for the bottom of the lock screen.')" "$(t 'Leave empty for no line')"
        IFS= read -r v || v=""
        sset lock_message "$v"
        ;;
      test)
        render >/dev/null 2>&1
        have hyprlock && setsid hyprlock >/dev/null 2>&1 < /dev/null &
        break
        ;;
      back|"") break;;
    esac
    render >/dev/null 2>&1
  done
}

pick_notificacoes(){
  local c v
  while true; do
    c=$( {
      row position "$(t 'position') · $(sget notif_position)"
      row width    "$(t 'width') · $(sget notif_width)px"
      row timeout  "$(t 'timeout') · $(sget notif_timeout)s"
      row icons    "$(t 'icons') · $(sget notif_icons)"
      row test     "$(t 'test') · $(t 'send a sample notification')"
      row back     "$(t 'back')"
      } | FZFM --prompt="$(t 'notifications') > " \
          --header="$(t 'dunst appearance; critical alerts never auto-dismiss')" )
    case "$(mkey "$c")" in
      position)
        v=$(printf '%s\n' "top-left $(t 'top left')" "top-center $(t 'top center')" \
          "top-right $(t 'top right')" "bottom-left $(t 'bottom left')" \
          "bottom-center $(t 'bottom center')" "bottom-right $(t 'bottom right')" \
          | FZF --prompt="$(t 'position') > ")
        [ -n "${v:-}" ] && sset notif_position "${v%% *}"
        ;;
      width)
        v=$(printf '%s\n' "280 $(t 'compact')" "320 $(t 'small')" "360 $(t 'normal')" "420 $(t 'wide')" "500 $(t 'very wide')" | FZF --prompt="$(t 'width') > ")
        [ -n "${v:-}" ] && sset notif_width "${v%% *}"
        ;;
      timeout)
        v=$(printf '%s\n' "3 $(t 'short')" "5 $(t 'quick')" "8 $(t 'normal')" "12 $(t 'long')" "20 $(t 'very long')" | FZF --prompt="$(t 'duration') > ")
        [ -n "${v:-}" ] && sset notif_timeout "${v%% *}"
        ;;
      icons)
        v=$( { row sim "$(t 'show the app icon')"; row nao "$(t 'title and text only')"; } | FZFM --prompt="$(t 'icons') > ")
        [ -n "${v:-}" ] && sset notif_icons "$(mkey "$v")"
        ;;
      test)
        render >/dev/null 2>&1
        have notify-send && notify-send 'Hyprism' "$(t 'This is how your notifications will look.')"
        ;;
      back|"") break;;
    esac
    render >/dev/null 2>&1
  done
}

pick_fonte(){
  local f; f=$( { fc-list : family 2>/dev/null | tr ',' '\n' | grep -iE 'nerd font mono|noto sans|dejavu sans' ; } \
      | sed 's/^ *//;s/ *$//' | sort -u | FZF --prompt="$(t 'bar font') > ")
  [ -n "${f:-}" ] && sset barfont "$f"
  local s; s=$(printf '%s\n' 10 11 "12  $(t 'recommended')" 13 14 | FZF --prompt="$(t 'size') > ")
  [ -n "${s:-}" ] && sset barsize "${s%% *}"
  render; ok "$(t 'font'): $(sget barfont) $(sget barsize)"
}

show_binds(){
  cat <<EOF

  $(t 'LAUNCH')
    SUPER + Space ......... $(t 'launcher (rofi)')
    SUPER + Enter ......... $(t 'terminal')
    SUPER + E ............. $(t 'files')
    SUPER + Tab ........... $(t 'open windows')
    SUPER + R ............. $(t 'run a command')

  $(t 'WINDOW')
    SUPER + Q ............. $(t 'close')
    SUPER + F ............. $(t 'fullscreen')
    SUPER + M ............. $(t 'maximize (respects the bar)')
    SUPER + C ............. $(t 'center')
    SUPER + V ............. $(t 'toggle floating/tiled')
    SUPER + CTRL + arrows . $(t 'resize')
    SUPER + ALT  + arrows . $(t 'move')
    SUPER + SHIFT + arrows  $(t 'snap to half the screen')
    SUPER + right button .. $(t 'resize with the mouse')
    drag the border ....... $(t 'resize with the mouse')

  $(t 'WORKSPACES')
    SUPER + 1..9 .......... $(t 'switch (and 0 when a tenth exists)')
    SUPER + SHIFT + number  $(t 'move the window')

  $(t 'SYSTEM')
    SUPER + L ............. $(t 'lock')
    SUPER + SHIFT + S ..... $(t 'screenshot region')
    PrintScreen ........... $(t 'full screen')
    SUPER + SHIFT + Q ..... $(t 'exit the session')

EOF
  read -rp "  [enter] " _
}

# ---------- presets ----------
# Built-in presets ship read-only with the repo; user presets live in
# $PRESETS and win on a name clash. Format: key=value lines with the same keys
# as .state (+ paleta=<palette>, wallpaper=<file>); '#' lines are comments —
# the first "# " line is the description ("# pt: ..." when lang=pt).
BUILTIN_PRESETS="$HYPRISM_ROOT/presets"

# Keys a preset never changes: the interface language and personal input.
preset_skip_key(){
  case "$1" in
    paleta|wallpaper|lang|kb_layout|kb_variant|mouse_sensitivity|mouse_natural|touch_*|cursor_theme|cursor_size) return 0 ;;
  esac
  return 1
}
preset_sanitize(){  # no '/', whitespace -> '-', no leading '.'/'-'
  local n="$1"
  n=${n//\//}; n=${n//[[:space:]]/-}
  while [[ $n == [.-]* ]]; do n=${n#?}; done
  printf '%s' "$n"
}
preset_file(){  # NAME -> file path (user first, then built-in)
  local n="$1" c
  for c in "$n" "$(preset_sanitize "$n")"; do
    [ -n "$c" ] || continue
    [ -f "$PRESETS/$c.preset" ] && { printf '%s' "$PRESETS/$c.preset"; return 0; }
    [ -f "$BUILTIN_PRESETS/$c.preset" ] && { printf '%s' "$BUILTIN_PRESETS/$c.preset"; return 0; }
  done
  return 1
}
preset_desc(){
  local d=""
  [ "$LANGX" = pt ] && d=$(awk '/^# pt:/ { sub(/^# pt:[[:space:]]*/, ""); print; exit }' "$1" 2>/dev/null)
  [ -n "$d" ] || d=$(awk '/^# pt:/ { next } /^# / { sub(/^# /, ""); print; exit }' "$1" 2>/dev/null)
  printf '%s' "$d"
}
# One line per preset: FILE<TAB>NAME<TAB>builtin|user, sorted by name.
preset_entries(){
  local f n
  local -A seen=()
  {
    for f in "$PRESETS"/*.preset; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.preset}; seen[$n]=1
      printf '%s\t%s\tuser\n' "$f" "$n"
    done
    for f in "$BUILTIN_PRESETS"/*.preset; do
      [ -f "$f" ] || continue
      n=${f##*/}; n=${n%.preset}
      [ -n "${seen[$n]+x}" ] && continue
      printf '%s\t%s\tbuiltin\n' "$f" "$n"
    done
  } | sort -t$'\t' -k2,2
}
preset_list(){
  local f n src d any=0
  while IFS=$'\t' read -r f n src; do
    any=1; d=$(preset_desc "$f")
    if [ "$src" = builtin ]; then printf '  ★ %-22s %s\n' "$n" "$d"
    else printf '    %-22s %s\n' "$n" "${d:-($(t 'user preset'))}"; fi
  done < <(preset_entries)
  [ "$any" -eq 1 ] || warn "$(t 'no presets yet')"
}

save_preset(){
  local n; read -rp "  $(t 'preset name'): " n
  n=$(preset_sanitize "${n:-}")
  [ -z "$n" ] && return 0
  { printf '# %s\n' "$(t 'saved on') $(date +%F)"
    grep -vE '^(paleta|wallpaper)=' "$SET" 2>/dev/null
    printf 'paleta=%s\n' "$(cat "$STATE" 2>/dev/null)"
    printf 'wallpaper=%s\n' "$(cat "$WALLFILE" 2>/dev/null)"; } > "$PRESETS/$n.preset"
  ok "$(t 'saved'): $n"
}

# Applies a preset by MERGING it into .state: only the keys it lists change
# (never lang or the personal input keys). An empty/missing wallpaper keeps the
# current one; a palette switch without an explicit accent resets the manual
# accent so the chosen palette really shows (same rule as apply()).
preset_apply(){
  local f="$1" name="$2" line k v p="" w="" has_acc=0 kv
  kv=$(mktemp "${TMPDIR:-/tmp}/hyprism-preset.XXXXXX") || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    case "$line" in ''|'#'*) continue ;; esac
    [[ $line == *=* ]] || continue
    k=${line%%=*}; v=${line#*=}
    [[ $k =~ ^[A-Za-z0-9_]+$ ]] || continue
    case "$k" in paleta) p=$v; continue ;; wallpaper) w=$v; continue ;; accent_override) has_acc=1 ;; esac
    preset_skip_key "$k" && continue
    printf '%s=%s\n' "$k" "$v" >> "$kv"
  done < "$f"
  if [ -n "$p" ]; then
    if [ -f "$PAL/$p.env" ]; then
      printf '%s\n' "$p" > "$STATE"
      [ "$has_acc" -eq 1 ] || printf 'accent_override=\naccent_bright=100\nborder_inactive=\n' >> "$kv"
    else
      warn "$(t 'palette') '$p' $(t 'does not exist — try hyprism -l')"
    fi
  fi
  _state_merge "$kv"; rm -f "$kv"
  if [ -n "$w" ] && [ -f "$w" ]; then
    printf '%s\n' "$w" > "$WALLFILE"
    apply_wall_now "$w"
  fi
  render; ok "$(t 'preset applied'): $name"
}

load_preset(){
  local sel f n src d label qself
  qself=$(printf '%q' "$SELF")
  sel=$(while IFS=$'\t' read -r f n src; do
          d=$(preset_desc "$f")
          if [ "$src" = builtin ]; then label=$(printf '★ %-20s %s' "$n" "$d")
          else label=$(printf '  %-20s %s' "$n" "${d:-($(t 'user preset'))}"); fi
          row "$f" "$label"
        done < <(preset_entries) \
      | FZFM --prompt="$(t 'preset') > " --preview "$qself __presetprev {}" --preview-window='right,48%' \
          --header="$(t '★ built-in · ENTER applies (only the keys the preset lists)')")
  [ -z "${sel:-}" ] && return 0
  f=$(mkey "$sel"); n=${f##*/}; n=${n%.preset}
  [ -f "$f" ] || return 1
  preset_apply "$f" "$n"
}

pick_preset(){
  local c; c=$( {
      row save "$(t 'save the current look under a name')"
      row load "$(t 'apply a saved preset')"
      } | FZFM --prompt="$(t 'presets') > ")
  case "$(mkey "$c")" in save) save_preset;; load) load_preset;; esac
}

# hyprism preset [list|<name>]
preset_cmd(){
  case "${1:-}" in
    "") need_fzf; pick_preset ;;
    list|ls|-l) preset_list ;;
    *) local f; f=$(preset_file "$1") || { err "$(t 'preset not found'): $1"; preset_list >&2; return 1; }
       local n=${f##*/}; preset_apply "$f" "${n%.preset}" ;;
  esac
}

sync_global(){
  # The source of truth is Hyprland's active palette. This never pulls colors
  # from a consumer: it reapplies the global theme and tells Kitty/Rofi to follow.
  local h failed=0
  h=$(cat "$STATE" 2>/dev/null)
  [ -n "$h" ] || { err "$(t 'Hyprland has no active global theme')"; return 1; }
  [ -f "$PAL/$h.env" ] || { err "$(t 'global palette') \"$h\" $(t 'does not exist')"; return 1; }

  render || return 1

  if have kittytheme; then
    kittytheme sync >/dev/null 2>&1 || { err "$(t 'failed to sync Kitty')"; failed=1; }
  else
    warn "$(t 'kittytheme not found; Kitty was not changed')"; failed=1
  fi
  if have rofitheme; then
    rofitheme sync >/dev/null 2>&1 || { err "$(t 'failed to sync Rofi')"; failed=1; }
  else
    warn "$(t 'rofitheme not found; Rofi was not changed')"; failed=1
  fi

  [ "$failed" -eq 0 ] && ok "$(t 'global theme') $h $(t 'propagated: Hyprland → Kitty + Rofi')"
  return "$failed"
}

show_config(){
  local L=13
  echo
  printf "%-${L}s %s\n" "$(t 'palette')"       "$(cat "$STATE" 2>/dev/null || echo '-')"
  printf "%-${L}s %s\n" "$(t 'wallpaper')"     "$(basename "$(cat "$WALLFILE" 2>/dev/null || echo '-')")"
  printf "%-${L}s %s px\n" "$(t 'border')"     "$(sget border)"
  printf "%-${L}s %s px | $(t 'power') %s\n" "$(t 'corners')" "$(sget rounding)" "$(sget rounding_power)"
  printf "%-${L}s %s / %s\n" "$(t 'spacing')"  "$(sget gaps_in)" "$(sget gaps_out)"
  printf "%-${L}s %s\n" "blur"                 "$(sget blur)"
  printf "%-${L}s xray %s | $(t 'brightness') %s | $(t 'vibrancy') %s\n" "$(t 'advanced blur')" \
    "$(sget blur_xray)" "$(sget blur_brightness)" "$(sget blur_vibrancy)"
  printf "%-${L}s %s\n" "$(t 'shadow')"        "$(sget shadow)"
  printf "%-${L}s $(t 'range') %s | $(t 'power') %s | $(t 'scale') %s | offset %s,%s\n" "$(t 'shadow cfg')" \
    "$(sget shadow_range)" "$(sget shadow_power)" "$(sget shadow_scale)" \
    "$(sget shadow_offset_x)" "$(sget shadow_offset_y)"
  printf "%-${L}s $(t 'active') %s%% | $(t 'inactive') %s%% | $(t 'fullscreen') %s%%\n" "$(t 'opacity')" \
    "$(sget active_op)" "$(sget inactive_op)" "$(sget fullscreen_op)"
  printf "%-${L}s %s | $(t 'strength') %s%%\n" "$(t 'dim')" "$(sget dim_inactive)" "$(sget dim_strength)"
  printf "%-${L}s %s\n" "$(t 'animations')"    "$(sget anim)"
  printf "%-${L}s %s\n" "$(t 'floating')"      "$(sget float_all)"
  printf "%-${L}s %s\n" "$(t 'opening')"       "$(sget win_size)"
  printf "%-${L}s %s | $(t 'snap') %s (%spx) | $(t 'overlap') %s | $(t 'respect gaps') %s\n" "$(t 'layout')" \
    "$(sget layout)" "$(sget snap)" "$(sget snap_gap)" \
    "$(sget snap_overlap)" "$(sget snap_respect_gaps)"
  printf "%-${L}s %s | $(t 'persistent') %s | smart-gaps %s | $(t 'layout') %s | gap %s | $(t 'wrap') %s | $(t 'back-and-forth') %s\n" workspaces \
    "$(sget workspace_count)" "$(sget workspace_persistent)" \
    "$(sget workspace_smart_gaps)" "$(sget workspace_layout)" \
    "$(sget workspace_gap)" "$(sget workspace_wrap)" "$(sget workspace_backforth)"
  printf "%-${L}s %s, %spx, %s, %s %s\n" "$(t 'bar')" "$(sget bar_enabled)" "$(sget barh)" "$(sget barpos)" "$(sget barfont)" "$(sget barsize)"
  printf "%-${L}s %s | $(t 'margin') %s | $(t 'radius') %s | $(t 'gap') %s\n" "$(t 'bar style')" \
    "$(sget bar_style)" "$(sget bar_margin)" "$(sget bar_radius)" "$(sget bar_gap)"
  printf "%-${L}s %s %s\n" "$(t 'keyboard')"   "$(sget kb_layout)" "$(sget kb_variant)"
  printf "%-${L}s $(t 'focus') %s | $(t 'sens') %s | scroll %s\n" "$(t 'mouse')" "$(sget follow_mouse)" "$(sget mouse_sensitivity)" "$(sget mouse_scroll)"
  printf "%-${L}s $(t 'natural') %s | $(t 'tap') %s | $(t 'while typing') %s | scroll %s\n" "$(t 'touchpad')" \
    "$(sget touch_natural)" "$(sget touch_tap)" "$(sget touch_dwt)" "$(sget touch_scroll)"
  printf "%-${L}s %s %spx | $(t 'idle') %ss\n" "$(t 'cursor')" "$(sget cursor_theme)" "$(sget cursor_size)" "$(sget cursor_timeout)"
  printf "%-${L}s $(t 'brightness') %s%% | blur %s | $(t 'clock') %s\n" "$(t 'lock')" \
    "$(sget lock_brightness)" "$(sget lock_blur)" "$(sget lock_clock)"
  printf "%-${L}s %s | %spx | %ss | $(t 'icons') %s\n" "$(t 'notifications')" \
    "$(sget notif_position)" "$(sget notif_width)" "$(sget notif_timeout)" "$(sget notif_icons)"
  printf "%-${L}s %s\n" "$(t 'language')"      "$(sget lang)"
  printf "%-${L}s %s\n" "kitty"               "$(cat "$KTD/.active" 2>/dev/null || echo '-')"
  printf "%-${L}s %s\n" "rofi"                "$(cat "$HOME/.config/rofi/themes/.active" 2>/dev/null || echo '-')"
  echo; read -rp "  [enter] " _
}

pick_lang(){
  local v; v=$( { row en "$(t 'English')"; row pt "Português (Portuguese)"; } \
      | FZFM --prompt="$(t 'language') > " --header="$(t 'the whole interface, either language')" )
  [ -n "${v:-}" ] || return 0
  sset lang "$(mkey "$v")"; lang_init
  ok "$(t 'language'): $(sget lang)"
}

# ---------- system launchers ----------
launch_gui(){ setsid "$@" >/dev/null 2>&1 </dev/null & }
launch_term(){ setsid kitty -e "$@" >/dev/null 2>&1 </dev/null & }
first_of(){ local c; for c in "$@"; do have "$c" && { printf '%s' "$c"; return 0; }; done; return 1; }

open_sound(){
  local g; g=$(first_of pavucontrol pwvucontrol) && { launch_gui "$g"; return; }
  local t; t=$(first_of wiremix pulsemixer alsamixer) && { launch_term "$t"; return; }
  warn "$(t 'no sound tool found (install pavucontrol)')"
}
open_bluetooth(){
  local g; g=$(first_of blueman-manager overskride) && { launch_gui "$g"; return; }
  local t; t=$(first_of bluetuith bluetoothctl) && { launch_term "$t"; return; }
  warn "$(t 'no bluetooth tool found (install blueman)')"
}
open_displays(){
  local g; g=$(first_of nwg-displays wdisplays) && { launch_gui "$g"; return; }
  warn "$(t 'no display tool found (install nwg-displays)')"
}

# ---------- network module (native, replaces net-tui) ----------
net_summary(){
  have nmcli || { echo "$(t 'NetworkManager (nmcli) not found')"; return; }
  local con ip
  con=$(nmcli -t -f NAME,DEVICE con show --active 2>/dev/null | head -1 | cut -d: -f1)
  ip=$(nmcli -t -f IP4.ADDRESS device show 2>/dev/null | grep -m1 . | cut -d: -f2)
  printf '%-12s %s\n' "$(t 'connection')" "${con:-—}"
  printf '%-12s %s\n' "IP" "${ip:-—}"
}
# nmcli -t escapes ':' as '\:' and '\' as '\\'. This awk function splits a
# terse line on the unescaped ':' only and unescapes each field.
NM_SPLIT='function nmsplit(s, a,   n, i, c, cur) {
  n = 1; cur = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "\\" && i < length(s)) { i++; cur = cur substr(s, i, 1); continue }
    if (c == ":") { a[n++] = cur; cur = ""; continue }
    cur = cur c
  }
  a[n] = cur; return n
}'

# Saved Wi-Fi profiles: UUID<TAB>NAME<TAB>SSID (SSID of the profile itself —
# its name may differ from the network name).
wifi_profiles(){
  local uuid name type ssid
  nmcli -t -f UUID,NAME,TYPE con show 2>/dev/null \
    | awk "$NM_SPLIT"' { nmsplit($0, f); print f[1] "\t" f[2] "\t" f[3] }' \
    | while IFS=$'\t' read -r uuid name type; do
        [ "$type" = 802-11-wireless ] || continue
        ssid=$(nmcli --escape no -g 802-11-wireless.ssid con show uuid "$uuid" 2>/dev/null)
        printf '%s\t%s\t%s\n' "$uuid" "$name" "${ssid:-$name}"
      done
}
wifi_forget_menu(){
  local sel uuid
  sel=$(wifi_profiles | awk -F'\t' '{ printf "%s\t%s  (%s)\n", $1, $2, $3 }' \
      | FZFM --prompt="$(t 'forget which network') > " --header="$(t 'ENTER deletes the saved profile (password included)')")
  [ -n "${sel:-}" ] || return 0
  uuid=$(mkey "$sel")
  nmcli con delete uuid "$uuid" >/dev/null 2>&1 && ok "$(t 'forgotten')" || err "$(t 'failed')"
}
net_wifi(){
  have nmcli || { err "$(t 'nmcli not found')"; return; }
  nmcli radio wifi on >/dev/null 2>&1
  local sel ssid uuid act pw rc
  # Hidden KEY column = the raw SSID (spaces, ':' and multi-word security like
  # "WPA2 WPA3" can no longer shift it). Duplicate APs of one SSID collapse.
  sel=$( { row ':forget' "  $(t 'forget a saved network…')"
           nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan yes 2>/dev/null \
             | awk "$NM_SPLIT"' {
                 nmsplit($0, f); ssid = f[4]
                 if (ssid == "" || seen[ssid]++) next
                 sec = (f[3] == "" || f[3] == "--") ? "open" : f[3]
                 printf "%s\t%s %3s%%  %-14s %s\n", ssid, (f[1] == "*") ? "●" : " ", f[2], sec, ssid }'
         } | FZFM --prompt="$(t 'Wi-Fi networks') > " --header="$(t 'ENTER connects · saved networks can be forgotten')")
  [ -n "${sel:-}" ] || return 0
  ssid=$(mkey "$sel")
  [ "$ssid" = ':forget' ] && { wifi_forget_menu; return; }
  [ -n "$ssid" ] || return 0
  uuid=$(wifi_profiles | S="$ssid" awk -F'\t' '$3 == ENVIRON["S"] { print $1; exit }')
  if [ -n "$uuid" ]; then
    act=$( { row up "$(t 'connect')"; row forget "$(t 'forget this network')"; row back "$(t 'back')"; } \
        | FZFM --prompt="$ssid > ")
    case "$(mkey "$act")" in
      up)     nmcli con up uuid "$uuid" >/dev/null 2>&1 && ok "$(t 'connected'): $ssid" || err "$(t 'failed to connect')" ;;
      forget) nmcli con delete uuid "$uuid" >/dev/null 2>&1 && ok "$(t 'forgotten'): $ssid" || err "$(t 'failed')" ;;
    esac
    return 0
  fi
  printf '  %s: ' "$(t 'password for') $ssid"; read -rs pw; echo
  if [ -n "$pw" ]; then nmcli dev wifi connect "$ssid" password "$pw" >/dev/null 2>&1; rc=$?
  else nmcli dev wifi connect "$ssid" >/dev/null 2>&1; rc=$?; fi
  if [ "$rc" -eq 0 ]; then ok "$(t 'connected'): $ssid"; else err "$(t 'failed to connect')"; fi
}
net_vpn(){
  have nmcli || { err "$(t 'nmcli not found')"; return; }
  local sel
  sel=$(nmcli -t -f NAME,TYPE con show 2>/dev/null | awk -F: '$2 ~ /vpn|wireguard/ {print $1}' \
      | FZF --prompt="$(t 'VPN / tunnels') > " --header="$(t 'ENTER toggles up/down')")
  [ -n "${sel:-}" ] || return 0
  if nmcli -t -f NAME con show --active 2>/dev/null | grep -qx "$sel"; then
    nmcli con down id "$sel" >/dev/null 2>&1 && ok "$(t 'VPN down'): $sel"
  else
    nmcli con up id "$sel" >/dev/null 2>&1 && ok "$(t 'VPN up'): $sel" || err "$(t 'failed')"
  fi
}
net_hostname(){
  local cur new; cur=$(hostnamectl hostname 2>/dev/null || cat /etc/hostname 2>/dev/null)
  printf '  %s: %s\n' "$(t 'current hostname')" "$cur"
  printf '  %s: ' "$(t 'new hostname (empty to cancel)')"; read -r new
  [ -n "${new:-}" ] || return 0
  sudo hostnamectl set-hostname "$new" && ok "$(t 'hostname set to'): $new" || err "$(t 'failed (needs sudo)')"
}
net_status(){
  { echo; net_summary; echo
    nmcli -t -f NAME,TYPE,DEVICE con show --active 2>/dev/null \
      | awk -F: '{printf "  %-22s %-10s %s\n",$1,$2,$3}'
    echo; nmcli device status 2>/dev/null | sed 's/^/  /'
  } | ${PAGER:-less -R}
}
# Native fixed IP / DNS / VLAN via nmcli — no external editor needed.
net_fixed(){
  have nmcli || { err "$(t 'nmcli not found')"; return; }
  local con; con=$(nmcli -t -f NAME con show 2>/dev/null | FZF --prompt="$(t 'connection') > ")
  [ -n "${con:-}" ] || return 0
  while true; do
    local m4 addr gw dns c
    m4=$(nmcli -g ipv4.method con show "$con" 2>/dev/null)
    addr=$(nmcli -g ipv4.addresses con show "$con" 2>/dev/null)
    gw=$(nmcli -g ipv4.gateway con show "$con" 2>/dev/null)
    dns=$(nmcli -g ipv4.dns con show "$con" 2>/dev/null)
    c=$( {
      row dhcp   "$(t 'automatic (DHCP)')"
      row manual "$(t 'manual: IP / gateway / DNS')"
      row dnsx   "$(t 'DNS only')"
      row vlan   "$(t 'create a VLAN')"
      row extern "$(t 'advanced editor (nm-connection-editor)')"
      row back   "$(t 'back')"
      } | FZFM --prompt="$con > " \
          --header="method ${m4:-—} · ip ${addr:-—} · gw ${gw:-—} · dns ${dns:-—}" )
    case "$(mkey "$c")" in
      dhcp)
        nmcli con mod "$con" ipv4.method auto ipv4.addresses "" ipv4.gateway "" ipv4.dns "" ipv4.ignore-auto-dns no >/dev/null 2>&1
        nmcli con up "$con" >/dev/null 2>&1 && ok "$(t 'set to DHCP'): $con" || err "$(t 'failed')" ;;
      manual)
        local a g d
        printf '  %s: ' "$(t 'IP/prefix (e.g. 192.168.1.50/24)')"; read -r a; [ -n "${a:-}" ] || continue
        printf '  %s: ' "$(t 'gateway (optional)')"; read -r g
        printf '  %s: ' "$(t 'DNS, space-separated (optional)')"; read -r d
        nmcli con mod "$con" ipv4.method manual ipv4.addresses "$a" >/dev/null 2>&1
        [ -n "${g:-}" ] && nmcli con mod "$con" ipv4.gateway "$g" >/dev/null 2>&1
        [ -n "${d:-}" ] && nmcli con mod "$con" ipv4.dns "$d" ipv4.ignore-auto-dns yes >/dev/null 2>&1
        nmcli con up "$con" >/dev/null 2>&1 && ok "$(t 'fixed IP set'): $a" || err "$(t 'failed (check the values)')" ;;
      dnsx)
        local d; printf '  %s: ' "$(t 'DNS, space-separated')"; read -r d; [ -n "${d:-}" ] || continue
        nmcli con mod "$con" ipv4.dns "$d" ipv4.ignore-auto-dns yes >/dev/null 2>&1
        nmcli con up "$con" >/dev/null 2>&1 && ok "$(t 'DNS set'): $d" || err "$(t 'failed')" ;;
      vlan) net_vlan ;;
      extern) have nm-connection-editor && launch_gui nm-connection-editor ;;
      back|"") break ;;
    esac
  done
}
net_vlan(){
  local dev id name
  dev=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null \
      | awk -F: '$2=="ethernet"||$2=="wifi"{print $1}' \
      | FZF --prompt="$(t 'parent device') > ")
  [ -n "${dev:-}" ] || return 0
  printf '  %s: ' "$(t 'VLAN id (1-4094)')"; read -r id
  case "$id" in ''|*[!0-9]*) return 0 ;; esac
  name="vlan${id}-${dev}"
  nmcli con add type vlan con-name "$name" dev "$dev" id "$id" >/dev/null 2>&1 \
    && ok "$(t 'VLAN created'): $name" || err "$(t 'failed to create the VLAN')"
}

net_module(){
  if ! have nmcli; then
    warn "$(t 'nmcli not found; opening the legacy net-tui')"
    have net-tui && launch_term net-tui; return
  fi
  while true; do
    local head c; head=$(net_summary | tr '\n' ' ')
    c=$( {
      row wifi     "$(t 'Wi-Fi: scan, connect, forget')"
      row vpn      "$(t 'VPN and tunnels')"
      row fixed    "$(t 'fixed IP, DNS, VLAN')"
      row hostname "$(t 'machine name')"
      row status   "$(t 'detailed status')"
      row back     "$(t 'back')"
      } | FZFM --prompt="$(t 'network') > " --header="$head" )
    case "$(mkey "$c")" in
      wifi) net_wifi ;;   vpn) net_vpn ;;
      fixed) net_fixed ;;
      hostname) net_hostname ;;
      status) net_status ;;
      back|"") break ;;
    esac
  done
}

# ---------- system group ----------
system_menu(){
  while true; do
    local c; c=$( {
      row network   "$(t 'Wi-Fi, VPN, fixed IP, hostname, status')"
      row sound     "$(t 'volume, inputs and outputs')"
      row bluetooth "$(t 'pair and manage devices')"
      row displays  "$(t 'position and resolution')"
      row back      "$(t 'back')"
      } | FZFM --prompt="$(t 'system') > " --header="$(t 'network, sound, bluetooth, displays')" )
    case "$(mkey "$c")" in
      network)   net_module ;;
      sound)     open_sound; return ;;
      bluetooth) open_bluetooth; return ;;
      displays)  open_displays; return ;;
      back|"")   break ;;
    esac
  done
}

# ---------- the Hyprism center ----------
# The face of Hyprism is the unified visual center (visualconf): one screen for
# Hyprland, Waybar, Rofi, Kitty, apps and system, with a live preview panel.
# Running `hyprism`, `hyprism menu` or SUPER+I lands here — we just hand off to
# it. Falls back to the full appearance menu if visualconf is not installed.
center_menu(){
  if have visualconf; then exec visualconf; fi
  need_fzf
  main_menu
}

main_menu(){
  while true; do
    local c; c=$( {
      row palette       "$(t 'the colors (Hyprland, Waybar, Hyprlock, Dunst)')"
      row wallpaper     "$(t 'wallpaper, with a terminal preview')"
      row borders       "$(t 'window border color')"
      row appearance    "$(t 'border width, corners and spacing')"
      row effects       "$(t 'blur, shadow, opacity and focus')"
      row animations    "$(t 'presets for windows, layers and workspaces')"
      row bar           "$(t 'height and position of the bar')"
      row style         "$(t 'bar look: flat / pills / segmented + tuning')"
      row modules       "$(t 'what appears on the bar, item by item')"
      row windows       "$(t 'opening, layout, snapping and focus')"
      row workspaces    "$(t 'count, rules, layout and navigation')"
      row input         "$(t 'keyboard, mouse, touchpad and gestures')"
      row cursor        "$(t 'theme, size and when to hide')"
      row lock          "$(t 'background, clock and cursor of hyprlock')"
      row login         "$(t 'login screen theme (SDDM), like picking a wallpaper')"
      row notifications "$(t 'position, size, timeout and icons')"
      row network       "$(t 'Wi-Fi, VPN, fixed IP, hostname, status')"
      row system        "$(t 'network, sound, bluetooth, displays')"
      row font          "$(t 'family and size of the bar')"
      row lang          "$(t 'interface language (English / Portuguese)')"
      row binds         "$(t 'see the keybinding list')"
      row preset        "$(t 'save or load a whole look')"
      row sync          "$(t 'propagate the global theme to Kitty and Rofi')"
      row config        "$(t 'see everything active')"
      row quit          "$(t 'quit')"
      } | FZFM --prompt='hyprism > ' \
          --header="$(t 'Hyprism · personalization center')" )
    case "$(mkey "$c")" in
      palette) pick_palette ;;       wallpaper) pick_wallpaper ;;
      borders) pick_bordas ;;        appearance) pick_aparencia ;;
      effects) pick_efeitos ;;       animations) pick_animacoes ;;
      bar) pick_barra ;;             style) pick_estilo ;;
      modules) pick_modulos ;;       windows) pick_janelas ;;
      workspaces) pick_workspaces ;; input) pick_entrada ;;
      cursor) pick_cursor ;;         lock) pick_bloqueio ;;
      login) pick_sddm ;;
      notifications) pick_notificacoes ;;
      network) net_module ;;         system) system_menu ;;
      font) pick_fonte ;;
      lang) pick_lang ;;             binds) show_binds ;;
      preset) pick_preset ;;         sync) sync_global ;;
      config) show_config ;;         quit|"") break ;;
    esac
  done
}

# Every menu needs fzf: check once, before dispatching, with a clear message.
need_fzf(){
  have fzf && return 0
  err "$(t 'fzf is required for the menus — install it (e.g. sudo pacman -S fzf), or use: hyprism <palette>')"
  exit 1
}

# ---------- dispatch ----------
# Hot paths first: wallpaper/border/brightness previews run on every cursor
# move, so they skip seed() (and the translation catalog when they print no
# text). Missing keys simply read as empty there.
case "${1:-}" in
  __wlive)     queue_wall_preview "$WALLDIR/$2"; exit ;;
  __wworker)   wall_preview_worker; exit ;;
  __wfind)     wall_find; exit ;;
  __blive)     border_live "$(border_hex "$2")" ""; exit ;;
  __brlive)    bright_live "$2"; exit ;;
  __presetprev) cat -- "${2%%$'\t'*}" 2>/dev/null; exit 0 ;;
  -V|--version) version; exit 0 ;;
esac

lang_init
case "${1:-}" in
  __prev)      preview "$2"; exit ;;
  __wprev)     preview_wall "$2"; exit ;;
  __sddmprev)  preview_sddm "$2"; exit ;;
  __bprev)     preview_border "$2"; exit ;;
  __brprev)    preview_bright "$2"; exit ;;
  -h|--help|help|ajuda) usage; exit 0 ;;
  -l|--list)   palettes; exit 0 ;;
  -g|--gerar|--generate)  gen_palettes; exit 0 ;;
esac

seed
case "${1:-}" in
  -r|--random) apply "$(palettes | shuf -n1)" ;;
  palette|paleta|theme|tema|colors|cores) need_fzf; pick_palette ;;
  wallpaper|papel)   need_fzf; pick_wallpaper ;;
  appearance|aparencia)   need_fzf; pick_aparencia ;;
  borders|bordas|border|borda)  need_fzf; pick_bordas ;;
  effects|efeitos|blur)      [ -n "${2:-}" ] || need_fzf; pick_efeitos "${2:-}" ;;
  animations|animacoes|anim) [ -n "${2:-}" ] || need_fzf; pick_animacoes "${2:-}" ;;
  bar|barra|waybar)      need_fzf; pick_barra ;;
  style|estilo)      if [ -n "${2:-}" ]; then
                       if bar_style_set "$2" && render; then ok "$(t 'style'): $2"
                       else err "$(t 'invalid style (use flat, pills or segmented)')"; exit 2; fi
                     else need_fzf; pick_estilo; fi ;;
  modules|modulos)   need_fzf; pick_modulos ;;
  windows|janelas|comportamento) need_fzf; pick_janelas ;;
  workspaces|areas|areas-de-trabalho) need_fzf; pick_workspaces ;;
  input|entrada|touchpad) need_fzf; pick_entrada ;;
  cursor|ponteiro)   need_fzf; pick_cursor ;;
  lock|bloqueio|hyprlock) need_fzf; pick_bloqueio ;;
  sddm|login|greeter|tela-de-inicio) need_fzf; pick_sddm ;;
  notifications|notificacoes|notify|dunst) need_fzf; pick_notificacoes ;;
  menu|center|central|centro) center_menu ;;
  network|rede|net) need_fzf; net_module ;;
  system|sistema)   need_fzf; system_menu ;;
  font|fonte)       need_fzf; pick_fonte ;;
  lang|idioma|language) if [ -n "${2:-}" ]; then
                          case "$2" in en|pt) sset lang "$2"; lang_init; ok "$(t 'language'): $2" ;;
                            *) err "$(t 'invalid language (use en or pt)')"; exit 2 ;; esac
                        else need_fzf; pick_lang; fi ;;
  binds|atalhos)    show_binds ;;
  preset|presets)   preset_cmd "${2:-}" ;;
  sync)             sync_global ;;
  config)           show_config ;;
  render)           render && ok "$(t 'reapplied')" ;;
  "")               center_menu ;;
  *) if [ -f "$PAL/$1.env" ]; then apply "$1"
     else err "$(t 'unknown option or palette'): $1"; usage >&2; exit 2; fi ;;
esac
