#!/usr/bin/env bash
# =====================================================================
#  Hyprism  -  one palette, the whole spectrum.
#  A theming command center for Hyprland (Waybar, Hyprlock, Dunst,
#  Kitty and Rofi) driven by a single palette + a central state file.
#
#  no arguments .......... open the visual center (visualconf), or the
#                          built-in menu when visualconf is not installed
#  hyprism <palette> ..... apply a palette directly
#  hyprism palette | wallpaper | appearance | borders | effects | bar | style
#  hyprism modules | windows | workspaces | animations | input | cursor
#  hyprism effects [performance|subtle|glass|focus]
#  hyprism animations [off|fast|balanced|smooth|elastic]
#  hyprism style [flat|pills|segmented]
#  hyprism lock | sddm (login) | notifications | network | system | menu
#  hyprism font | binds | preset | config | render
#  hyprism lang [en|pt] ... switch the interface language
#  hyprism sync .......... reapply the global theme to Kitty and Rofi
#  hyprism -l list  -r random  -g regenerate palettes  -h help  -V version
#  (hyprism -h prints the complete, translated list)
#
#  How it works: every choice becomes a knob in two generated files —
#    ~/.config/hypr/colors.lua  (colors)
#    ~/.config/hypr/look.lua    (numbers and behavior)
#  hyprland.lua reads both. Customizing never rewrites your config.
#
#  Palettes: generated from kitty themes (same source as rofitheme),
#  plus 'sddm-terminal-red', taken from your login theme.
#  Consumers: Hyprland, Waybar, Hyprlock and Dunst.
#
#  Bilingual (English/Portuguese): hyprism lang en|pt
# =====================================================================
set -u
HD="$HOME/.config/hypr"
TD="$HD/themes"
PAL="$TD/palettes"
PRESETS="$TD/presets"
STATE="$TD/.active"
SET="$TD/.state"
COLORS="$HD/colors.lua"
LOOK="$HD/look.lua"
WALLFILE="$HD/wallpaper"
WBAR="$HOME/.config/waybar"
KTD="$HOME/.config/kitty/themes"
# Wallpaper folder: $HYPRISM_WALLDIR, else <XDG Pictures>/wallpaper. An older
# ~/Pictures/wallpaper keeps working when the XDG one does not exist.
if [ -n "${HYPRISM_WALLDIR:-}" ]; then
  WALLDIR="$HYPRISM_WALLDIR"
else
  _pics=$(xdg-user-dir PICTURES 2>/dev/null)
  { [ -z "$_pics" ] || [ "$_pics" = "$HOME" ]; } && _pics="$HOME/Pictures"
  WALLDIR="$_pics/wallpaper"
  [ ! -d "$WALLDIR" ] && [ -d "$HOME/Pictures/wallpaper" ] && WALLDIR="$HOME/Pictures/wallpaper"
  unset _pics
fi
WALLCACHE="$HOME/.cache/hyprism/live-wallpaper"
SELF="$(command -v hyprism 2>/dev/null || command -v hyprtheme 2>/dev/null || printf '%s' "$0")"
# Repo root (bin/..), resolved through the ~/.local/bin symlink.
HYPRISM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)"
THUMBS="$HOME/.cache/hyprism/thumbs"
mkdir -p "$PAL" "$PRESETS" "$WBAR" "$WALLCACHE" "$THUMBS"

have(){ command -v "$1" >/dev/null 2>&1; }

# Shared retro TUI style (lib/ui.sh). fzf runs its preview/bind commands with
# $SHELL; forcing bash keeps the quoting in those strings predictable even when
# the login shell is fish/zsh.
# shellcheck source=../lib/ui.sh
[ -r "$HYPRISM_ROOT/lib/ui.sh" ] && . "$HYPRISM_ROOT/lib/ui.sh"
if declare -F ui_fzf >/dev/null; then
  FZF(){ ui_init; SHELL="$BASH" ui_fzf --border-label=" ${UI_E_BAR} HYPRISM ${UI_E_RST} " "$@"; }
else
  FZF(){ SHELL="$BASH" fzf --height=92% --layout=reverse --border=rounded --info=inline-right --ansi --no-separator \
    --margin=1 --padding=1 --gap=1 --pointer='▸' --marker='✓' --scrollbar='│' \
    --color='bg:-1,bg+:#1b1111,fg:#b8b8b8,fg+:#ffffff,hl:#ff4a4a,hl+:#ff6a6a:bold,pointer:#ff2b2b,prompt:#ff2b2b:bold,marker:#ff6a6a,info:#666666,header:#888888,border:#5a0000,gutter:-1' \
    "$@"; }
fi

# Menu/option variant: lines are "KEY<TAB>LABEL"; only the translated LABEL is
# shown and searched, while the canonical KEY (a menu route or a state value)
# stays hidden and untouched. This keeps every dispatch and every value written
# to .state language-independent while the interface is fully translated.
FZFM(){ FZF --delimiter='\t' --with-nth='2..' "$@"; }
row(){ printf '%s\t%s\n' "$1" "$2"; }
mkey(){ printf '%s' "${1%%$'\t'*}"; }   # canonical KEY from a selected line

# ---------- personality / colored output ----------
# Honors NO_COLOR and only paints when stdout is a terminal.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RST=$'\033[0m'
  C_RED=$'\033[38;5;203m'; C_GRN=$'\033[38;5;114m'; C_YEL=$'\033[38;5;179m'
else
  C_RST=''; C_RED=''; C_GRN=''; C_YEL=''
fi
ok(){   printf '  %s✓%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn(){ printf '  %s!%s %s\n' "$C_YEL" "$C_RST" "$*"; }
err(){  printf '  %s✗%s %s\n' "$C_RED" "$C_RST" "$*" >&2; }

# ---------- i18n (English base, optional Portuguese) ----------
# t 'English source' -> Portuguese when lang=pt and a translation exists,
# otherwise the English source itself (graceful fallback). Command keywords
# and .state values are never translated; only human-readable text is.
LANGX=en
declare -A PT
t(){ if [ "$LANGX" = pt ] && [ -n "${PT[$1]+x}" ]; then printf '%s' "${PT[$1]}"; else printf '%s' "$1"; fi; }
