#!/usr/bin/env bash
# =====================================================================
#  kittytheme  -  Kitty + shell customization center (part of Hyprism)
#  no arguments .......... opens the visual center (Hyprism or the menu)
#  kittytheme menu ....... opens the built-in menu
#  kittytheme <theme> .... applies a theme directly
#  kittytheme profile .... ready-made profiles (colors + prompt at once)
#  kittytheme theme | font | transparency | cursor | window | tabs
#  kittytheme history | alerts | behavior | shell | prompt
#  kittytheme sync ....... follows the active global Hyprland theme
#  kittytheme -l  list themes    -r  random    -h  help
#  Portuguese subcommands keep working (perfil, tema, fonte, ...).
# =====================================================================
set -u
KDIR="$HOME/.config/kitty"
KCONF="$KDIR/kitty.conf"
TD="$KDIR/themes"
PD="$KDIR/prompts"
CUR="$TD/current.conf"
STATE="$TD/.active"
CACHE="$HOME/.cache/kittytheme"
# O proprio arquivo (resolvendo o symlink de ~/.local/bin): as previas do
# fzf chamam exatamente este script, e lib/ e share/ ficam ao lado de bin/.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELFQ=$(printf '%q' "$SELF")
HYPRISM_ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
SHARE="$HYPRISM_ROOT/share"
mkdir -p "$CACHE" "$TD" "$PD"

have(){ command -v "$1" >/dev/null 2>&1; }

# ---------- idioma (segue 'hyprism lang en|pt'; padrao en) ----------
LANGX=$(grep -m1 '^lang=' "$HOME/.config/hypr/themes/.state" 2>/dev/null | cut -d= -f2-)
[ "$LANGX" = pt ] || LANGX=en
t(){ if [ "$LANGX" = pt ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }   # t "english" "português"
tn(){ t "$@"; printf '\n'; }
# tf "fmt en" "fmt pt" args...  (printf com formato traduzido)
tf(){ local f; f=$(t "$1" "$2"); shift 2; # shellcheck disable=SC2059
  printf "$f" "$@"; }

# ---------- estilo do seletor (lib/ui.sh, igual ao resto do Hyprism) ----------
if [ -f "$HYPRISM_ROOT/lib/ui.sh" ]; then
  # shellcheck source=../lib/ui.sh
  . "$HYPRISM_ROOT/lib/ui.sh"
  ui_init
  FZF(){ ui_fzf --with-shell='bash -c' \
      --border-label=" ${UI_E_BAR} HYPRISM ${UI_E_RST} " --input-label=" $(t search buscar) " \
      --footer="$(ui_keys ENTER "$(t open abrir)" ESC "$(t back voltar)")" "$@"; }
else
  # sem lib/ui.sh (script copiado sozinho): fzf simples, mesmo comportamento
  UI_E_BAR='' UI_E_RST='' UI_E_DIM=''
  ui_title(){ printf '[ %s ]\n' "$1"; }
  ui_kv(){ printf '  %-15s %s\n' "$1" "$2"; }
  ui_keys(){ local o=''; while [ $# -ge 2 ]; do o+="$1 $2   "; shift 2; done; printf '%s' "$o"; }
  FZF(){ fzf --height=100% --layout=reverse --ansi --cycle --with-shell='bash -c' "$@"; }
fi
keys_apply(){ ui_keys ENTER "$(t apply aplicar)" ESC "$(t back voltar)"; }

# row KEY LABEL [DETAIL] -> "KEY<TAB>LABEL   DETAIL". O fzf mostra do campo 2
# em diante; a KEY nunca e traduzida e e ela que os menus usam para decidir.
ROW_W=16
row(){
  local n pad=''
  if [ -n "${3:-}" ]; then n=$(( ROW_W - ${#2} )); [ "$n" -lt 2 ] && n=2; printf -v pad '%*s' "$n" ''; fi
  printf '%s\t%s%s%s\n' "$1" "$2" "$pad" "${3:-}"
}
# menu CRUMB HEADER [flags do fzf] < linhas   -> imprime a KEY escolhida
# CRUMB e o local mostrado como caminho de shell: hyprism:/kitty/cursor $
menu(){
  local crumb="$1" header="$2" title sel; shift 2
  title="${crumb##*/}"; [ -n "$crumb" ] || title='kitty + shell'
  sel=$(FZF --delimiter=$'\t' --with-nth=2.. --prompt="hyprism:/kitty${crumb:+/$crumb} \$ " \
        --list-label=" ${title^^} " --header="$header" --header-first "$@") || return 1
  printf '%s' "${sel%%$'\t'*}"
}

# ---------- arquivos que acompanham o Hyprism (instalacao nova) ----------
# Temas e prompts so sao copiados quando a pasta do usuario esta vazia, e
# nunca por cima de um arquivo existente.
themes(){ find "$TD" -maxdepth 1 -name '*.conf' ! -name 'current.conf' -printf '%f\n' 2>/dev/null | sed 's/\.conf$//' | sort; }
prompts(){ find "$PD" -maxdepth 1 -name '*.toml' -printf '%f\n' 2>/dev/null | sed 's/\.toml$//' | sort; }
seed_dir(){ # seed_dir ORIGEM DESTINO EXTENSAO
  local f
  for f in "$1"/*."$3"; do
    [ -e "$f" ] || continue
    [ "${f##*/}" = current.conf ] && continue
    [ -e "$2/${f##*/}" ] || cp "$f" "$2/"
  done
}
[ -z "$(themes)" ]  && seed_dir "$SHARE/kitty/themes"  "$TD" conf
[ -z "$(prompts)" ] && seed_dir "$SHARE/kitty/prompts" "$PD" toml

# aplica cores AO VIVO sem recarregar o kitty (assim nao mexe no tamanho da fonte)
colors_live(){ kitten @ set-colors --all --configured "$CUR" >/dev/null 2>&1; }
# reload de verdade (so quando muda fonte/blur); mantem o tamanho do config
reload(){ pkill -USR1 -x kitty >/dev/null 2>&1; }
kset(){ local k="$1" v="$2"
  if grep -qE "^${k}([[:space:]]|\$)" "$KCONF" 2>/dev/null; then
    sed -i -E "s|^${k}[[:space:]].*|${k} $v|" "$KCONF"
  else printf '%s %s\n' "$k" "$v" >> "$KCONF"; fi
}
kget(){ grep -m1 -E "^$1([[:space:]]|$)" "$KCONF" 2>/dev/null | sed -E "s/^$1[[:space:]]+//"; }
# o kitty.conf precisa incluir o current.conf para o tema valer ao reabrir
ensure_include(){
  grep -qsE '^[[:space:]]*include[[:space:]].*current\.conf' "$KCONF" && return 0
  printf '\n# colors (managed by kittytheme)\ninclude themes/current.conf\n' >> "$KCONF"
}
# set_theme NOME -> copia para current.conf, grava o ativo e pinta ao vivo
set_theme(){
  [ -f "$TD/$1.conf" ] || { tf "  theme '%s' not found (kittytheme -l)\n" "  tema '%s' não encontrado (kittytheme -l)\n" "$1" >&2; return 1; }
  cp -f "$TD/$1.conf" "$CUR"; printf '%s\n' "$1" > "$STATE"
  ensure_include; colors_live
}

# Linhas dos menus de ajuste usam: valor<TAB>nome<TAB>descricao.
# O valor fica oculto, mas volta intacto para ser gravado no kitty.conf.
# r VALOR "name" "description" "nome" "descrição" -> linha no idioma atual
r(){ if [ "$LANGX" = pt ]; then printf '%s\t%s\t%s' "$1" "$4" "$5"; else printf '%s\t%s\t%s' "$1" "$2" "$3"; fi; }
choose_value(){
  local crumb="$1" current="$2" line v n d w=0 pad title; shift 2
  title="${crumb##*/}"
  for line in "$@"; do IFS=$'\t' read -r v n d <<<"$line"; [ "${#n}" -gt "$w" ] && w=${#n}; done
  for line in "$@"; do
    IFS=$'\t' read -r v n d <<<"$line"
    printf -v pad '%*s' $(( w - ${#n} + 3 )) ''
    printf '%s\t%s%s%s\n' "$v" "$n" "$pad" "$d"
  done | FZF --delimiter=$'\t' --with-nth=2.. --prompt="hyprism:/kitty/$crumb \$ " \
           --list-label=" ${title^^} " --header="$(t current atual): ${current:--}" --header-first \
           --footer="$(keys_apply)"
}
selected_value(){ printf '%s' "$1" | cut -f1; }
set_and_reload(){
  local key="$1" value="$2"
  kset "$key" "$value"
  reload
  printf '  %s: %s\n' "$key" "$value"
}
pick_setting(){
  local key="$1" crumb="$2" sel; shift 2
  sel=$(choose_value "$crumb" "$(kget "$key")" "$@") || return 0
  [ -n "${sel:-}" ] && set_and_reload "$key" "$(selected_value "$sel")"
}
back_value(){ r voltar '← Back' 'Return to the Kitty menu' '← Voltar' 'Retornar ao menu do Kitty'; }
fontlist(){ { fc-list : family 2>/dev/null | tr ',' '\n' | sed 's/^ *//;s/ *$//' | grep -iE 'Nerd Font( Mono)?$'; echo "DejaVu Sans Mono"; echo "Adwaita Mono"; } | sort -u; }

# Liga o starship so onde faz sentido: starship instalado, shell instalado e
# linha ainda ausente. Nunca cria ~/.zshrc sem zsh.
enable_starship_shells(){
  have starship || return 0
  local fc="$HOME/.config/fish/config.fish" bc="$HOME/.bashrc" zc="$HOME/.zshrc"
  if have fish && ! grep -qs 'starship init fish' "$fc"; then
    mkdir -p "$(dirname "$fc")"
    printf '\n# prompt (Hyprism)\ntype -q starship; and starship init fish | source\n' >> "$fc"
  fi
  if have bash && ! grep -qs 'starship init bash' "$bc"; then
    # shellcheck disable=SC2016  # o $(...) e para o bash do usuario, nao aqui
    printf '\n# prompt (Hyprism)\ncommand -v starship >/dev/null && eval "$(starship init bash)"\n' >> "$bc"
  fi
  if have zsh && ! grep -qs 'starship init zsh' "$zc"; then
    # shellcheck disable=SC2016
    printf '\n# prompt (Hyprism)\ncommand -v starship >/dev/null && eval "$(starship init zsh)"\n' >> "$zc"
  fi
}
disable_starship_shells(){
  local f
  for f in "$HOME/.config/fish/config.fish:fish" "$HOME/.bashrc:bash" "$HOME/.zshrc:zsh"; do
    [ -f "${f%:*}" ] && sed -i --follow-symlinks "/starship init ${f##*:}/d" "${f%:*}"
  done
  return 0
}

prompt_desc(){ case "$1" in
  red)     t 'flat red with your user name' 'vermelho flat com o seu usuário';;
  box)     t 'two lines with a red frame' 'duas linhas com moldura vermelha';;
  bracket) t 'hacker: [user@host] [dir], two lines' 'hacker: [user@host] [dir], duas linhas';;
  dollar)  t 'classic bash: user@host:dir$' 'clássico bash: user@host:dir$';;
  minimal) t 'one clean line: dir + git + arrow' 'uma linha limpa: dir + git + seta';;
  lean)    t 'ultra minimal, just the green arrow' 'ultra minimal, só a setinha verde';;
  pure)    t 'pastel pure-prompt style, two lines' 'pastel estilo pure prompt, duas linhas';;
  nerd)    t 'flat nerd icons (arch, folder)' 'ícones nerd (arch, pasta) flat';;
  neon)    t 'flat cyberpunk cyan/magenta' 'cyberpunk cyan/magenta flat';;
  matrix)  t 'phosphor green, minimal' 'verde fósforo, minimal';;
  soft)    t 'catppuccin pastel, two lines' 'catppuccin pastel, duas linhas';;
  arrow)   t 'two lines with arrows (tokyo)' 'duas linhas com setinhas (tokyo)';;
  time)    t 'dir + git + time on the right' 'dir + git + hora à direita';;
  gitrich) t 'detailed git with counters' 'git detalhado com contadores';;
  *)       printf '';;
esac; }

# ---------- perfis (cores + opacidade + blur + prompt; NAO mexe na fonte) ----------
# nome -> tema|opacidade|blur|prompt|descricao
profile_def(){ case "$1" in
  terminal-red) echo "terminal-red|0.92|32|red|$(t 'red on black, sharp and serious' 'vermelho sobre preto, sóbrio e marcante')";;
  blackarch)    echo "blackarch|0.90|24|bracket|$(t 'pure black, pentest mood' 'preto absoluto, clima pentest')";;
  tokyo-night)  echo "tokyo-night|0.95|28|arrow|$(t 'modern night blue' 'azul noturno moderno')";;
  catppuccin)   echo "catppuccin-mocha|0.94|32|soft|$(t 'soft dark pastel' 'pastel escuro, suave')";;
  gruvbox)      echo "gruvbox-dark|1.00|0|dollar|$(t 'warm retro, opaque' 'quente retrô, opaco')";;
  nord)         echo "nord|0.96|20|minimal|$(t 'cool and minimal, corporate' 'frio e minimal, corporativo')";;
  matrix)       echo "matrix|0.88|16|matrix|$(t 'phosphor green on black' 'verde fósforo sobre preto')";;
  dracula)      echo "dracula|0.93|24|neon|$(t 'classic purple, high contrast' 'roxo clássico, alto contraste')";;
  foco|focus)   echo "one-dark|1.00|0|lean|$(t 'sober and opaque, full focus' 'sóbrio e opaco, foco total')";;
esac; }
PROFILES="terminal-red blackarch tokyo-night catppuccin gruvbox nord matrix dracula foco"
profile_label(){ case "$1" in foco) t focus foco ;; *) printf '%s' "$1" ;; esac; }

apply_profile(){
  local d; d=$(profile_def "$1"); [ -z "$d" ] && { tf "profile '%s' does not exist\n" "perfil '%s' inexistente\n" "$1"; return 1; }
  local theme op blur prompt desc old_blur
  IFS='|' read -r theme op blur prompt desc <<<"$d"
  old_blur=$(grep -m1 '^background_blur' "$KCONF" 2>/dev/null | awk '{print $2}')
  set_theme "$theme" || return 1
  kset background_opacity "$op"; kset background_blur "$blur"
  kitten @ set-background-opacity --all "$op" >/dev/null 2>&1
  if [ -n "$prompt" ] && [ -f "$PD/$prompt.toml" ] && have starship; then
    cp -f "$PD/$prompt.toml" "$HOME/.config/starship.toml"; enable_starship_shells
  fi
  [ "$blur" != "$old_blur" ] && reload
  tf '  profile applied: %s  (theme %s | opacity %s | blur %s | prompt %s)\n' \
     '  perfil aplicado: %s  (tema %s | opacidade %s | blur %s | prompt %s)\n' "$1" "$theme" "$op" "$blur" "$prompt"
  tn '  reopen the tab/shell to see the new prompt' '  reabra a aba/shell para ver o prompt novo'
}

pick_profile(){
  local prev prev_op p d sel; prev=$(cat "$STATE" 2>/dev/null)
  prev_op=$(grep -m1 '^background_opacity' "$KCONF" 2>/dev/null | awk '{print $2}')
  sel=$(for p in $PROFILES; do d=$(profile_def "$p"); row "$p" "$(profile_label "$p")" "${d##*|}"; done \
      | menu "$(t profiles perfis)" "$(t 'colors and opacity preview live in this terminal' 'cores e opacidade aparecem ao vivo neste terminal')" \
          --preview "$SELFQ __pprev {1}" --preview-window='right,56%,border-sharp' \
          --preview-label=" $(t preview prévia) " --footer="$(keys_apply)")
  if [ -n "${sel:-}" ]; then apply_profile "$sel"
  else
    [ -n "$prev" ] && kitten @ set-colors --all "$TD/$prev.conf" >/dev/null 2>&1
    [ -n "$prev_op" ] && kitten @ set-background-opacity --all "$prev_op" >/dev/null 2>&1
  fi
}

# ---------- tema (so cores, ao vivo, SEM reload) ----------
pick_theme(){
  local prev sel p mark; prev=$(cat "$STATE" 2>/dev/null)
  sel=$(themes | while read -r p; do
          mark=''; [ "$p" = "$prev" ] && mark="  ● $(t active ativo)"
          printf '%s\t%s%s\n' "$p" "$p" "$mark"
        done | menu "$(t theme tema)" "$(t 'the color changes live in the terminal' 'a cor muda ao vivo no terminal')" \
          --preview "$SELFQ __tprev {1}" --preview-window='right,50%,border-sharp' \
          --preview-label=" $(t preview prévia) " --footer="$(keys_apply)")
  if [ -n "${sel:-}" ]; then set_theme "$sel" && tf '  theme: %s\n' '  tema: %s\n' "$sel"
  else [ -n "$prev" ] && kitten @ set-colors --all "$TD/$prev.conf" >/dev/null 2>&1; fi
}

sync_hypr(){
  local h
  h=$(cat "$HOME/.config/hypr/themes/.active" 2>/dev/null)
  [ -n "$h" ] || { tn '  Hyprland has no active global theme' '  o Hyprland não tem tema global ativo'; return 1; }
  [ "$h" = sddm-terminal-red ] && h=terminal-red
  [ -f "$TD/$h.conf" ] || { tf '  the global theme "%s" has no Kitty version\n' '  o tema global "%s" não possui versão Kitty\n' "$h"; return 1; }
  set_theme "$h" || return 1
  tf '  synced with the global Hyprland theme (%s)\n' '  sincronizado com o tema global do Hyprland (%s)\n' "$h"
}

# ---------- transparencia + blur ----------
pick_transparency(){
  local old o val b line; old=$(grep -m1 '^background_opacity' "$KCONF" 2>/dev/null | awk '{print $2}')
  o=$(printf '%b' "$(t '1.00  opaque\n0.95\n0.92  recommended\n0.88\n0.82\n0.75\n0.65' '1.00  opaco\n0.95\n0.92  recomendado\n0.88\n0.82\n0.75\n0.65')" \
      | while IFS= read -r line; do printf '%s\t%s\n' "${line%% *}" "$line"; done \
      | menu "$(t transparency transparência)" "$(t 'changes live' 'muda ao vivo')" \
          --preview "$SELFQ __oprev {1}" --preview-window='right,40%,border-sharp' --footer="$(keys_apply)")
  if [ -z "${o:-}" ]; then
    [ -n "$old" ] && kitten @ set-background-opacity --all "$old" >/dev/null 2>&1
    return
  fi
  val="$o"
  kset background_opacity "$val"; kitten @ set-background-opacity --all "$val" >/dev/null 2>&1
  b=$({ row 48 "$(t strong forte)" 48; row 24 "$(t medium médio)" 24; row 8 "$(t light leve)" 8; row 0 "$(t none nenhum)" 0; } \
      | menu "$(t transparency/blur transparência/blur)" "$(t 'blur behind the window (applies on reload)' 'desfoque atrás da janela (aplica no reload)')" \
          --footer="$(keys_apply)")
  case "${b:-}" in 48|24|8|0) kset background_blur "$b"; reload;; esac
  tf '  opacity %s | blur %s\n' '  opacidade %s | blur %s\n' "$val" "${b:-$(t unchanged inalterado)}"
}

# ---------- fonte: amostra REAL por imagem (nao mexe no terminal ate o ENTER) ----------
font_sheet(){
  local out="$CACHE/fonts.png"; local tmpd; tmpd=$(mktemp -d); local i=0 f
  while read -r fam; do
    [ -z "$fam" ] && continue
    f=$(fc-match -f '%{file}' "$fam" 2>/dev/null)
    magick -size 940x50 xc:'#0d0d0d' -fill '#e0e0e0' -font "$f" -pointsize 20 \
      -gravity West -annotate +14+0 "${fam}      ->  () => != == >=   { abc 123 }   git  ❯" \
      "$tmpd/$(printf '%02d' $i).png" 2>/dev/null
    i=$((i+1))
  done < <(fontlist)
  magick "$tmpd"/*.png -append "$out" 2>/dev/null
  rm -rf "$tmpd"; printf '%s' "$out"
}
pick_font(){
  if have magick && have kitten; then
    local sheet; sheet=$(font_sheet)
    clear; [ -f "$sheet" ] && kitten icat --align left "$sheet" 2>/dev/null; echo
  fi
  local fam size sz
  fam=$(fontlist | sed 's/.*/&\t&/' | menu "$(t font fonte)" "$(t 'look at the sample above' 'veja a amostra acima')" \
      --height=42% --footer="$(keys_apply)")
  [ -z "${fam:-}" ] && return
  kset font_family "$fam"
  size=$(printf '9\n10\n11\n12\n13\n14\n15\n16\n' | sed 's/.*/&\t&/' \
      | menu "$(t font/size fonte/tamanho)" "$(t 'font size (smallest = 9)' 'tamanho da fonte (menor = 9)')" \
          --height=42% --footer="$(keys_apply)")
  [ -n "${size:-}" ] && kset font_size "$size"
  # aplica: reload le a fonte nova; reforca o tamanho pra nunca ficar grande
  reload
  sz=$(grep -m1 '^font_size' "$KCONF" | awk '{print $2}')
  [ -n "$sz" ] && kitten @ set-font-size "$sz" >/dev/null 2>&1
  tf '  font: %s | size %s\n' '  fonte: %s | tamanho %s\n' "$fam" "$sz"
}

# ---------- cursor ----------
pick_cursor(){
  while true; do
    local c key
    c=$(choose_value cursor "$(kget cursor_shape) · $(t blink pisca) $(kget cursor_blink_interval)s" \
      "$(r forma 'Cursor shape' 'Block, vertical bar or underline' 'Forma do cursor' 'Bloco, barra vertical ou sublinhado')" \
      "$(r desfocado 'Unfocused cursor' 'Look when the window is not active' 'Cursor sem foco' 'Aparência quando a janela não está ativa')" \
      "$(r piscar 'Blink speed' 'Off, smooth, fast or system' 'Velocidade do piscar' 'Desligado, suave, rápido ou do sistema')" \
      "$(r parar 'Stop blinking' 'Idle time before it holds still' 'Parar de piscar' 'Tempo de inatividade antes de ficar fixo')" \
      "$(r espessura 'Thickness' 'Adjusts the vertical bar and underline' 'Espessura' 'Ajusta barra vertical e sublinhado')" \
      "$(back_value)") || return 0
    key=$(selected_value "$c")
    case "$key" in
      forma) pick_setting cursor_shape "cursor/$(t shape forma)" \
        "$(r block 'Block' 'Solid cursor, easy to spot' 'Bloco' 'Cursor cheio e fácil de localizar')" \
        "$(r beam 'Vertical bar' 'Light, editor-like look' 'Barra vertical' 'Visual leve, estilo editor')" \
        "$(r underline 'Underline' 'Line under the character' 'Sublinhado' 'Linha abaixo do caractere')" ;;
      desfocado) pick_setting cursor_shape_unfocused "cursor/$(t unfocused sem-foco)" \
        "$(r hollow 'Outline' 'Clearly shows the window lost focus' 'Contorno' 'Mostra claramente que a janela perdeu foco')" \
        "$(r unchanged 'No change' 'Keeps the same shape' 'Sem mudança' 'Mantém a mesma forma')" \
        "$(r block 'Block' 'Solid block even unfocused' 'Bloco' 'Bloco cheio mesmo sem foco')" \
        "$(r beam 'Vertical bar' 'Thin bar even unfocused' 'Barra vertical' 'Barra fina mesmo sem foco')" \
        "$(r underline 'Underline' 'Line under the character' 'Sublinhado' 'Linha abaixo do caractere')" ;;
      piscar) pick_setting cursor_blink_interval "cursor/$(t blink piscar)" \
        "$(r 0 'Off' 'Cursor always visible' 'Desligado' 'Cursor sempre visível')" \
        "$(r 0.7 'Smooth' 'Blinks slowly' 'Suave' 'Pisca devagar')" \
        "$(r 0.5 'Normal' 'Balanced' 'Normal' 'Equilibrado')" \
        "$(r 0.3 'Fast' 'Blinks more often' 'Rápido' 'Pisca com mais frequência')" \
        "$(r -1 'System' 'Follows the desktop default interval' 'Do sistema' 'Segue o intervalo padrão do desktop')" ;;
      parar) pick_setting cursor_stop_blinking_after "cursor/$(t stop parar)" \
        "$(r 0 'Never' 'Keeps blinking forever' 'Nunca' 'Continua piscando sem limite')" \
        "$(r 5 '5 seconds' 'Holds still quickly' '5 segundos' 'Fica fixo rapidamente')" \
        "$(r 15 '15 seconds' 'Comfortable default' '15 segundos' 'Padrão confortável')" \
        "$(r 30 '30 seconds' 'Takes longer to hold still' '30 segundos' 'Demora mais para ficar fixo')" ;;
      espessura)
        local thick
        thick=$(choose_value "cursor/$(t thickness espessura)" \
          "$(t bar barra) $(kget cursor_beam_thickness) · $(t line linha) $(kget cursor_underline_thickness)" \
          "$(r 1.0 'Thin' 'Delicate look' 'Fina' 'Visual delicado')" \
          "$(r 1.5 'Normal' 'Good readability' 'Normal' 'Boa leitura')" \
          "$(r 2.0 'Medium' 'More visible' 'Média' 'Mais evidente')" \
          "$(r 2.5 'Thick' 'Maximum visibility' 'Grossa' 'Máxima visibilidade')") || continue
        [ -z "${thick:-}" ] && continue
        thick=$(selected_value "$thick")
        kset cursor_beam_thickness "$thick"; kset cursor_underline_thickness "$thick"; reload
        ;;
      voltar|"") return 0 ;;
    esac
  done
}

# ---------- janela, tamanho e espacamento ----------
apply_window_preset(){
  local width height
  case "$1" in
    compacta|compact) width=90c;  height=26c ;;
    equilibrada|balanced) width=110c; height=30c ;;
    ampla|large) width=130c; height=36c ;;
    gigante|xlarge|huge) width=150c; height=42c ;;
    *) tf 'invalid window size: %s\n' 'tamanho de janela inválido: %s\n' "$1" >&2; return 1 ;;
  esac
  kset remember_window_size no
  kset initial_window_width "$width"
  kset initial_window_height "$height"
  reload
  tf '  initial window: %s × %s\n' '  janela inicial: %s × %s\n' "$width" "$height"
}

pick_window(){
  while true; do
    local c key
    c=$(choose_value "$(t window janela)" "padding $(kget window_padding_width) · $(kget initial_window_width) × $(kget initial_window_height)" \
      "$(r padding 'Inner spacing' 'Distance between text and edges' 'Espaço interno' 'Distância entre texto e bordas')" \
      "$(r tamanho 'Size on open' 'Presets in columns and lines' 'Tamanho ao abrir' 'Perfis em colunas e linhas')" \
      "$(r lembrar 'Remember last size' 'Ignores the initial size when on' 'Lembrar último tamanho' 'Ignora o tamanho inicial quando ativo')" \
      "$(r distribuicao 'Space distribution' 'Centered or pinned to the corner' 'Distribuição do espaço' 'Centralizado ou preso no canto')" \
      "$(r decoracao 'Native decoration' 'Window title and shadow on Wayland' 'Decoração nativa' 'Título e sombra da janela no Wayland')" \
      "$(back_value)") || return 0
    key=$(selected_value "$c")
    case "$key" in
      padding) pick_setting window_padding_width "$(t window/padding janela/padding)" \
        "$(r 0 'No space' 'Text touching the edges' 'Sem espaço' 'Texto encostado nas bordas')" \
        "$(r 4 'Compact' 'Little space' 'Compacto' 'Pouco espaço')" \
        "$(r 8 'Comfortable' 'Balanced' 'Confortável' 'Equilibrado')" \
        "$(r 12 'Roomy' 'Airy look' 'Amplo' 'Visual arejado')" \
        "$(r 16 'Very roomy' 'More breathing room around the text' 'Muito amplo' 'Mais respiro ao redor do texto')" \
        "$(r 20 'Maximum' 'Panel style' 'Máximo' 'Estilo painel')" ;;
      tamanho)
        local size
        size=$(choose_value "$(t window/size janela/tamanho)" "$(kget initial_window_width) × $(kget initial_window_height)" \
          "$(r compacta 'Compact' '90 columns × 26 lines' 'Compacta' '90 colunas × 26 linhas')" \
          "$(r equilibrada 'Balanced' '110 columns × 30 lines' 'Equilibrada' '110 colunas × 30 linhas')" \
          "$(r ampla 'Large' '130 columns × 36 lines' 'Ampla' '130 colunas × 36 linhas')" \
          "$(r gigante 'Huge' '150 columns × 42 lines' 'Gigante' '150 colunas × 42 linhas')") || continue
        [ -n "${size:-}" ] && apply_window_preset "$(selected_value "$size")"
        ;;
      lembrar) pick_setting remember_window_size "$(t window/remember janela/lembrar)" \
        "$(r yes 'On' 'New windows reuse the last size' 'Ativado' 'Novas janelas repetem o último tamanho usado')" \
        "$(r no 'Off' 'Always uses the initial size preset' 'Desativado' 'Usa sempre o perfil de tamanho inicial')" ;;
      distribuicao) pick_setting placement_strategy "$(t window/placement janela/distribuição)" \
        "$(r center 'Centered' 'Extra space split on all sides' 'Centralizada' 'Espaço extra dividido em todos os lados')" \
        "$(r top-left 'Top-left corner' 'Extra space goes to bottom and right' 'Canto superior esquerdo' 'Espaço extra fica embaixo e à direita')" ;;
      decoracao) pick_setting hide_window_decorations "$(t window/decoration janela/decoração)" \
        "$(r no 'Full' 'Keeps title, borders and shadow' 'Completa' 'Mantém título, bordas e sombra disponíveis')" \
        "$(r titlebar-only 'No title' 'Keeps the shadow to resize on Wayland' 'Sem título' 'Mantém sombra para redimensionar no Wayland')" \
        "$(r yes 'Hidden' 'Removes all decoration drawn by Kitty' 'Oculta' 'Remove toda decoração desenhada pelo Kitty')" ;;
      voltar|"") return 0 ;;
    esac
  done
}

# ---------- abas ----------
pick_tabs(){
  while true; do
    local c key
    c=$(choose_value "$(t tabs abas)" "$(kget tab_bar_style) · $(kget tab_bar_edge) · $(t min mínimo) $(kget tab_bar_min_tabs)" \
      "$(r estilo 'Visual style' 'Powerline, slanted, fade, separator or hidden' 'Estilo visual' 'Powerline, inclinado, fade, separador ou oculto')" \
      "$(r posicao 'Bar position' 'Top, bottom or sides' 'Posição da barra' 'Topo, base ou laterais')" \
      "$(r alinhamento 'Alignment' 'Start, center or end of the bar' 'Alinhamento' 'Início, centro ou fim da barra')" \
      "$(r minimo 'When to show' 'Minimum number of open tabs' 'Quando mostrar' 'Quantidade mínima de abas abertas')" \
      "$(r botao 'New tab button' 'Shows a clickable +' 'Botão de nova aba' 'Exibe um + clicável')" \
      "$(r titulo 'Title format' 'Index, title and activity symbols' 'Formato do título' 'Índice, título e símbolos de atividade')" \
      "$(r powerline 'Powerline separator' 'Slanted, angled or round' 'Separador Powerline' 'Inclinado, angulado ou redondo')" \
      "$(back_value)") || return 0
    key=$(selected_value "$c")
    case "$key" in
      estilo) pick_setting tab_bar_style "$(t tabs/style abas/estilo)" \
        "$(r powerline 'Powerline' 'Continuous strip with separators' 'Powerline' 'Faixa contínua com separadores')" \
        "$(r slant 'Slanted' 'Tabs look like physical index cards' 'Inclinado' 'Abas lembram fichas físicas')" \
        "$(r fade 'Fade' 'Soft gradient edges' 'Fade' 'Bordas suaves em degradê')" \
        "$(r separator 'Separator' 'Simple tabs split by a symbol' 'Separador' 'Abas simples divididas por um símbolo')" \
        "$(r hidden 'Hidden' 'Does not show the tab bar' 'Oculta' 'Não mostra a barra de abas')" ;;
      posicao) pick_setting tab_bar_edge "$(t tabs/position abas/posição)" \
        "$(r top 'Top' 'Bar above the terminal' 'Topo' 'Barra acima do terminal')" \
        "$(r bottom 'Bottom' 'Bar below the terminal' 'Base' 'Barra abaixo do terminal')" \
        "$(r left 'Left' 'Vertical list on the left' 'Esquerda' 'Lista vertical à esquerda')" \
        "$(r right 'Right' 'Vertical list on the right' 'Direita' 'Lista vertical à direita')" ;;
      alinhamento) pick_setting tab_bar_align "$(t tabs/alignment abas/alinhamento)" \
        "$(r start 'Start' 'Aligns at the start of the bar' 'Início' 'Alinha no início da barra')" \
        "$(r center 'Center' 'Centers the tabs' 'Centro' 'Centraliza as abas')" \
        "$(r end 'End' 'Aligns at the end of the bar' 'Fim' 'Alinha no final da barra')" ;;
      minimo) pick_setting tab_bar_min_tabs "$(t tabs/minimum abas/mínimo)" \
        "$(r 1 'Always' 'Shows even with one tab' 'Sempre' 'Mostra inclusive com uma aba')" \
        "$(r 2 'Two tabs' 'Hidden when there is only one' 'Duas abas' 'Oculta quando há somente uma')" \
        "$(r 3 'Three tabs' 'Shows only from the third one' 'Três abas' 'Mostra apenas a partir da terceira')" ;;
      botao) pick_setting tab_bar_show_new_tab_button "$(t tabs/button abas/botão)" \
        "$(r yes 'Show' 'Shows a clickable button for a new tab' 'Mostrar' 'Exibe um botão clicável para nova aba')" \
        "$(r no 'Hide' 'Cleaner look' 'Ocultar' 'Visual mais limpo')" ;;
      titulo) pick_setting tab_title_template "$(t tabs/title abas/título)" \
        "$(r '"{index}: {title}"' 'Index + title' 'Example: 2: editor' 'Índice + título' 'Exemplo: 2: editor')" \
        "$(r '"{sup.index} {title}"' 'Superscript index' 'Discreet index before the title' 'Índice elevado' 'Índice discreto antes do título')" \
        "$(r '"{title}"' 'Title only' 'No tab number' 'Somente título' 'Sem número da aba')" \
        "$(r '"{index}: {bell_symbol}{activity_symbol}{title}"' 'Title + alerts' 'Includes activity and bell' 'Título + alertas' 'Inclui atividade e sino')" ;;
      powerline) pick_setting tab_powerline_style "$(t tabs/powerline abas/powerline)" \
        "$(r slanted 'Slanted' 'Smooth diagonal separator' 'Inclinado' 'Separador diagonal suave')" \
        "$(r angled 'Angled' 'Sharper arrows' 'Angulado' 'Setas mais marcadas')" \
        "$(r round 'Round' 'Rounded separators' 'Redondo' 'Separadores arredondados')" ;;
      voltar|"") return 0 ;;
    esac
  done
}

# ---------- historico, rolagem e mouse ----------
pick_history(){
  while true; do
    local c key
    c=$(choose_value "$(t history histórico)" "$(kget scrollback_lines) $(t lines linhas) · $(t wheel roda) $(kget wheel_scroll_multiplier)x" \
      "$(r linhas 'Scrollback history' 'Balance between memory and reach' 'Histórico de rolagem' 'Equilíbrio entre memória e alcance')" \
      "$(r velocidade 'Wheel speed' 'Amount scrolled per mouse step' 'Velocidade da roda' 'Quantidade rolada por passo do mouse')" \
      "$(r copiar 'Copy on select' 'Primary selection, clipboard or manual' 'Copiar ao selecionar' 'Área primária, clipboard ou manual')" \
      "$(r espacos 'Spaces when copying' 'Removes trailing spaces' 'Espaços ao copiar' 'Remove espaços no final das linhas')" \
      "$(r mouse 'Hide pointer' 'Idle time before hiding' 'Ocultar ponteiro' 'Tempo sem uso antes de esconder')" \
      "$(back_value)") || return 0
    key=$(selected_value "$c")
    case "$key" in
      linhas) pick_setting scrollback_lines "$(t history/lines histórico/linhas)" \
        "$(r 2000 'Light' 'Little memory, short history' 'Leve' 'Pouca memória, histórico curto')" \
        "$(r 10000 'Normal' 'Good for daily use' 'Normal' 'Bom para uso diário')" \
        "$(r 20000 'Large' 'Plenty of history' 'Amplo' 'Bastante histórico')" \
        "$(r 50000 'Very large' 'Good for long logs' 'Muito amplo' 'Bom para logs longos')" \
        "$(r -1 'Infinite' 'May use a lot of memory' 'Infinito' 'Pode consumir bastante memória')" ;;
      velocidade) pick_setting wheel_scroll_multiplier "$(t history/wheel histórico/roda)" \
        "$(r 1.0 'Precise' 'One line per step' 'Precisa' 'Uma linha por passo')" \
        "$(r 3.0 'Smooth' 'Controlled scrolling' 'Suave' 'Rolagem controlada')" \
        "$(r 5.0 'Normal' 'Kitty default' 'Normal' 'Padrão do Kitty')" \
        "$(r 8.0 'Fast' 'Runs through long texts' 'Rápida' 'Percorre textos longos')" ;;
      copiar) pick_setting copy_on_select "$(t history/copy histórico/copiar)" \
        "$(r yes 'Primary selection' 'Paste with the middle button on Linux' 'Seleção primária' 'Cole com o botão do meio no Linux')" \
        "$(r clipboard 'Clipboard' 'Paste normally with Ctrl+Shift+V' 'Clipboard' 'Cole normalmente com Ctrl+Shift+V')" \
        "$(r no 'Manual' 'Only copies with a shortcut' 'Manual' 'Só copia usando um atalho')" ;;
      espacos) pick_setting strip_trailing_spaces "$(t history/spaces histórico/espaços)" \
        "$(r never 'Never remove' 'Copies text exactly' 'Nunca remover' 'Copia o texto exatamente')" \
        "$(r smart 'Smart' 'Removes on normal selection, keeps rectangular' 'Inteligente' 'Remove em seleção normal, preserva retangular')" \
        "$(r always 'Always remove' 'Cleans every copied line' 'Sempre remover' 'Limpa todas as linhas copiadas')" ;;
      mouse) pick_setting mouse_hide_wait "$(t history/mouse histórico/mouse)" \
        "$(r 0 'Never' 'Pointer always visible' 'Nunca' 'Ponteiro sempre visível')" \
        "$(r 1 '1 second' 'Hides quickly' '1 segundo' 'Esconde rapidamente')" \
        "$(r 2 '2 seconds' 'Balanced' '2 segundos' 'Equilibrado')" \
        "$(r 5 '5 seconds' 'Waits longer' '5 segundos' 'Espera mais tempo')" \
        "$(r -1 'On typing' 'Disappears as soon as you type' 'Ao digitar' 'Some imediatamente quando você escreve')" ;;
      voltar|"") return 0 ;;
    esac
  done
}

# ---------- sino e alertas ----------
apply_alert_preset(){
  case "$1" in
    silencioso|silent)
      kset enable_audio_bell no; kset visual_bell_duration 0.0; kset window_alert_on_bell no ;;
    visual)
      kset enable_audio_bell no; kset visual_bell_duration 0.15; kset window_alert_on_bell yes ;;
    audio)
      kset enable_audio_bell yes; kset visual_bell_duration 0.0; kset window_alert_on_bell yes ;;
    completo|both)
      kset enable_audio_bell yes; kset visual_bell_duration 0.15; kset window_alert_on_bell yes ;;
    *) tf 'invalid alert preset: %s\n' 'perfil de alerta inválido: %s\n' "$1" >&2; return 1 ;;
  esac
  reload
  tf '  alerts: %s\n' '  alertas: %s\n' "$1"
}

pick_alerts(){
  local sel
  sel=$(choose_value "$(t alerts alertas)" "audio $(kget enable_audio_bell) · visual $(kget visual_bell_duration)s" \
    "$(r silencioso 'Silent' 'No sound, flash or attention request' 'Silencioso' 'Sem som, flash ou pedido de atenção')" \
    "$(r visual 'Visual only' 'Short flash and window alert' 'Somente visual' 'Flash curto e aviso da janela')" \
    "$(r audio 'Audio only' 'Sound and window alert, no flash' 'Somente áudio' 'Som e aviso da janela, sem flash')" \
    "$(r completo 'Audio + visual' 'Every alert enabled' 'Áudio + visual' 'Todos os avisos habilitados')") || return 0
  [ -n "${sel:-}" ] && apply_alert_preset "$(selected_value "$sel")"
}

# ---------- comportamento do terminal e shell ----------
pick_behavior(){
  while true; do
    local c key
    c=$(choose_value "$(t behavior comportamento)" "$(t integration integração) $(kget shell_integration) · $(t confirm confirmar) $(kget confirm_os_window_close)" \
      "$(r integracao 'Shell integration' 'Prompt, directory and command navigation' 'Integração com o shell' 'Prompt, diretório e navegação de comandos')" \
      "$(r confirmar 'Confirm on close' 'Protects running commands or several open tabs' 'Confirmar ao fechar' 'Protege comandos ou várias abas abertas')" \
      "$(r saida 'Close when the shell exits' 'Controls background processes' 'Fechar ao sair do shell' 'Controla processos em segundo plano')" \
      "$(r links 'Detect links' 'Recognizes URLs under the mouse' 'Detectar links' 'Reconhece URLs sob o mouse')" \
      "$(r foco 'Focus follows mouse' 'Switches the active pane when moving the pointer' 'Foco segue o mouse' 'Troca o painel ativo ao mover o ponteiro')" \
      "$(back_value)") || return 0
    key=$(selected_value "$c")
    case "$key" in
      integracao) pick_setting shell_integration "$(t behavior/integration comportamento/integração)" \
        "$(r enabled 'Full' 'Prompt, title, directory and navigation integrated' 'Completa' 'Prompt, título, diretório e navegação integrados')" \
        "$(r no-cursor 'Leave the cursor alone' 'Keeps features, respects the shape chosen here' 'Sem alterar cursor' 'Mantém recursos, respeita a forma escolhida aqui')" \
        "$(r no-title 'Leave the title alone' 'Keeps the title set by programs' 'Sem alterar título' 'Mantém o título definido pelos programas')" \
        "$(r 'no-cursor no-title' 'Cursor and title free' 'Turns off only those two' 'Cursor e título livres' 'Desliga somente essas duas interferências')" \
        "$(r disabled 'Disabled' 'Shell works without Kitty extras' 'Desativada' 'Shell funciona sem recursos extras do Kitty')" ;;
      confirmar) pick_setting confirm_os_window_close "$(t behavior/confirm comportamento/confirmar)" \
        "$(r 0 'Never' 'Closes without asking' 'Nunca' 'Fecha sem perguntar')" \
        "$(r -1 'During commands' 'Asks if a command is running' 'Durante comandos' 'Pergunta se houver um comando em execução')" \
        "$(r 1 'Always' 'Asks even at an empty prompt' 'Sempre' 'Pergunta mesmo no prompt vazio')" \
        "$(r 2 'Several windows' 'Asks when the tab has two or more windows' 'Várias janelas' 'Pergunta quando a aba tiver duas ou mais janelas')" ;;
      saida) pick_setting close_on_child_death "$(t behavior/exit comportamento/saída)" \
        "$(r no 'Wait for processes' 'Keeps the window if something is still writing' 'Aguardar processos' 'Mantém a janela se algo ainda estiver escrevendo')" \
        "$(r yes 'Close immediately' 'Closes as soon as the shell ends' 'Fechar imediatamente' 'Fecha assim que o shell terminar')" ;;
      links) pick_setting detect_urls "$(t behavior/links comportamento/links)" \
        "$(r yes 'On' 'URLs become clickable' 'Ativado' 'URLs ficam clicáveis e podem ser abertas')" \
        "$(r no 'Off' 'Treats URLs as plain text' 'Desativado' 'Trata URLs como texto comum')" ;;
      foco) pick_setting focus_follows_mouse "$(t behavior/focus comportamento/foco)" \
        "$(r yes 'On' 'The pane under the pointer gets focus' 'Ativado' 'Painel sob o ponteiro recebe foco')" \
        "$(r no 'Off' 'Focus changes only by click or keyboard' 'Desativado' 'Foco muda apenas por clique ou teclado')" ;;
      voltar|"") return 0 ;;
    esac
  done
}

# ---------- shell ----------
pick_shell(){
  local sel s p
  sel=$(for s in fish bash zsh nu elvish xonsh; do p=$(command -v "$s" 2>/dev/null); [ -n "$p" ] && ROW_W=10 row "$s" "$s" "$p"; done \
      | menu shell "$(t "Kitty's default shell" 'shell padrão do kitty')" \
          --preview "$SELFQ __shprev {1}" --preview-window='right,45%,border-sharp' --footer="$(keys_apply)")
  [ -z "${sel:-}" ] && return
  kset shell "$(command -v "$sel")"; tf '  shell: %s  (open a new tab to use it)\n' '  shell: %s  (abra uma aba nova para usar)\n' "$sel"
}

# ---------- prompt: 14 configs proprias, previa REAL renderizada ----------
pick_prompt(){
  if ! have starship; then tn '  starship is not installed:  sudo pacman -S starship' '  starship não instalado:  sudo pacman -S starship'; return; fi
  local sel p
  sel=$( { row padrao   "$(t default padrão)"   "$(t "back to starship's default prompt" 'voltar ao prompt padrão do starship')"
           row desligar "$(t off desligar)"     "$(t 'plain shell prompt (no starship)' 'prompt simples do shell (sem starship)')"
           prompts | while read -r p; do row "$p" "$p" "$(prompt_desc "$p")"; done; } \
        | menu prompt "$(t 'REAL prompt preview on the side' 'prévia REAL do prompt ao lado')" \
            --preview "$SELFQ __sprev {1}" --preview-window='right,58%,border-sharp' \
            --preview-label=" $(t preview prévia) " --footer="$(keys_apply)")
  [ -z "${sel:-}" ] && return
  case "$sel" in
    padrao)   rm -f "$HOME/.config/starship.toml"; enable_starship_shells
              tn '  starship default (reopen the shell)' '  starship padrão (reabra o shell)';;
    desligar) disable_starship_shells
              tn '  starship turned off (reopen the shell)' '  starship desligado (reabra o shell)';;
    *)        cp -f "$PD/$sel.toml" "$HOME/.config/starship.toml"; enable_starship_shells
              tf '  prompt applied: %s  (reopen the shell or tab to see it)\n' '  prompt aplicado: %s  (reabra o shell ou a aba para ver)\n' "$sel";;
  esac
}

show_help(){
  if [ "$LANGX" = pt ]; then printf '%s\n' \
    'kittytheme — personalização do Kitty + shell (Hyprism)' \
    '' \
    '  kittytheme                      abre a central visual (Hyprism, ou o menu próprio)' \
    '  kittytheme menu                 abre o menu próprio' \
    '  kittytheme <tema>               aplica um tema direto' \
    '  kittytheme perfil [nome]        perfis de cores + prompt' \
    '  kittytheme tema                 temas de cores' \
    '  kittytheme transparencia        opacidade e blur' \
    '  kittytheme fonte                família e tamanho' \
    '  kittytheme cursor [forma]       forma, piscar e espessura' \
    '  kittytheme janela [perfil]      tamanho, padding e decoração' \
    '  kittytheme padding [0-100]      espaço interno' \
    '  kittytheme abas [estilo]        barra e títulos das abas' \
    '  kittytheme historico [linhas]   rolagem, mouse e cópia' \
    '  kittytheme alertas [perfil]     áudio, flash e atenção' \
    '  kittytheme comportamento        shell, fechamento e links' \
    '  kittytheme shell | prompt       shell e Starship' \
    '  kittytheme sync | status        seguir o Hyprland · mostrar o estado' \
    '  kittytheme -l | -r              listar ou tema aleatório' \
    '' \
    'Os subcomandos em inglês também funcionam (profile, theme, font, window,' \
    'tabs, history, alerts, behavior).'
  else printf '%s\n' \
    'kittytheme — Kitty + shell customization (Hyprism)' \
    '' \
    '  kittytheme                      open the visual center (Hyprism, or the built-in menu)' \
    '  kittytheme menu                 open the built-in menu' \
    '  kittytheme <theme>              apply a theme directly' \
    '  kittytheme profile [name]       color + prompt profiles' \
    '  kittytheme theme                color themes' \
    '  kittytheme transparency         opacity and blur' \
    '  kittytheme font                 family and size' \
    '  kittytheme cursor [shape]       shape, blinking and thickness' \
    '  kittytheme window [preset]      size, padding and decoration' \
    '  kittytheme padding [0-100]      inner spacing' \
    '  kittytheme tabs [style]         tab bar and titles' \
    '  kittytheme history [lines]      scrollback, mouse and copy' \
    '  kittytheme alerts [preset]      audio, flash and attention' \
    '  kittytheme behavior             shell, closing and links' \
    '  kittytheme shell | prompt       shell and Starship' \
    '  kittytheme sync | status        follow Hyprland · print the state' \
    '  kittytheme -l | -r              list or random theme' \
    '' \
    'Portuguese subcommands work too (perfil, tema, fonte, janela, abas,' \
    'historico, alertas, comportamento).'
  fi
}

# nome do prompt ativo: o arquivo de ~/.config/kitty/prompts igual ao starship.toml
active_prompt(){
  local st="$HOME/.config/starship.toml" p
  [ -f "$st" ] || { t 'default/off' 'padrão/desligado'; return; }
  for p in $(prompts); do cmp -s "$st" "$PD/$p.toml" && { printf '%s' "$p"; return; }; done
  t custom personalizado
}

# show_config [pause|plain|preview] — estado atual em "rotulo .... valor"
show_config(){
  local mode="${1:-pause}"
  if [ "$mode" = plain ] && [ ! -t 1 ]; then
    # shellcheck disable=SC2034  # lidas por ui_title/ui_kv (lib/ui.sh)
    UI_E_BAR='' UI_E_RST='' UI_E_DIM='' UI_E_FG='' UI_E_RULE=''
  fi
  [ "$mode" = preview ] || echo
  ui_title 'KITTY + SHELL'
  ui_kv "$(t theme tema)"            "$(cat "$STATE" 2>/dev/null || echo '-')"
  ui_kv "$(t font fonte)"            "$(kget font_family) · $(kget font_size)pt"
  ui_kv "$(t background fundo)"      "$(t opacity opacidade) $(kget background_opacity) · blur $(kget background_blur)"
  ui_kv cursor                       "$(kget cursor_shape) · $(t blink pisca) $(kget cursor_blink_interval)s"
  ui_kv "$(t window janela)"         "$(kget initial_window_width) × $(kget initial_window_height) · padding $(kget window_padding_width)"
  ui_kv "$(t tabs abas)"             "$(kget tab_bar_style) · $(kget tab_bar_edge) · $(t min mínimo) $(kget tab_bar_min_tabs)"
  ui_kv "$(t history histórico)"     "$(kget scrollback_lines) $(t lines linhas) · $(t wheel roda) $(kget wheel_scroll_multiplier)x"
  ui_kv "$(t alerts alertas)"        "audio $(kget enable_audio_bell) · visual $(kget visual_bell_duration)s"
  ui_kv shell                        "$(kget shell) · $(t integration integração) $(kget shell_integration)"
  ui_kv prompt                       "$(active_prompt)"
  if [ "$mode" = pause ]; then echo; read -rp "  [enter] " _; fi
}

# "theme x   font y   language EN" — o que esta ativo, acima da lista
chips(){
  printf '%s%s%s %s   %s%s%s %s   %s%s%s %s' \
    "$UI_E_DIM" "$(t theme tema)" "$UI_E_RST" "$(cat "$STATE" 2>/dev/null || echo '-')" \
    "$UI_E_DIM" "$(t font fonte)" "$UI_E_RST" "$(kget font_family) $(kget font_size)" \
    "$UI_E_DIM" "$(t language idioma)" "$UI_E_RST" "${LANGX^^}"
}

# ---------- menu principal ----------
main_menu(){
  if ! have fzf; then tn 'install fzf for the menu, or use: kittytheme <theme>' 'instale o fzf para o menu, ou use: kittytheme <tema>'; themes; return; fi
  while true; do
    local c nt np
    nt=$(themes | wc -l); np=$(prompts | wc -l)
    c=$({
      row perfis        "$(t profiles perfis)"               "$(t 'complete ready-made look (colors + prompt)' 'visual completo pronto (cores + prompt)')"
      row tema          "$(t theme tema)"                    "$(tf 'colors only (%s themes)' 'somente as cores (%s temas)' "$nt")"
      row transparencia "$(t transparency transparência)"    "$(t 'window opacity and blur' 'opacidade e desfoque da janela')"
      row fonte         "$(t font fonte)"                    "$(t 'family and size, with a visual sample' 'família e tamanho, com amostra visual')"
      row cursor        cursor                               "$(t 'shape, blinking and thickness' 'forma, piscar e espessura')"
      row janela        "$(t window janela)"                 "$(t 'padding, initial size and decoration' 'padding, tamanho inicial e decoração')"
      row abas          "$(t tabs abas)"                     "$(t 'style, position, title and + button' 'estilo, posição, título e botão +')"
      row historico     "$(t history histórico)"             "$(t 'scrollback, mouse and copy on select' 'rolagem, mouse e cópia ao selecionar')"
      row alertas       "$(t alerts alertas)"                "$(t 'audio bell, flash and window alert' 'sino sonoro, flash e aviso da janela')"
      row comportamento "$(t behavior comportamento)"        "$(t 'integration, closing, links and focus' 'integração, fechamento, links e foco')"
      row shell         shell                                "$(t 'fish, bash or zsh' 'fish, bash ou zsh')"
      row prompt        prompt                               "$(tf '%s built-in prompts (real preview)' '%s prompts próprios (prévia real)' "$np")"
      row sync          sync                                 "$(t 'follow the global Hyprland theme' 'seguir o tema global do Hyprland')"
      row config        config                               "$(t 'show the current configuration' 'ver a configuração atual')"
      row sair          "$(t quit sair)"
    } | menu '' "$(chips)" \
          --preview "$SELFQ __status" --preview-window='right,45%,border-sharp,wrap' \
          --preview-label=" $(t state estado) ")
    case "$c" in
      perfis) pick_profile ;;
      tema) pick_theme ;;
      transparencia) pick_transparency ;;
      fonte) pick_font ;;
      cursor) pick_cursor ;;
      janela) pick_window ;;
      abas) pick_tabs ;;
      historico) pick_history ;;
      alertas) pick_alerts ;;
      comportamento) pick_behavior ;;
      shell) pick_shell ;;
      prompt) pick_prompt ;;
      sync) sync_hypr ;;
      config) show_config ;;
      sair|"") break ;;
    esac
  done
}

# ---------- CLI + subcomandos de previa (uso interno do fzf) ----------
case "${1:-}" in
  __pprev)  # previa de perfil: cores/opacidade ao vivo + detalhes
    d=$(profile_def "${2:-}"); IFS='|' read -r theme op blur prompt desc <<<"$d"
    [ -n "$d" ] || exit 0
    kitten @ set-colors -a "$TD/$theme.conf"    >/dev/null 2>&1
    kitten @ set-background-opacity --all "$op"  >/dev/null 2>&1
    ui_title "$(profile_label "$2")"
    printf '  %s\n\n' "$desc"
    ui_kv "$(t theme tema)" "$theme"
    ui_kv "$(t opacity opacidade)" "$op"
    ui_kv blur "$blur"
    ui_kv prompt "$prompt"
    printf '\n'
    sed -n '2,12p' "$TD/$theme.conf" 2>/dev/null
    ;;
  __tprev)  # previa de tema: cores ao vivo + o arquivo
    [ -f "$TD/${2:-}.conf" ] || exit 0
    kitten @ set-colors -a "$TD/$2.conf" >/dev/null 2>&1
    ui_title "$2"; printf '\n'
    sed -n '1,22p' "$TD/$2.conf"
    ;;
  __oprev)  # previa de opacidade, ao vivo
    kitten @ set-background-opacity --all "${2:-1}" >/dev/null 2>&1
    ui_title "$(t opacity opacidade)"
    ui_kv "$(t live 'ao vivo')" "${2:-}"
    ;;
  __shprev) # previa de shell: versao + aviso
    ui_title "${2:-}"
    "${2:-true}" --version 2>/dev/null | head -1
    printf '\n%s\n' "$(t 'applies to NEW Kitty tabs and windows' 'vale nas abas e janelas NOVAS do kitty')"
    ;;
  __sprev)  # previa de prompt: renderiza o prompt DE VERDADE (isolado)
    f="$PD/${2:-}.toml"
    case "${2:-}" in
      padrao)   ui_title "prompt: $(t default padrão)"
                tn "  starship's own default prompt" '  o prompt padrão do próprio starship' ;;
      desligar) ui_title "prompt: $(t off desligar)"
                tn '  plain shell prompt, starship is removed from the shell rc files' '  prompt simples do shell; o starship sai dos arquivos rc do shell' ;;
      *)        ui_title "prompt: ${2:-}"
                printf '  %s\n\n%s\n\n' "$(prompt_desc "${2:-}")" "$(t 'this is how it will look:' 'assim vai ficar:')"
                if [ -f "$f" ]; then
                  env -i HOME="$HOME" PATH="$PATH" TERM=xterm-kitty STARSHIP_CONFIG="$f" starship prompt 2>/dev/null
                  printf '\n\n--- %s.toml ---\n' "$2"
                  grep -vE '^\s*("\$schema"|command_timeout|add_newline)' "$f" | sed -n '1,22p'
                fi ;;
    esac
    ;;
  __status) show_config preview ;;
  -l|--list) themes ;;
  -r|--random) rt=$(themes | shuf -n1); set_theme "$rt" && tf 'theme: %s\n' 'tema: %s\n' "$rt" ;;
  -h|--help|help|ajuda) show_help ;;
  menu) main_menu ;;
  perfil|perfis|profile|profiles) if [ -n "${2:-}" ]; then apply_profile "$2"; else pick_profile; fi ;;
  tema|theme|cores|colors) pick_theme ;;
  transp*|blur|opacidade|opacity) pick_transparency ;;
  fonte|font) pick_font ;;
  cursor)
    case "${2:-}" in
      "") pick_cursor ;;
      block|beam|underline) set_and_reload cursor_shape "$2" ;;
      *) tf 'invalid cursor shape: %s (use block, beam or underline)\n' 'forma de cursor inválida: %s (use block, beam ou underline)\n' "$2" >&2; exit 2 ;;
    esac
    ;;
  janela|window)
    case "${2:-}" in
      "") pick_window ;;
      compacta|compact|equilibrada|balanced|ampla|large|gigante|xlarge|huge) apply_window_preset "$2" ;;
      *) tf 'invalid window preset: %s\n' 'perfil de janela inválido: %s\n' "$2" >&2; exit 2 ;;
    esac
    ;;
  padding)
    if [ -z "${2:-}" ]; then pick_window
    elif [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -le 100 ]; then set_and_reload window_padding_width "$2"
    else tn 'invalid padding: use a number between 0 and 100' 'padding inválido: use um número entre 0 e 100' >&2; exit 2; fi
    ;;
  abas|tabs)
    case "${2:-}" in
      "") pick_tabs ;;
      fade|slant|separator|powerline|hidden) set_and_reload tab_bar_style "$2" ;;
      *) tf 'invalid tab style: %s\n' 'estilo de abas inválido: %s\n' "$2" >&2; exit 2 ;;
    esac
    ;;
  historico|history|scroll)
    if [ -z "${2:-}" ]; then pick_history
    elif [[ "$2" =~ ^(-1|[0-9]+)$ ]]; then set_and_reload scrollback_lines "$2"
    else tn 'invalid history: use a number of lines or -1' 'histórico inválido: use uma quantidade de linhas ou -1' >&2; exit 2; fi
    ;;
  alertas|alerta|alerts|alert|bell)
    case "${2:-}" in
      "") pick_alerts ;;
      silencioso|silent|visual|audio|completo|both) apply_alert_preset "$2" ;;
      *) tn 'invalid alert: use silent, visual, audio or both' 'alerta inválido: use silencioso, visual, audio ou completo' >&2; exit 2 ;;
    esac
    ;;
  comportamento|behavior|behaviour) pick_behavior ;;
  shell) pick_shell ;;
  prompt) pick_prompt ;;
  sync) sync_hypr ;;
  status) show_config plain ;;
  config) show_config ;;
  "" ) if have visualconf; then exec visualconf kitty; else main_menu; fi ;;
  * ) if [ -f "$TD/$1.conf" ]; then set_theme "$1" && tf 'theme: %s\n' 'tema: %s\n' "$1"
      else tf "invalid option or theme '%s'\n" "opção ou tema '%s' inválido\n" "$1"; main_menu; fi ;;
esac
