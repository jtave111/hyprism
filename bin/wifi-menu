#!/usr/bin/env bash
# =====================================================================
#  wifi-menu — Wi-Fi manager on rofi, using nmcli (part of Hyprism).
#
#  One list shows which network is connected, which ones are saved,
#  signal strength and whether each one is protected. It replaces
#  nm-connection-editor, which makes none of that obvious.
#
#  Two decisions that avoid bugs:
#   - icons as \uXXXX escapes, not pasted as literal characters
#     (literals get lost by some editors/file writes);
#   - rofi returns the choice as an INDEX (-format i), never as text.
#     So the SSID never has to be parsed back out of the displayed line
#     (that would break with names containing %, double spaces or
#     symbols), and translated labels never drive the logic.
#
#  Language follows Hyprism ('hyprism lang en|pt', default en).
#  Load without running, for tests:  WIFI_MENU_LIB=1 source wifi-menu
# =====================================================================
set -u

have(){ command -v "$1" >/dev/null 2>&1; }

# ---------- idioma ----------
LANGX=$(grep -m1 '^lang=' "$HOME/.config/hypr/themes/.state" 2>/dev/null | cut -d= -f2-)
[ "$LANGX" = pt ] || LANGX=en
t(){ if [ "$LANGX" = pt ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }   # t "english" "português"

# ---------- tema ----------
# Tema proprio: janela mais larga (SSID + sinal + cadeado) e campo de senha
# estilizado. Ele herda a paleta ATIVA do launcher (themes/current.rasi do
# rofitheme), entao seguir o tema do sistema e automatico.
ROFI_TEMA="$HOME/.config/rofi/wifi.rasi"
ROFI_CUR="$HOME/.config/rofi/themes/current.rasi"
HYPRISM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ROFI_ARGS=()

# Instalacao nova: copia o wifi.rasi do Hyprism se o usuario nao tem um.
# Se ainda faltar (ou faltar a paleta que ele importa), usa o tema padrao do rofi.
setup_theme(){
  if [ ! -e "$ROFI_TEMA" ] && [ -f "$HYPRISM_ROOT/share/rofi/wifi.rasi" ]; then
    mkdir -p "$(dirname "$ROFI_TEMA")" && cp "$HYPRISM_ROOT/share/rofi/wifi.rasi" "$ROFI_TEMA"
  fi
  ROFI_ARGS=()
  if [ -f "$ROFI_TEMA" ] && { [ -f "$ROFI_CUR" ] || ! grep -q 'themes/current.rasi' "$ROFI_TEMA"; }; then
    ROFI_ARGS=(-theme "$ROFI_TEMA")
  fi
}

# ROFI "texto de dica" argumentos-do-rofi...  (a dica segue o idioma)
ROFI(){
  local hint="$1"; shift
  rofi "${ROFI_ARGS[@]}" -theme-str "entry { placeholder: \"$hint\"; }" "$@"
}

ICON_OK=$'\uf00c'     # conectada
ICON_SAVE=$'\uf0c7'   # salva
ICON_LOCK=$'\uf023'   # protegida
ICON_OPEN=$'\uf09c'   # aberta
ICON_SCAN=$'\uf021'   # procurar
ICON_CFG=$'\uf013'    # avancado
ICON_OFF=$'\uf00d'    # desconectar / esquecer

notify(){ have notify-send && notify-send -a "Wi-Fi" "$1" "${2:-}"; }

bars(){
  local s="${1:-0}"
  if   [ "$s" -ge 75 ] 2>/dev/null; then printf '▂▄▆█'
  elif [ "$s" -ge 50 ] 2>/dev/null; then printf '▂▄▆░'
  elif [ "$s" -ge 25 ] 2>/dev/null; then printf '▂▄░░'
  else                                    printf '▂░░░'; fi
}

# Preenche dois arrays paralelos: SSIDS[] e LINHAS[] (o que aparece no menu).
SSIDS=(); LINHAS=(); ATIVAS=()

carregar(){
  SSIDS=(); LINHAS=(); ATIVAS=()
  local salvas; salvas=$(nmcli -t -f NAME connection show 2>/dev/null)

  # Dedup por SSID mantendo o sinal mais forte: a mesma rede aparece
  # varias vezes (2.4GHz, 5GHz, repetidor).
  while IFS=$'\t' read -r act ssid sig sec; do
    [ -z "$ssid" ] && continue
    local mark icon
    if   [ "$act" = "yes" ]; then mark="$ICON_OK  "
    elif printf '%s\n' "$salvas" | grep -qxF "$ssid"; then mark="$ICON_SAVE  "
    else mark="   "; fi
    if [ -z "$sec" ] || [ "$sec" = "--" ]; then icon="$ICON_OPEN"; else icon="$ICON_LOCK"; fi

    SSIDS+=("$ssid")
    ATIVAS+=("$act")
    LINHAS+=("$(printf '%s%s  %s  %s  %s%%' "$mark" "$(bars "$sig")" "$icon" "$ssid" "$sig")")
  done < <(
    nmcli -t -f ACTIVE,SSID,SIGNAL,SECURITY device wifi list --rescan no 2>/dev/null \
    | awk -F: 'NF>=4 && $2 != "" {
          ssid=$2; sig=$3+0
          if (!(ssid in best) || sig > best[ssid]) {
              best[ssid]=sig; act[ssid]=$1; sec[ssid]=$4
          }
          if ($1 == "yes") act[ssid]="yes"
        }
        END { for (s in best) printf "%s\t%s\t%s\t%s\n", act[s], s, best[s], sec[s] }' \
    | sort -t$'\t' -k3 -rn
  )
}

conectar(){
  local ssid="$1" salvas senha
  salvas=$(nmcli -t -f NAME connection show 2>/dev/null)

  if printf '%s\n' "$salvas" | grep -qxF "$ssid"; then
    if nmcli connection up id "$ssid" >/dev/null 2>&1; then
      notify "$(t Connected Conectado)" "$ssid"
    else
      notify "$(t 'Could not connect' 'Não conectou')" "$(t "$ssid is saved, but the connection failed" "$ssid está salva, mas a conexão falhou")"
    fi
    return
  fi

  senha=$(ROFI "$(t password senha)" -dmenu -password -p "$(t "password for $ssid" "senha de $ssid")" </dev/null)
  [ -z "${senha:-}" ] && return 0

  if nmcli device wifi connect "$ssid" password "$senha" >/dev/null 2>&1; then
    notify "$(t Connected Conectado)" "$ssid"
  else
    notify "$(t 'Could not connect' 'Não conectou')" "$(t 'Wrong password or out of range' 'Senha incorreta ou fora de alcance')"
  fi
}

# Acoes de uma rede. Os rotulos sao traduzidos; a decisao usa keys[indice].
acoes(){
  local ssid="$1" ativa="$2" i
  local -a keys itens
  if [ "$ativa" = "yes" ]; then
    keys=(desconectar esquecer voltar)
    itens=("$ICON_OFF  $(t disconnect desconectar)" "$ICON_OFF  $(t 'forget this network' 'esquecer esta rede')" "$(t back voltar)")
  else
    keys=(conectar esquecer voltar)
    itens=("$(t connect conectar)" "$ICON_OFF  $(t 'forget this network' 'esquecer esta rede')" "$(t back voltar)")
  fi

  i=$(printf '%s\n' "${itens[@]}" | ROFI "$(t filter filtrar)" -dmenu -i -no-custom -format i -p "$ssid")
  [[ "${i:-}" =~ ^[0-9]+$ ]] || return 0

  case "${keys[$i]:-}" in
    desconectar) nmcli connection down id "$ssid"   >/dev/null 2>&1 && notify "$(t Disconnected Desconectado)" "$ssid" ;;
    esquecer)    nmcli connection delete id "$ssid" >/dev/null 2>&1 && notify "$(t 'Network forgotten' 'Rede esquecida')" "$ssid" ;;
    conectar)    conectar "$ssid" ;;
  esac
}

main(){
  local msg
  if ! have nmcli; then
    msg=$(t 'nmcli not found: install NetworkManager (sudo pacman -S networkmanager) and enable NetworkManager.service' \
            'nmcli não encontrado: instale o NetworkManager (sudo pacman -S networkmanager) e ative o NetworkManager.service')
    printf 'wifi-menu: %s\n' "$msg" >&2; notify "Wi-Fi" "$msg"; exit 1
  fi
  if ! have rofi; then
    msg=$(t 'rofi not found: install it with sudo pacman -S rofi' 'rofi não encontrado: instale com sudo pacman -S rofi')
    printf 'wifi-menu: %s\n' "$msg" >&2; notify "Wi-Fi" "$msg"; exit 1
  fi
  setup_theme
  carregar

  local -a menu
  menu=("${LINHAS[@]}" "$ICON_SCAN  $(t 'scan for networks' 'procurar redes')" "$ICON_CFG  $(t 'advanced settings (nmtui)' 'ajustes avançados (nmtui)')")

  local i
  i=$(printf '%s\n' "${menu[@]}" | ROFI "$(t 'filter networks' 'filtrar redes')" -dmenu -i -no-custom -format i -p "wi-fi")
  [[ "${i:-}" =~ ^[0-9]+$ ]] || exit 0

  local n=${#SSIDS[@]}
  if   [ "$i" -eq "$n" ]; then
    nmcli device wifi rescan >/dev/null 2>&1
    sleep 2
    exec "$0"
  elif [ "$i" -eq $(( n + 1 )) ]; then
    # terminal do usuario ($TERMINAL), kitty como padrao do Hyprism
    setsid "${TERMINAL:-kitty}" -e nmtui >/dev/null 2>&1 < /dev/null &
    exit 0
  fi

  local ssid="${SSIDS[$i]}" ativa="${ATIVAS[$i]}"
  if [ "$ativa" = "yes" ]; then
    acoes "$ssid" yes
  else
    conectar "$ssid"
  fi
}

[ -n "${WIFI_MENU_LIB:-}" ] || main "$@"
