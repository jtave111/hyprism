  ['ignorado (não instalado ou sem esta paleta)']='skipped (not installed or no such palette)'
)

# Follows Hyprism's language ('hyprism lang en|pt'). Portuguese is the source.
LANGX=$(grep -m1 '^lang=' "$HYPR_STATE" 2>/dev/null | cut -d= -f2-)
[ "$LANGX" = pt ] || LANGX=en
tr_(){ if [ "$LANGX" = en ] && [ -n "${EN[$1]+x}" ]; then printf '%s' "${EN[$1]}"; else printf '%s' "$1"; fi; }

have(){ command -v "$1" >/dev/null 2>&1; }
value(){ grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2-; }
active(){ cat "$1" 2>/dev/null || printf '-'; }
pretty(){ [ -n "${1:-}" ] && [ "$1" != auto ] && printf '%s' "$1" || tr_ 'automático'; }

# Shared retro console style (lib/ui.sh). The repo keeps bin/ and lib/ side
# by side; ~/.local/bin holds symlinks, so resolve the real path first.
HYPRISM_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/ui.sh
. "$HYPRISM_ROOT/lib/ui.sh"
ui_init

fzf_ui(){ ui_fzf "$@"; }

# "palette blackarch · bar pills · lang EN" — what is active, above the list
chips(){
  ui_init
  printf '%s%s%s %s   %s%s%s %s   %s%s%s %s' \
    "$UI_E_DIM" "$(tr_ 'paleta')" "$UI_E_RST" "$(active "$HYPR_ACTIVE")" \
    "$UI_E_DIM" "$(tr_ 'barra')" "$UI_E_RST" "$(value "$HYPR_STATE" bar_style)" \
    "$UI_E_DIM" "$(tr_ 'idioma')" "$UI_E_RST" "${LANGX^^}"
}

# pick TITLE CRUMB PREVIEW ITEM...   items are "KEY<TAB>LABEL<TAB>DESCRIPTION"
# CRUMB is the location shown as a shell path in the prompt (hyprism:/rofi $).
pick(){
  local title crumb preview it k l d path
  title=$(tr_ "$1"); crumb="$2"; preview="$3"
  shift 3
  case "$crumb" in hyprism|'') path='/' ;; *) path="/$(tr_ "$crumb")" ;; esac
  # The KEY (field 1) is never translated: callers route on it.
  for it in "$@"; do
    IFS=$'\t' read -r k l d <<<"$it"
    printf '%s\t%s\t%s\n' "$k" "$(tr_ "$l")" "$(tr_ "${d:-}")"
  done | ui_fzf \
      --delimiter=$'\t' --with-nth=2 \
      --border-label=" ${UI_E_BAR} HYPRISM ${UI_E_RST} " \
      --list-label=" $title " --input-label=" $(tr_ 'buscar') " \
      --prompt="hyprism:${path} \$ " \
      --header="$(chips)" --header-first \
      --footer="$(ui_keys ENTER "$(tr_ 'abrir')" ESC "$(tr_ 'voltar')" '↑↓' "$(tr_ 'mover')" "$(tr_ 'digite')" "$(tr_ 'filtrar')")" \
      --preview="$preview" --preview-window='right,50%,border-sharp,wrap' \
      --preview-label=" $(tr_ 'detalhes') "
}

# values stored as sim/nao are shown as words of the current language
yn(){ case "${1:-}" in sim|on|true) tr_ 'sim' ;; nao|off|false) tr_ 'não' ;; '') printf -- '-' ;; *) printf '%s' "$1" ;; esac; }
kv(){ ui_kv "$(tr_ "$1")" "$2"; }

status_hypr(){
  local wall
  wall=$(cat "$WALLFILE" 2>/dev/null)
  ui_title 'HYPRLAND'
  kv 'paleta'       "$(active "$HYPR_ACTIVE")"
  kv 'wallpaper'    "$(basename "${wall:--}")"
  kv 'borda'        "$(value "$HYPR_STATE" border)px · $(tr_ 'cantos') $(value "$HYPR_STATE" rounding)px"
  kv 'gaps'         "$(value "$HYPR_STATE" gaps_in) / $(value "$HYPR_STATE" gaps_out)"
  kv 'blur'         "$(yn "$(value "$HYPR_STATE" blur)") · $(tr_ 'sombra') $(yn "$(value "$HYPR_STATE" shadow)")"
  kv 'animações'    "$(tr_ "$(value "$HYPR_STATE" anim)")"
  kv 'janelas'      "$(tr_ 'flutuantes') $(yn "$(value "$HYPR_STATE" float_all)") · $(value "$HYPR_STATE" win_size)"
  kv 'layout'       "$(value "$HYPR_STATE" layout) · snap $(yn "$(value "$HYPR_STATE" snap)")"
  kv 'cursor'       "$(value "$HYPR_STATE" cursor_theme) · $(value "$HYPR_STATE" cursor_size)px"
  kv 'waybar'       "$(value "$HYPR_STATE" bar_style) · $(value "$HYPR_STATE" barh)px · $(value "$HYPR_STATE" barpos)"
  kv 'notificações' "$(value "$HYPR_STATE" notif_position) · $(value "$HYPR_STATE" notif_timeout)s"
}

status_rofi(){
  local ff fs border radius gap icons icon_size
  ff=$(value "$ROFI_STATE" font_face); fs=$(value "$ROFI_STATE" font_size)
  border=$(value "$ROFI_STATE" border); radius=$(value "$ROFI_STATE" radius)
  gap=$(value "$ROFI_STATE" row_gap); icon_size=$(value "$ROFI_STATE" icon_size)
  icons=$(grep -m1 -oE 'show-icons:[[:space:]]*(true|false)' "$HOME/.config/rofi/config.rasi" 2>/dev/null | awk '{print $2}')
  ui_title 'ROFI LAUNCHER'
  kv 'paleta'    "$(active "$ROFI_ACTIVE")"
  kv 'layout'    "$(value "$ROFI_STATE" layout)"
  kv 'janela'    "$(value "$ROFI_STATE" width)px · $(value "$ROFI_STATE" lines) $(tr_ 'linhas') · $(tr_ "$(value "$ROFI_STATE" pos)")"
  kv 'opacidade' "$(value "$ROFI_STATE" opacity)%"
  kv 'fonte'     "$(pretty "$ff") · $(pretty "$fs")"
  kv 'moldura'   "$(pretty "$border") · $(tr_ 'cantos') $(pretty "$radius")"
  kv 'grade'     "$(value "$ROFI_STATE" columns) · gap $(pretty "$gap")"
  kv 'busca'     "$(value "$ROFI_STATE" matching) · $(tr_ 'ordenar') $(yn "$(value "$ROFI_STATE" sort_enabled)")"
  kv 'ícones'    "$(yn "${icons:-false}") · $(pretty "$icon_size")"
}

kitty_value(){ grep -m1 -E "^$1([[:space:]]|$)" "$KITTY_CONF" 2>/dev/null | sed -E "s/^$1[[:space:]]+//"; }
status_kitty(){
  ui_title 'KITTY + SHELL'
  kv 'tema'      "$(active "$KITTY_ACTIVE")"
  kv 'fonte'     "$(kitty_value font_family) · $(kitty_value font_size)"
  kv 'opacidade' "$(kitty_value background_opacity) · blur $(kitty_value background_blur)"
  kv 'shell'     "$(kitty_value shell)"
  kv 'cursor'    "$(kitty_value cursor_shape)"
  kv 'padding'   "$(kitty_value window_padding_width)px"
  kv 'abas'      "$(kitty_value tab_bar_edge) · $(kitty_value tab_bar_style)"
  kv 'histórico' "$(kitty_value scrollback_lines) $(tr_ 'linhas')"
}

ini_value(){ grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2-; }
status_apps(){
  local gtk="$HOME/.config/gtk-3.0/settings.ini"
  local qt="$HOME/.config/qt6ct/qt6ct.conf"
  ui_title "$(tr_ 'APLICATIVOS E SISTEMA')"
  kv 'tema GTK'   "$(ini_value "$gtk" gtk-theme-name)"
  kv 'ícones GTK' "$(ini_value "$gtk" gtk-icon-theme-name)"
  kv 'cursor GTK' "$(ini_value "$gtk" gtk-cursor-theme-name)"
  kv 'estilo Qt'  "$(ini_value "$qt" style)"
  kv 'esquema Qt' "$(basename "$(ini_value "$qt" color_scheme)" 2>/dev/null)"
}

status_system(){
  local mon
  ui_title "$(tr_ 'SISTEMA')"
  if have hyprctl; then
    while read -r mon; do [ -n "$mon" ] && kv 'tela' "$mon"; done < <(hyprctl monitors 2>/dev/null | awk '/^Monitor/{n=$2} /@/ && n{split($1,a,"@"); printf "%s  %s @ %.0fHz\n", n, a[1], a[2]; n=""}')
  fi
  kv 'kernel' "$(uname -r)"
  kv 'memória' "$(free -h | awk '/^Mem/{print $3" / "$2}')"
  kv 'disco /' "$(df -h / | awk 'NR==2{print $3" / "$2" ("$5")"}')"
}

status_all(){
  status_hypr;  printf '\n'
  status_rofi;  printf '\n'
  status_kitty; printf '\n'
  status_apps
}

status_json(){
  jq -n \
    --arg global_theme "$(active "$HYPR_ACTIVE")" \
    --arg wallpaper "$(cat "$WALLFILE" 2>/dev/null || true)" \
    --arg hypr_theme "$(active "$HYPR_ACTIVE")" \
    --arg rofi_theme "$(active "$ROFI_ACTIVE")" \
    --arg kitty_theme "$(active "$KITTY_ACTIVE")" \
    --arg layout "$(value "$HYPR_STATE" layout)" \
    --arg window_mode "$(value "$HYPR_STATE" float_all)" \
    --arg window_size "$(value "$HYPR_STATE" win_size)" \
    --arg bar_enabled "$(value "$HYPR_STATE" bar_enabled)" \
    --arg rofi_layout "$(value "$ROFI_STATE" layout)" \
    --arg rofi_matching "$(value "$ROFI_STATE" matching)" \
    --arg kitty_font "$(kitty_value font_family)" \
    --arg kitty_font_size "$(kitty_value font_size)" \
    --arg kitty_opacity "$(kitty_value background_opacity)" \
    '{schema_version:1, global:{theme:$global_theme, wallpaper:$wallpaper},
      components:{hyprland:{theme:$hypr_theme, layout:$layout,
        floating:$window_mode, initial_size:$window_size, waybar:$bar_enabled},
      rofi:{theme:$rofi_theme, layout:$rofi_layout, matching:$rofi_matching},
      kitty:{theme:$kitty_theme, font:$kitty_font, font_size:$kitty_font_size,
        opacity:$kitty_opacity}}}'
}

doctor_collect(){
  D_FZF=false; have fzf && D_FZF=true
  D_JQ=false; have jq && D_JQ=true
  D_HYPRCTL=false; have hyprctl && D_HYPRCTL=true
  D_WALL=false; have swaybg && D_WALL=true
  D_SCRIPTS=false
  local f; D_SCRIPTS=true
  for f in "$SELF" "$HYPR" "$ROFI" "$KITTY"; do [ -f "$f" ] && ! bash -n "$f" 2>/dev/null && D_SCRIPTS=false; done
  D_LUA=false
  have lua && lua -e "assert(loadfile('$HOME/.config/hypr/hyprland.lua'))" >/dev/null 2>&1 && D_LUA=true
  D_HYPR_CONFIG=false
  have Hyprland && Hyprland --verify-config --config "$HOME/.config/hypr/hyprland.lua" 2>/dev/null \
    | grep -q 'config ok' && D_HYPR_CONFIG=true
  D_ROFI_THEME=false
  have rofi && rofi -no-config -theme "$HOME/.config/rofi/themes/current.rasi" -dump-theme \
    >/dev/null 2>&1 && D_ROFI_THEME=true
  D_WALL_FILE=false
  [ -f "$(cat "$WALLFILE" 2>/dev/null)" ] && D_WALL_FILE=true
  D_OK=false
  [ "$D_FZF" = true ] && [ "$D_JQ" = true ] && [ "$D_HYPRCTL" = true ] \
    && [ "$D_WALL" = true ] && [ "$D_SCRIPTS" = true ] && [ "$D_LUA" = true ] \
    && [ "$D_HYPR_CONFIG" = true ] && [ "$D_ROFI_THEME" = true ] \
    && [ "$D_WALL_FILE" = true ] && D_OK=true
}

doctor_json(){
  doctor_collect
  jq -n --argjson ok "$D_OK" \
    --argjson fzf "$D_FZF" --argjson jq "$D_JQ" \
    --argjson hyprctl "$D_HYPRCTL" --argjson wallpaper_backend "$D_WALL" \
    --argjson scripts "$D_SCRIPTS" --argjson lua "$D_LUA" \
    --argjson hypr_config "$D_HYPR_CONFIG" --argjson rofi_theme "$D_ROFI_THEME" \
    --argjson wallpaper_file "$D_WALL_FILE" \
    '{schema_version:1, ok:$ok, checks:{commands:{fzf:$fzf,jq:$jq,hyprctl:$hyprctl,
      wallpaper_backend:$wallpaper_backend}, syntax:{scripts:$scripts,lua:$lua,
      hyprland:$hypr_config,rofi:$rofi_theme}, files:{wallpaper:$wallpaper_file}}}'
  [ "$D_OK" = true ]
}

doctor_human(){
  doctor_collect
  printf '\n'; ui_title "$(tr_ 'DIAGNÓSTICO')"; printf '\n'
  local name val
  while IFS='|' read -r name val; do
    if [ "$val" = true ]; then printf '  \033[32m[ OK ]\033[0m %s\n' "$(tr_ "$name")"
    else printf '  \033[31m[FALHA]\033[0m %s\n' "$(tr_ "$name")"; fi
  done <<EOF
fzf disponível|$D_FZF
jq disponível|$D_JQ
Hyprland IPC disponível|$D_HYPRCTL
backend de wallpaper|$D_WALL
scripts Bash válidos|$D_SCRIPTS
arquivo Lua válido|$D_LUA
configuração Hyprland válida|$D_HYPR_CONFIG
tema Rofi válido|$D_ROFI_THEME
wallpaper selecionado existe|$D_WALL_FILE
EOF
  printf '\n  %s: %s\n' "$(tr_ 'resultado')" "$([ "$D_OK" = true ] && tr_ 'tudo certo' || tr_ 'precisa de atenção')"
  [ "$D_OK" = true ]
}

detail(){
  local key="${1:-}" section="${2:-}"
  case "$key" in
    hyprland) echo 'Controle o compositor, as janelas e toda a área de trabalho.' ;;
    rofi) echo 'Personalize o launcher usado por SUPER + ESPAÇO.' ;;
    kitty) echo 'Configure terminal, fonte, shell e prompt em um só fluxo.' ;;
    apps) echo 'Ajuste aplicativos GTK/Qt e ferramentas essenciais do sistema.' ;;
    settings) echo 'Gerencie o sistema como nas Configurações do Windows: tela, som, rede, energia e mais.' ;;
    backup) echo 'Salve, restaure ou reaplique o visual completo com segurança.' ;;
    sync|sincronizar) echo 'Usa o tema global ativo do Hyprland no Kitty, Waybar e Rofi.' ;;
    random|aleatorio) echo 'Escolhe uma paleta aleatória e aplica em todo o desktop.' ;;
    status|config) echo 'Mostra todos os valores que estão ativos neste momento.' ;;
    buscar) echo 'Encontre qualquer ajuste pelo nome sem navegar pelas categorias.' ;;
    doctor|diagnostico) echo 'Verifica programas, arquivos e sintaxe sem alterar nada.' ;;
    paleta) echo 'Escolha as cores e veja a prévia antes de confirmar.' ;;
    wallpaper) echo 'Navegue pelos wallpapers com troca ao vivo pelas setas.' ;;
    bordas) echo 'Mude a cor e a intensidade das bordas ativa e inativa.' ;;
    aparencia) echo 'Ajuste dimensões, espaçamento e geometria do componente.' ;;
    efeitos) echo 'Controle blur, sombra, opacidade e animações.' ;;
    barra) echo 'Configure a Waybar e os elementos exibidos nela.' ;;
    modulos) echo 'Escolha exatamente quais módulos aparecem na Waybar.' ;;
    janelas) echo 'Defina modo flutuante/tiling e comportamento de abertura.' ;;
    entrada) echo 'Configure mouse, touchpad, gestos, rolagem e sensibilidade.' ;;
    cursor) echo 'Escolha tema, tamanho e ocultação automática do cursor.' ;;
    bloqueio) echo 'Fundo (wallpaper/imagem/cor), relógio (tamanho·cor·formato), moldura, avatar, mensagem, brilho e blur.' ;;
    notificacoes) echo 'Ajuste posição, largura, duração e ícones das notificações.' ;;
    fonte) echo 'Escolha família e tamanho da fonte com prévia.' ;;
    atalhos) echo 'Consulte os atalhos de teclado configurados.' ;;
    preset) echo 'Salve ou carregue uma combinação do Hyprland.' ;;
    layout) echo 'Altere a organização visual do launcher.' ;;
    tipografia) echo 'Ajuste família e tamanho da fonte usada no launcher.' ;;
    moldura) echo 'Ajuste borda e arredondamento da janela do launcher.' ;;
    grade) echo 'Configure densidade, colunas, espaçamento, ícones e scrollbar.' ;;
    busca) echo 'Escolha algoritmo, ordenação, maiúsculas e tokenização da busca.' ;;
    posicao) echo 'Escolha onde o launcher aparece na tela.' ;;
    opacidade|transparencia) echo 'Controle transparência e desfoque do fundo.' ;;
    icones) echo 'Mostre ou esconda ícones de aplicativos.' ;;
    testar) echo 'Abra uma demonstração real para conferir o resultado.' ;;
    perfis) echo 'Aplique cores, opacidade e prompt como um conjunto.' ;;
    shell) echo 'Escolha o shell usado nas novas abas do terminal.' ;;
    prompt) echo 'Escolha um prompt Starship com prévia real.' ;;
    janela) echo 'Ajuste padding, tamanho inicial, decoração e memorização.' ;;
    abas) echo 'Configure posição, estilo, alinhamento e títulos das abas.' ;;
    historico) echo 'Controle scrollback, velocidade, seleção e comportamento do mouse.' ;;
    alertas) echo 'Configure bell sonoro, alerta visual e atenção da janela.' ;;
    comportamento)
      if [ "$section" = rofi ]; then
        echo 'Ajuste navegação circular, seleção pelo mouse e clique externo.'
      else
        echo 'Ajuste links, foco, integração do shell e fechamento.'
      fi ;;
    gtk) echo 'Abra o nwg-look para tema, fonte, ícones e cursor GTK.' ;;
    qt) echo 'Abra o qt6ct para estilo, cores, fonte e ícones Qt.' ;;
    rede) echo 'Configure Wi-Fi, VPN, DNS, IP fixo e rotas.' ;;
    audio) echo 'Configure volumes, microfones, saídas e perfis de áudio.' ;;
    bluetooth) echo 'Pareie e gerencie dispositivos Bluetooth.' ;;
    monitor) echo 'Acompanhe CPU, memória, discos e processos pelo btop.' ;;
    scanner) echo 'Mapeia espaço, caches, pacotes órfãos e restos sem remover nada.' ;;
    salvar) echo 'Cria uma cópia das configurações visuais atuais.' ;;
    restaurar) echo 'Restaura Hyprland, Waybar, Rofi, Kitty e prompt.' ;;
    reaplicar) echo 'Regenera os arquivos e recarrega todos os componentes.' ;;
    voltar|sair) echo 'Volta ao nível anterior sem alterar configurações.' ;;
  esac
}

quick_preview(){
  local key="${1:-}" section action
  section="${key%%:*}"; action="${key#*:}"
  case "$section" in hypr) section=hyprland ;; sistema) section=apps ;; global) section=all ;; esac
  preview "$section" "$action"
}

preview(){
  local section="${1:-all}" action="${2:-${1:-all}}" what
  what=$(detail "$action" "$section")
  [ -n "$what" ] && printf '%s%s%s\n\n' "$UI_E_FG$UI_E_B" "$(tr_ "$what")" "$UI_E_RST"
  ui_rule "$(tr_ 'estado atual')"; printf '\n'
  case "$section" in
    settings)        status_system ;;
    hyprland|hypr-*) status_hypr ;;
    rofi|rofi-*)     status_rofi ;;
    kitty|kitty-*)   status_kitty ;;
    apps|sistema)    status_apps ;;
    *)               status_all ;;
  esac
}

run(){
  local bin="$1"; shift
  [ -x "$bin" ] || { printf '%s: %s\n' "$(tr_ 'ferramenta ausente')" "$bin"; sleep 2; return 1; }
  "$bin" "$@"
}

gui(){
  have "$1" || { printf '%s: %s\n' "$(tr_ 'Programa não instalado')" "$1"; sleep 2; return 1; }
  setsid "$@" >/dev/null 2>&1 < /dev/null &
}

apps_menu(){
  while true; do
    local c key
    c=$(pick 'APLICATIVOS E SISTEMA' 'sistema' "$SELF __preview apps {1}" \
      $'gtk\tTema dos aplicativos GTK\tCores, ícones, fonte e cursor pelo nwg-look' \
      $'qt\tTema dos aplicativos Qt\tEstilo, cores, fonte e ícones pelo qt6ct' \
      $'rede\tConexões de rede\tWi-Fi, VPN, IP fixo, DNS e rotas' \
      $'audio\tÁudio\tVolumes, microfones, saídas e perfis' \
      $'bluetooth\tBluetooth\tDispositivos, pareamento e conexões' \
      $'monitor\tMonitor do sistema\tProcessos, memória, CPU e discos no btop' \
      $'scanner\tArmazenamento\tEspaço em disco e limpeza (Configurações do sistema)' \
      $'voltar\t← Voltar\tRetornar à central') || return 0
    key="${c%%$'\t'*}"
    case "$key" in
      gtk) gui nwg-look ;; qt) gui qt6ct ;;
      rede) gui nm-connection-editor ;; audio) gui pavucontrol ;;
      bluetooth) gui blueman-manager ;; monitor) if have btop; then btop; else gui btop; fi ;;
      scanner) run "$SETTINGS" storage ;;
      voltar) return 0 ;;
    esac
  done
}

