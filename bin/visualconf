#!/usr/bin/env bash
# =====================================================================
# visualconf — central visual unica do Hyprland, Rofi e Kitty
#
# Sem argumentos abre o painel completo. Tambem aceita:
#   visualconf hyprland | rofi | kitty | sync | status | doctor
#   visualconf --json status | visualconf --json doctor
#
# Os tres configuradores continuam sendo os motores. Esta central oferece
# uma navegacao unica e preserva todos os recursos e previas existentes.
# =====================================================================
set -u

SELF="$(command -v visualconf 2>/dev/null || printf '%s' "$0")"
# Engines are found on PATH (install.sh links them into ~/.local/bin).
HYPR="${HYPRCONF_BIN:-$(command -v hyprism || command -v hyprtheme || echo hyprism)}"
ROFI="${ROFICONF_BIN:-$(command -v rofitheme || echo rofitheme)}"
KITTY="${KITTYCONF_BIN:-$(command -v kittytheme || echo kittytheme)}"
SETTINGS="$(command -v hyprism-settings || echo hyprism-settings)"

HYPR_STATE="$HOME/.config/hypr/themes/.state"
HYPR_ACTIVE="$HOME/.config/hypr/themes/.active"
ROFI_STATE="$HOME/.config/rofi/themes/.state"
ROFI_ACTIVE="$HOME/.config/rofi/themes/.active"
KITTY_CONF="$HOME/.config/kitty/kitty.conf"
KITTY_ACTIVE="$HOME/.config/kitty/themes/.active"
WALLFILE="$HOME/.config/hypr/wallpaper"
# Backups used to live in ~/.config/visualconf; move them once.
BACKUPS="$HOME/.config/hyprism/backups"
if [ -d "$HOME/.config/visualconf/backups" ] && [ ! -d "$BACKUPS" ]; then
  mkdir -p "$HOME/.config/hyprism" && mv "$HOME/.config/visualconf/backups" "$BACKUPS" 2>/dev/null
fi
mkdir -p "$BACKUPS"

