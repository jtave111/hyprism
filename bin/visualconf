      $'rofi:moldura\tRofi · Moldura\tBorda e arredondamento' \
      $'rofi:grade\tRofi · Grade\tDensidade, colunas, gaps e ícones' \
      $'rofi:prompt\tRofi · Prompt\tBusca e formato dos resultados' \
      $'rofi:busca\tRofi · Busca\tAlgoritmo, ordenação e tokens' \
      $'rofi:comportamento\tRofi · Interação\tTeclado, mouse e clique externo' \
      $'rofi:opacidade\tRofi · Opacidade\tTransparência da janela' \
      $'kitty:perfis\tKitty · Perfis\tCores, transparência e prompt' \
      $'kitty:tema\tKitty · Tema\tCores do terminal' \
      $'kitty:transparencia\tKitty · Transparência\tOpacidade e blur' \
      $'kitty:fonte\tKitty · Fonte\tFamília e tamanho' \
      $'kitty:cursor\tKitty · Cursor\tForma, piscar e espessura' \
      $'kitty:janela\tKitty · Janela\tPadding, tamanho e decoração' \
      $'kitty:abas\tKitty · Abas\tPosição, estilo e títulos' \
      $'kitty:historico\tKitty · Histórico\tScrollback, rolagem e mouse' \
      $'kitty:alertas\tKitty · Alertas\tSom, flash e atenção' \
      $'kitty:comportamento\tKitty · Comportamento\tLinks, foco e integração' \
      $'kitty:shell\tKitty · Shell\tFish, Bash ou Zsh' \
      $'kitty:prompt\tKitty · Prompt\tModelos Starship' \
      $'sistema:gtk\tSistema · GTK\tTema, ícones, fonte e cursor' \
      $'sistema:qt\tSistema · Qt\tEstilo, cores, fonte e ícones' \
      $'sistema:rede\tSistema · Rede\tWi-Fi, VPN, DNS e IP' \
      $'sistema:audio\tSistema · Áudio\tVolumes, entradas e saídas' \
      $'sistema:bluetooth\tSistema · Bluetooth\tPareamento e conexões' \
      $'sistema:scanner\tSistema · Scanner\tEspaço, órfãos, KDE e caches sem remover' \
      $'global:sync\tGlobal · Sincronizar\tHyprland → todos os componentes' \
      $'global:status\tGlobal · Resumo\tTodos os valores ativos' \
      $'global:doctor\tGlobal · Diagnóstico\tDependências e sintaxe' \
      $'voltar:voltar\t← Voltar\tRetornar à central') || return 0
    key="${c%%$'\t'*}"
    case "$key" in
      hypr:*) run "$HYPR" "${key#*:}" ;;
      rofi:*) run "$ROFI" "${key#*:}" ;;
      kitty:*) run "$KITTY" "${key#*:}" ;;
      sistema:gtk) gui nwg-look ;; sistema:qt) gui qt6ct ;;
      sistema:rede) gui nm-connection-editor ;; sistema:audio) gui pavucontrol ;;
      sistema:bluetooth) gui blueman-manager ;;
      sistema:scanner) clear; run "$AUDIT" scan; printf '\n'; read -rp '  [enter] voltar ' _ ;;
      global:sync) sync_all ;; global:status) status_all; printf '\n'; read -rp '  [enter] voltar ' _ ;;
      global:doctor) doctor_human; printf '\n'; read -rp '  [enter] voltar ' _ ;;
      voltar:voltar) return 0 ;;
    esac
  done
}

copy_if(){
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  mkdir -p "$(dirname "$dst")"
  cp -a "$src" "$dst"
}

backup_create(){
  local name dir
  name=$(date +'%Y-%m-%d_%H-%M-%S')
  dir="$BACKUPS/$name"
  mkdir -p "$dir"
  copy_if "$HYPR_STATE" "$dir/hypr/state"
  copy_if "$HYPR_ACTIVE" "$dir/hypr/active"
  copy_if "$WALLFILE" "$dir/hypr/wallpaper"
  copy_if "$HOME/.config/hypr/accent" "$dir/hypr/accent"
  copy_if "$HOME/.config/waybar/config.jsonc" "$dir/waybar/config.jsonc"
  copy_if "$ROFI_STATE" "$dir/rofi/state"
  copy_if "$ROFI_ACTIVE" "$dir/rofi/active"
  copy_if "$HOME/.config/rofi/config.rasi" "$dir/rofi/config.rasi"
  copy_if "$KITTY_CONF" "$dir/kitty/kitty.conf"
  copy_if "$KITTY_ACTIVE" "$dir/kitty/active"
  copy_if "$HOME/.config/kitty/themes/current.conf" "$dir/kitty/current.conf"
  copy_if "$HOME/.config/starship.toml" "$dir/starship.toml"
  printf '\n  Backup salvo: %s\n' "$name"
  sleep 1.3
}

reapply_all(){
  run "$HYPR" render
  local ra ka
  ra=$(cat "$ROFI_ACTIVE" 2>/dev/null); [ -n "${ra:-}" ] && run "$ROFI" "$ra"
  ka=$(cat "$KITTY_ACTIVE" 2>/dev/null); [ -n "${ka:-}" ] && run "$KITTY" "$ka"
}

backup_restore(){
  local sel dir
  sel=$(find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -r \
      | fzf_ui --height=70% --border-label='  RESTAURAR VISUAL  ' \
        --prompt='  backup › ' --header='ENTER restaura · ESC cancela')
  [ -n "${sel:-}" ] || return 0
  dir="$BACKUPS/$sel"
  copy_if "$dir/hypr/state" "$HYPR_STATE"
  copy_if "$dir/hypr/active" "$HYPR_ACTIVE"
  copy_if "$dir/hypr/wallpaper" "$WALLFILE"
  copy_if "$dir/hypr/accent" "$HOME/.config/hypr/accent"
  copy_if "$dir/waybar/config.jsonc" "$HOME/.config/waybar/config.jsonc"
  copy_if "$dir/rofi/state" "$ROFI_STATE"
  copy_if "$dir/rofi/active" "$ROFI_ACTIVE"
  copy_if "$dir/rofi/config.rasi" "$HOME/.config/rofi/config.rasi"
  copy_if "$dir/kitty/kitty.conf" "$KITTY_CONF"
  copy_if "$dir/kitty/active" "$KITTY_ACTIVE"
  copy_if "$dir/kitty/current.conf" "$HOME/.config/kitty/themes/current.conf"
  copy_if "$dir/starship.toml" "$HOME/.config/starship.toml"
  reapply_all
  printf '\n  Backup restaurado: %s\n' "$sel"
  sleep 1.3
}

backup_menu(){
  while true; do
    local c key
    c=$(pick 'GERENCIAR VISUAL' 'visual' "$SELF __preview all {1}" \
      $'salvar\tCriar backup agora\tGuarda Hyprland, Waybar, Rofi, Kitty e prompt' \
      $'restaurar\tRestaurar backup\tVoltar para um visual salvo anteriormente' \
      $'reaplicar\tReaplicar configuração\tRegenerar e recarregar todos os componentes' \
      $'sincronizar\tSincronizar tema global\tAplicar a paleta do Hyprland em todo o desktop' \
      $'aleatorio\tVisual aleatório\tEscolher e sincronizar uma paleta aleatória' \
      $'voltar\t← Voltar\tRetornar à central') || return 0
    key="${c%%$'\t'*}"
    case "$key" in
      salvar) backup_create ;; restaurar) backup_restore ;;
      reaplicar) reapply_all ;; sincronizar) sync_all ;; aleatorio) random_all ;;
      voltar) return 0 ;;
    esac
  done
}

