sync_all(){
  local theme shared
  theme=$(cat "$HYPR_ACTIVE" 2>/dev/null)
  [ -n "${theme:-}" ] || { echo 'O Hyprland ainda não tem um tema global ativo.'; sleep 2; return 1; }

  # O Hyprland e a fonte global. A paleta especial antiga do SDDM nao possui
  # um tema Kitty proprio, portanto usa seu equivalente terminal-red.
  shared="$theme"
  if [ ! -f "$HOME/.config/kitty/themes/$shared.conf" ] && [ "$shared" = sddm-terminal-red ]; then
    shared=terminal-red
  fi
  if [ ! -f "$HOME/.config/kitty/themes/$shared.conf" ]; then
    printf '  A paleta global "%s" ainda não possui versão para o Kitty.\n' "$theme"
    sleep 2
    return 1
  fi
  if [ ! -f "$HOME/.config/rofi/themes/palettes/$shared.rasi" ]; then
    run "$ROFI" -g >/dev/null || return 1
  fi

  printf '\n  Tema global do Hyprland: \033[1;31m%s\033[0m\n' "$theme"
  printf '  Aplicando no Kitty e no Rofi...\n\n'
  run "$KITTY" "$shared" || return 1
  run "$ROFI" "$shared" || return 1
  run "$HYPR" render >/dev/null || return 1
  printf '\n  Pronto: Hyprland → Waybar, bloqueio, notificações, Rofi e Kitty.\n'
  sleep 1.4
}

random_all(){
  run "$HYPR" --random
  sync_all
}

# Idioma da interface do Hyprism (menus, prompts e ajuda do hyprtheme).
# Herdado da antiga tela "Hyprism · control center", agora dentro da central.
lang_menu(){
  local cur c key
  cur=$(value "$HYPR_STATE" lang); [ -n "$cur" ] || cur='en'
  c=$(pick 'Hyprism · Idioma / Language' 'idioma' \
      "echo '  Idioma atual do Hyprism: $cur'; echo; echo '  PT — menus, prompts e ajuda em português'; echo '  EN — everything in English'" \
      $'pt\tPortuguês  (PT)\tInterface do Hyprism em português' \
      $'en\tEnglish  (EN)\tHyprism interface in English' \
      $'voltar\t← Voltar\tRetornar ao Hyprism') || return 0
  key="${c%%$'\t'*}"
  case "$key" in
    pt) run "$HYPR" lang pt ;; en) run "$HYPR" lang en ;; voltar) return 0 ;;
  esac
}

main_menu(){
  have fzf || { echo 'Instale o fzf para abrir o Hyprism.'; return 1; }
  while true; do
    local c key
    c=$(pick 'Hyprism' 'hyprism' "$SELF __preview {1}" \
      $'buscar\tBuscar qualquer configuração\tPesquisa única em Hyprland, Rofi, Kitty e sistema' \
      $'hyprland\tHyprland e Waybar\tJanelas, wallpaper, bordas, efeitos e barra' \
      $'rofi\tRofi Launcher\tLayout, tamanho, posição, cores e ícones' \
      $'kitty\tKitty e Shell\tTerminal, fontes, transparência, shell e prompt' \
      $'apps\tAplicativos e sistema\tGTK, Qt, rede, áudio, Bluetooth e processos' \
      $'backup\tGerenciar visual\tBackup, restauração, reaplicar e sincronizar' \
      $'sync\tSincronizar tudo\tUsar o tema global ativo do Hyprland em todo o desktop' \
      $'random\tVisual aleatório\tEscolher uma paleta e aplicar em tudo' \
      $'idioma\tIdioma · Language\tAlternar a interface do Hyprism entre Português e Inglês (EN ⇄ PT)' \
      $'status\tResumo completo\tConferir todas as escolhas ativas' \
      $'doctor\tDiagnóstico\tVerificar dependências, arquivos e sintaxe' \
      $'sair\tSair\tFechar o Hyprism') || break
    key="${c%%$'\t'*}"
    case "$key" in
      buscar) quick_search ;; hyprland) hypr_menu ;; rofi) rofi_menu ;; kitty) kitty_menu ;;
      apps) apps_menu ;; backup) backup_menu ;;
      sync) sync_all ;; random) random_all ;;
      idioma) lang_menu ;;
      status) status_all; printf '\n'; read -rp '  [enter] voltar ' _ ;;
      doctor) doctor_human; printf '\n'; read -rp '  [enter] voltar ' _ ;;
      sair) break ;;
    esac
  done
}

usage(){
  cat <<'EOF'
visualconf — central única de personalização do desktop

Interface:
  visualconf                    abre a central visual
  visualconf hyprland           Hyprland, Waybar, wallpaper e bloqueio
  visualconf rofi               launcher Rofi
  visualconf kitty              terminal Kitty e shell
  visualconf apps               GTK, Qt, rede, áudio e Bluetooth

Automação:
  visualconf sync               propaga o tema global ativo do Hyprland
  visualconf random             escolhe um tema global aleatório e sincroniza
  visualconf status             mostra o estado atual
  visualconf doctor             verifica dependências, arquivos e sintaxe
  visualconf audit              executa o scanner somente leitura do sistema
  visualconf --json status      estado estruturado para scripts
  visualconf --json doctor      diagnóstico estruturado; falhas retornam != 0
EOF
}

if [ "${1:-}" = --json ]; then
  case "${2:-}" in
    status|config) status_json ;;
    doctor|diagnostico) doctor_json ;;
    *) printf '{"ok":false,"error":"use --json status ou --json doctor"}\n' >&2; exit 2 ;;
  esac
  exit
fi

case "${1:-}" in
  __preview) preview "${2:-all}" "${3:-${2:-all}}" ;;
  __quickpreview) quick_preview "${2:-}" ;;
  hyprland|hypr|hyper) hypr_menu ;;
  rofi|launcher) rofi_menu ;;
  kitty|terminal) kitty_menu ;;
  apps|sistema) apps_menu ;;
  backup|gerenciar) backup_menu ;;
  sync) sync_all ;;
  random|aleatorio) random_all ;;
  status|config) status_all ;;
  doctor|diagnostico) doctor_human ;;
  audit|scanner) run "$AUDIT" scan ;;
  -h|--help|help|ajuda) usage ;;
  '') main_menu ;;
  *) echo "opção inválida: $1"; exit 1 ;;
esac
