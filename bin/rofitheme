#!/usr/bin/env bash
# =====================================================================
#  rofitheme  -  central de personalizacao do launcher (rofi)
#  sem argumentos ....... abre o menu
#  rofitheme <paleta> .... aplica uma paleta direto
#  rofitheme layout ...... minimal (mono) ou spotlight (arredondado)
#  rofitheme janela | fonte | moldura | grade | densidade | prompt
#  rofitheme busca | comportamento | opacidade | posicao | icones
#  rofitheme testar ...... abre o launcher pra ver como ficou
#  rofitheme sync ........ usa o tema global ativo do Hyprland
#  rofitheme set CHAVE VALOR ... configuracao direta para outras centrais
#  rofitheme status ...... mostra o estado sem abrir menu nem pausar
#  rofitheme -l lista   -r aleatorio   -g regera paletas   -h ajuda
# =====================================================================
set -u
RDIR="$HOME/.config/rofi"
RCONF="$RDIR/config.rasi"
TD="$RDIR/themes"
PAL="$TD/palettes"
LAY="$TD/layouts"
CUR="$TD/current.rasi"
STATE="$TD/.active"
SET="$TD/.state"
KTD="$HOME/.config/kitty/themes"
SELF="$(command -v rofitheme 2>/dev/null || printf '%s' "$0")"
mkdir -p "$PAL" "$LAY"

have(){ command -v "$1" >/dev/null 2>&1; }

# ---------- estilo do seletor (mesmo do kittytheme) ----------
FZF(){ fzf --height=92% --layout=reverse --border=rounded --info=inline-right --ansi --no-separator \
  --margin=1 --padding=1 --gap=1 --pointer='▸' --marker='✓' --scrollbar='│' \
  --color='bg:-1,bg+:#1b1111,fg:#b8b8b8,fg+:#ffffff,hl:#ff4a4a,hl+:#ff6a6a:bold,pointer:#ff2b2b,prompt:#ff2b2b:bold,marker:#ff6a6a,info:#666666,header:#888888,border:#5a0000,gutter:-1' \
  "$@"; }

# ---------- estado ----------
sget(){ grep -m1 "^$1=" "$SET" 2>/dev/null | cut -d= -f2-; }
sset(){
  local k="$1" v="$2" tmp="$SET.tmp.$$"; touch "$SET"
  # awk evita que nomes de fontes contendo '&' ou separadores de sed
  # corrompam o arquivo de estado.
  awk -v key="$k" -v val="$v" '
    BEGIN { done=0 }
    index($0, key "=")==1 { if (!done) print key "=" val; done=1; next }
    { print }
    END { if (!done) print key "=" val }
  ' "$SET" > "$tmp" && mv "$tmp" "$SET"
}
seed_state(){
  [ -z "$(sget layout)"  ] && sset layout  minimal
  [ -z "$(sget width)"   ] && sset width   560
  [ -z "$(sget lines)"   ] && sset lines   10
  [ -z "$(sget pos)"     ] && sset pos     centro
  [ -z "$(sget opacity)" ] && sset opacity 100
  # "auto" conserva a identidade de cada layout. Um valor escolhido pelo
  # usuario passa a valer nos dois layouts e continua persistente.
  [ -z "$(sget font_face)" ]   && sset font_face auto
  [ -z "$(sget font_size)" ]   && sset font_size auto
  [ -z "$(sget border)" ]      && sset border auto
  [ -z "$(sget radius)" ]      && sset radius auto
  [ -z "$(sget density)" ]     && sset density normal
  [ -z "$(sget columns)" ]     && sset columns 1
  [ -z "$(sget row_gap)" ]     && sset row_gap auto
  [ -z "$(sget icon_size)" ]   && sset icon_size auto
  [ -z "$(sget prompt)" ]      && sset prompt auto
  [ -z "$(sget counter)" ]     && sset counter auto
  [ -z "$(sget scrollbar)" ]   && sset scrollbar false
  [ -z "$(sget matching)" ]    && sset matching fuzzy
  [ -z "$(sget sort_enabled)" ] && sset sort_enabled true
  [ -z "$(sget sorting)" ]     && sset sorting fzf
  [ -z "$(sget case_mode)" ]   && sset case_mode ignore
  [ -z "$(sget tokenize)" ]    && sset tokenize true
  [ -z "$(sget cycle)" ]       && sset cycle true
  [ -z "$(sget hover)" ]       && sset hover true
  [ -z "$(sget click_exit)" ]  && sset click_exit true
  [ -z "$(sget drun_format)" ] && sset drun_format name
  return 0
}

valid_int(){ [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }
valid_bool(){ [ "$1" = true ] || [ "$1" = false ]; }

# Atualiza uma propriedade existente do bloco configuration. Todas as chaves
# usadas aqui sao fixas; os valores passam pela validacao de set_value().
rconf_set(){
  local key="$1" value="$2" tmp="$RCONF.tmp.$$"
  if grep -qE "^[[:space:]]*$key:" "$RCONF" 2>/dev/null; then
    awk -v key="$key" -v val="$value" '
      $0 ~ "^[[:space:]]*" key ":" {
        match($0, /^[[:space:]]*/); indent=substr($0, 1, RLENGTH)
        print indent key ":                   " val ";"; next
      }
      { print }
    ' "$RCONF" > "$tmp" && mv "$tmp" "$RCONF"
  else
    awk -v key="$key" -v val="$value" '
      !done && /^configuration[[:space:]]*\{/ {
        print; print "    " key ":                   " val ";"; done=1; next
      }
      { print }
    ' "$RCONF" > "$tmp" && mv "$tmp" "$RCONF"
  fi
}

sync_rofi_config(){
  local ff fs cm csen csmart fmt
  ff=$(sget font_face); fs=$(sget font_size)
  [ "$ff" = auto ] && { [ "$(sget layout)" = spotlight ] && ff="Noto Sans" || ff="FiraCode Nerd Font Mono"; }
  [ "$fs" = auto ] && { [ "$(sget layout)" = spotlight ] && fs=12 || fs=11; }
  rconf_set font "\"$ff $fs\""
  rconf_set matching "\"$(sget matching)\""
  rconf_set sort "$(sget sort_enabled)"
  rconf_set sorting-method "\"$(sget sorting)\""
  rconf_set tokenize "$(sget tokenize)"
  rconf_set cycle "$(sget cycle)"
  rconf_set hover-select "$(sget hover)"
  rconf_set click-to-exit "$(sget click_exit)"
  cm=$(sget case_mode); csen=false; csmart=false
  [ "$cm" = sensitive ] && csen=true
  [ "$cm" = smart ] && csmart=true
  rconf_set case-sensitive "$csen"
  rconf_set case-smart "$csmart"
  fmt=$(sget drun_format)
  case "$fmt" in
    generic) fmt='{name} - {generic}' ;;
    exec)    fmt='{name} ({exec})' ;;
    *)       fmt='{name}' ;;
  esac
  rconf_set drun-display-format "\"$fmt\""
}

# ---------- cor ----------
rgb(){ local h="${1#\#}"; printf '%d %d %d' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"; }
mix(){ # mix COR_A COR_B PCT_DE_A -> #RRGGBB
  local ar ag ab br bg bb p="$3"
  read -r ar ag ab <<<"$(rgb "$1")"; read -r br bg bb <<<"$(rgb "$2")"
  printf '#%02X%02X%02X' $(( (ar*p + br*(100-p))/100 )) \
                         $(( (ag*p + bg*(100-p))/100 )) \
                         $(( (ab*p + bb*(100-p))/100 )); }
is_dark(){ local r g b; read -r r g b <<<"$(rgb "$1")"
  [ $(( (r*299 + g*587 + b*114)/1000 )) -lt 128 ]; }
afg(){ local r g b; read -r r g b <<<"$(rgb "$1")"; printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b"; }
abg(){ local r g b; read -r r g b <<<"$(rgb "$1")"; printf '\033[48;2;%d;%d;%dm' "$r" "$g" "$b"; }
Z=$'\033[0m'

# ---------- gerar paletas a partir dos temas do kitty ----------
kval(){ grep -m1 -E "^$2([[:space:]]|\$)" "$1" 2>/dev/null | awk '{print $2}'; }

gen_one(){
  local f="$1" name bgc fgc active_border active_tab cur c1 selbg accent lit dim line selfg onacc
  name=$(basename "$f" .conf)
  bgc=$(kval "$f" background); fgc=$(kval "$f" foreground)
  if [ -z "$bgc" ] || [ -z "$fgc" ]; then return 1; fi
  active_border=$(kval "$f" active_border_color)
  active_tab=$(kval "$f" active_tab_background)
  cur=$(kval "$f" cursor); c1=$(kval "$f" color1)
  selbg=$(kval "$f" selection_background)
  # Segue o realce principal que o proprio Kitty exibe nas bordas/abas.
  # O cursor e apenas fallback: em BlackArch ele e vermelho, enquanto o
  # acento visual correto do tema e violeta.
  accent="${active_border:-${active_tab:-${cur:-${c1:-#888888}}}}"

  dim=$(mix "$fgc" "$bgc" 45)
  line=$(mix "$fgc" "$bgc" 16)

  if is_dark "$bgc"; then lit=$(mix "$accent" "#FFFFFF" 70)
  else                    lit=$(mix "$accent" "#000000" 72); fi

  selbg="${selbg:-$(mix "$accent" "$bgc" 18)}"
  # se a selecao do kitty briga com o fundo, deriva do acento
  if is_dark "$bgc" && ! is_dark "$selbg"; then selbg=$(mix "$accent" "$bgc" 18); fi
  if ! is_dark "$bgc" && is_dark "$selbg"; then selbg=$(mix "$accent" "$bgc" 18); fi

  if is_dark "$selbg";  then selfg="#FFFFFF"; else selfg="#111111"; fi
  if is_dark "$accent"; then onacc="#FFFFFF"; else onacc="#111111"; fi

  # A propriedade 'highlight' NAO entra aqui de proposito: ela aborta o parse
  # do rofi silenciosamente, e tudo que vem depois no tema e descartado.
  # O rebuild() a escreve como ULTIMA linha do current.rasi, usando accent-lit.
  cat > "$PAL/$name.rasi" <<EOF
/* paleta: $name
 * gerada por rofitheme a partir de ${f/#$HOME/\~}
 * nao edite a mao: 'rofitheme -g' regera este arquivo.
 */
* {
    bg:           ${bgc}FF;
    fg:           ${fgc}FF;
    dim:          ${dim}FF;
    line:         ${line}FF;
    accent:       ${accent}FF;
    accent-lit:   ${lit}FF;
    sel-bg:       ${selbg}FF;
    sel-fg:       ${selfg}FF;
    on-accent:    ${onacc}FF;
}
EOF
  printf '%s\n' "$name"
}

gen_palettes(){
  if [ ! -d "$KTD" ]; then echo "  temas do kitty nao encontrados em $KTD"; return 1; fi
  local n=0 f
  for f in "$KTD"/*.conf; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in current.conf) continue;; esac
    gen_one "$f" >/dev/null && n=$((n+1))
  done
  printf '  %d paletas geradas em %s\n' "$n" "${PAL/#$HOME/\~}"
}

palettes(){ find "$PAL" -maxdepth 1 -name '*.rasi' -printf '%f\n' 2>/dev/null | sed 's/\.rasi$//' | sort; }
layouts(){  find "$LAY" -maxdepth 1 -name '*.rasi' -printf '%f\n' 2>/dev/null | sed 's/\.rasi$//' | sort; }

# ---------- montar o current.rasi ----------
ensure_conf(){
  # garante que o config.rasi aponta pro current.rasi
  if ! grep -q 'themes/current.rasi' "$RCONF" 2>/dev/null; then
    if grep -qE '^\s*@theme' "$RCONF" 2>/dev/null; then
      sed -i -E "s|^\s*@theme.*|@theme \"$CUR\"|" "$RCONF"
    else printf '\n@theme "%s"\n' "$CUR" >> "$RCONF"; fi
  fi
}

rebuild(){
  seed_state
  local name layout w l pos op bgc bg8 lit
  local ff fs font_small font_list font_input border radius density columns
  local row_gap icon_size prompt counter scrollbar prompt_enabled prompt_symbol
  local prompt_placeholder counter_enabled input_pad input_gap list_pad list_gap
  local item_pad item_gap element_radius element_border win_loc win_anchor xoff yoff
  name=$(cat "$STATE" 2>/dev/null)
  [ -f "$PAL/$name.rasi" ] || return 1
  layout=$(sget layout); [ -f "$LAY/$layout.rasi" ] || layout=minimal
  w=$(sget width); l=$(sget lines); pos=$(sget pos); op=$(sget opacity)
  bgc=$(grep -m1 -E '^\s*bg:' "$PAL/$name.rasi" | grep -oE '#[0-9A-Fa-f]{6}')
  lit=$(grep -m1 -E '^\s*accent-lit:' "$PAL/$name.rasi" | grep -oE '#[0-9A-Fa-f]{6}')

  ff=$(sget font_face); fs=$(sget font_size); border=$(sget border)
  radius=$(sget radius); density=$(sget density); columns=$(sget columns)
  row_gap=$(sget row_gap); icon_size=$(sget icon_size); prompt=$(sget prompt)
  counter=$(sget counter); scrollbar=$(sget scrollbar)

  # Valores nativos de cada layout. Assim, adicionar controles nao altera o
  # visual que ja estava ativo; "auto" acompanha minimal/spotlight.
  if [ "$layout" = spotlight ]; then
    [ "$ff" = auto ] && ff="Noto Sans"
    [ "$fs" = auto ] && fs=12
    [ "$border" = auto ] && border=1
    [ "$radius" = auto ] && radius=16
    [ "$icon_size" = auto ] && icon_size=26
    [ "$prompt" = auto ] && prompt=native-spotlight
    [ "$counter" = auto ] && counter=false
    element_border=0px
    case "$density" in
      compacta)    input_pad="10px 14px"; input_gap=8;  list_pad="4px";  list_gap=0; item_pad="5px 9px";  item_gap=9 ;;
      confortavel) input_pad="20px 24px"; input_gap=14; list_pad="12px"; list_gap=5; item_pad="12px 16px"; item_gap=16 ;;
      *)           input_pad="16px 20px"; input_gap=12; list_pad="8px";  list_gap=2; item_pad="9px 12px"; item_gap=13 ;;
    esac
  else
    [ "$ff" = auto ] && ff="FiraCode Nerd Font Mono"
    [ "$fs" = auto ] && fs=11
    [ "$border" = auto ] && border=1
    [ "$radius" = auto ] && radius=0
    [ "$icon_size" = auto ] && icon_size=18
    [ "$prompt" = auto ] && prompt=native-minimal
    [ "$counter" = auto ] && counter=true
    element_border="0px 0px 0px 2px"
    case "$density" in
      compacta)    input_pad="7px 10px";  input_gap=6;  list_pad="3px 0px";  list_gap=0; item_pad="3px 10px"; item_gap=8 ;;
      confortavel) input_pad="14px 16px"; input_gap=10; list_pad="10px 0px"; list_gap=3; item_pad="8px 16px"; item_gap=12 ;;
      *)           input_pad="10px 12px"; input_gap=8;  list_pad="6px 0px";  list_gap=0; item_pad="5px 12px"; item_gap=10 ;;
    esac
  fi
  [ "$row_gap" != auto ] && list_gap="$row_gap"
  font_small=$(( fs > 9 ? fs - 2 : 8 ))
  font_list=$(( fs > 9 ? fs - 1 : fs ))
  font_input=$fs
  [ "$layout" = spotlight ] && font_input=$((fs + 1))
  element_radius=$(( radius * 2 / 3 ))

  prompt_enabled=false; prompt_symbol=""; prompt_placeholder=""
  case "$prompt" in
    native-minimal)   prompt_enabled=true;  prompt_symbol="❯" ;;
    native-spotlight) prompt_enabled=false; prompt_placeholder="Buscar" ;;
    shell)  prompt_enabled=true;  prompt_symbol="❯" ;;
    search) prompt_enabled=false; prompt_symbol="⌕"; prompt_placeholder="Buscar aplicativos" ;;
    texto)  prompt_enabled=false; prompt_placeholder="Digite para buscar" ;;
    none)   prompt_enabled=false ;;
  esac
  counter_enabled="$counter"

  win_loc=center; win_anchor=center; xoff=0; yoff=-60
  case "$pos" in
    topo)          win_loc=north;     win_anchor=north;     xoff=0;   yoff=140 ;;
    baixo)         win_loc=south;     win_anchor=south;     xoff=0;   yoff=-70 ;;
    esquerda)      win_loc=west;      win_anchor=west;      xoff=60;  yoff=0 ;;
    direita)       win_loc=east;      win_anchor=east;      xoff=-60; yoff=0 ;;
    sup-esquerda)  win_loc=northwest; win_anchor=northwest; xoff=60;  yoff=60 ;;
    sup-direita)   win_loc=northeast; win_anchor=northeast; xoff=-60; yoff=60 ;;
    inf-esquerda)  win_loc=southwest; win_anchor=southwest; xoff=60;  yoff=-60 ;;
    inf-direita)   win_loc=southeast; win_anchor=southeast; xoff=-60; yoff=-60 ;;
  esac

  # Acento compartilhado: o 'hyprtheme bordas' grava a cor escolhida (ja com
  # o ajuste de brilho) em ~/.config/hypr/accent. Se existir, ela manda —
  # e o launcher fica com a mesma cor do Hyprland e da barra.
  local shared="$HOME/.config/hypr/accent" acc_ov
  if [ -f "$shared" ]; then
    acc_ov=$(grep -oE '#[0-9A-Fa-f]{6}' "$shared" | head -1)
    if [ -n "${acc_ov:-}" ]; then
      # tom claro derivado, mesma regra do hyprtheme
      lit=$(mix "$acc_ov" "#FFFFFF" 70)
    fi
  fi
  bg8="${bgc}$(printf '%02X' $(( op * 255 / 100 )))"
  # Arquivo ACHATADO de proposito (sem @import): com @import o rofi 2.0
  # descarta o layout quando o tema tambem define 'highlight'.
  {
    printf '/* gerado por rofitheme: paleta %s | layout %s\n' "$name" "$layout"
    printf ' * nao edite a mao: rode "rofitheme".\n'
    printf ' * paleta: %s\n' "${PAL/#$HOME/\~}/$name.rasi"
    printf ' * layout: %s\n */\n\n' "${LAY/#$HOME/\~}/$layout.rasi"
    # Um UNICO bloco '*' com tudo: variaveis da paleta, padroes globais e os
    # ajustes @win-*. Blocos repetidos NAO se somam no rofi -- o ultimo
    # substitui o anterior -- por isso nada aqui pode repetir um bloco do layout.
    printf '* {\n'
    # Se ha acento compartilhado, ele substitui o da paleta na hora de
    # emitir (accent e accent-lit). Sem isso o launcher ficaria com uma
    # cor e o resto do desktop com outra.
    if [ -n "${acc_ov:-}" ]; then
      sed -n '/^\* {/,/^}/p' "$PAL/$name.rasi" | sed '1d;$d' \
        | sed -E "s|^(\s*accent:\s*)#[0-9A-Fa-f]{6}|\1${acc_ov}|; \
                  s|^(\s*accent-lit:\s*)#[0-9A-Fa-f]{6}|\1${lit}|"
    else
      sed -n '/^\* {/,/^}/p' "$PAL/$name.rasi" | sed '1d;$d'
    fi
    printf '\n    background-color: transparent;\n'
    printf '    text-color:       @fg;\n'
    printf '\n    /* ajustes persistentes gerados pelo rofitheme */\n'
    printf '    win-width:        %spx;\n' "$w"
    printf '    win-lines:        %s;\n' "$l"
    printf '    win-bg:           %s;\n' "$bg8"
    printf '    win-loc:          %s;\n' "$win_loc"
    printf '    win-anchor:       %s;\n' "$win_anchor"
    printf '    win-xoff:         %spx;\n' "$xoff"
    printf '    win-yoff:         %spx;\n' "$yoff"
    printf '    win-border:       %spx;\n' "$border"
    printf '    win-radius:       %spx;\n' "$radius"
    printf '    win-columns:      %s;\n' "$columns"
    printf '    ui-font:          "%s %s";\n' "$ff" "$fs"
    printf '    input-font:       "%s %s";\n' "$ff" "$font_input"
    printf '    list-font:        "%s %s";\n' "$ff" "$font_list"
    printf '    small-font:       "%s %s";\n' "$ff" "$font_small"
    printf '    input-padding:    %s;\n' "$input_pad"
    printf '    input-spacing:    %spx;\n' "$input_gap"
    printf '    list-padding:     %s;\n' "$list_pad"
    printf '    list-spacing:     %spx;\n' "$list_gap"
    printf '    element-padding:  %s;\n' "$item_pad"
    printf '    element-spacing:  %spx;\n' "$item_gap"
    printf '    element-radius:   %spx;\n' "$element_radius"
    printf '    element-border:   %s;\n' "$element_border"
    printf '    icon-size:        %spx;\n' "$icon_size"
    printf '    prompt-enabled:   %s;\n' "$prompt_enabled"
    printf '    prompt-symbol:    "%s";\n' "$prompt_symbol"
    printf '    prompt-placeholder: "%s";\n' "$prompt_placeholder"
    printf '    counter-enabled:  %s;\n' "$counter_enabled"
    printf '    list-scrollbar:   %s;\n' "$scrollbar"
    printf '    list-cycle:       %s;\n' "$(sget cycle)"
    printf '}\n\n'
    cat "$LAY/$layout.rasi"
    # ULTIMO BLOCO, sempre: 'highlight' aborta o parse do que vier depois,
    # por isso o element-text inteiro e escrito aqui e nao no layout.
    printf '\nelement-text {\n'
    printf '    font:             @list-font;\n'
    printf '    vertical-align:   0.5;\n'
    printf '    background-color: transparent;\n'
    printf '    text-color:       inherit;\n'
    [ -n "$lit" ] && printf '    highlight:        bold %s;\n' "$lit"
    printf '}\n'
  } > "$CUR"
  ensure_conf
  sync_rofi_config
  # Valida de duas formas: o warning explicito do rofi e, principalmente, o
  # tamanho do tema resolvido -- o rofi tambem descarta blocos EM SILENCIO
  # (exit 0, stderr vazio), e ai so o tamanho do dump denuncia.
  local err
  err=$(rofi -dump-theme 2>&1 >/dev/null | grep -i 'failed to parse')
  if [ -n "$err" ]; then printf '  ATENCAO: o rofi nao aceitou o tema:\n  %s\n' "$err"; return 1; fi
  # O rofi mescla o tema sobre o padrao dele, entao contar linhas nao serve:
  # a checagem e se um valor NOSSO chegou ao tema resolvido.
  if ! rofi -dump-theme 2>/dev/null | grep -q 'win-width'; then
    printf '  ATENCAO: o rofi descartou o tema em silencio.\n'
    printf '  Causa comum: a sequencia barra-asterisco dentro de um comentario\n'
    printf '  (o rofi entende como comentario aninhado e engole o resto).\n'
    return 1
  fi
  return 0
}

apply_palette(){
  if [ ! -f "$PAL/$1.rasi" ]; then echo "  paleta '$1' inexistente (rofitheme -l)"; return 1; fi
  printf '%s\n' "$1" > "$STATE"
  rebuild && printf '  paleta: %s  (layout %s)\n' "$1" "$(sget layout)"
}

# ---------- previa: rofi de verdade, em modo dmenu (nao executa nada) ----------
demo(){
  printf 'Firefox\nDBeaver CE\nLibreOffice Writer\nkitty\nwireshark\nnmap\nFilelight\nVLC media player\nGIMP\nObsidian\n' \
    | rofi -dmenu -p apps >/dev/null 2>&1
}

# ---------- previa em texto pro painel do fzf ----------
pv(){ grep -m1 -E "^\s*$2:" "$1" | grep -oE '#[0-9A-Fa-f]{6}'; }

preview_palette(){
  local p="$PAL/$1.rasi"
  [ -f "$p" ] || { echo "sem paleta"; return; }
  local bgc fgc dimc linec acc lit sbg sfg W=44
  bgc=$(pv "$p" bg); fgc=$(pv "$p" fg); dimc=$(pv "$p" dim); linec=$(pv "$p" line)
  acc=$(pv "$p" accent); lit=$(pv "$p" 'accent-lit'); sbg=$(pv "$p" 'sel-bg'); sfg=$(pv "$p" 'sel-fg')

  printf 'paleta   %s\n' "$1"
  printf 'origem   ~/.config/kitty/themes/%s.conf\n\n' "$1"

  local B; B=$(abg "$bgc")
  # linha de busca
  local left="apps ❯ fi" right="7 / 244" pad
  pad=$(( W - ${#left} - ${#right} - 2 ))
  printf '%s%s apps %s❯%s%s fi' "$B" "$(afg "$dimc")" "$(afg "$lit")" "$B" "$(afg "$fgc")"
  printf '%*s' "$pad" ''
  printf '%s%s %s\n' "$(afg "$dimc")" "$right" "$Z"
  # separador
  printf '%s%s%*s%s\n' "$B" "$(afg "$linec")" "$W" '' "$Z" | sed "s/ /─/g"
  # linha selecionada
  local row="LibreOffice Writer"
  printf '%s%s▌%s%s%s%*s%s\n' "$(abg "$sbg")" "$(afg "$acc")" "$(afg "$sfg")" "$row" \
         "$(abg "$sbg")" $(( W - ${#row} - 1 )) '' "$Z"
  # linhas normais
  local r
  for r in "DBeaver CE" "Firefox" "wireshark" "Filelight"; do
    printf '%s%s %s%*s%s\n' "$B" "$(afg "$fgc")" "$r" $(( W - ${#r} - 1 )) '' "$Z"
  done

  printf '\n'
  printf '%s   %s bg %s\n' "$(abg "$bgc")    $Z" '' "$bgc"
  printf '%s   %s fg %s\n' "$(abg "$fgc")    $Z" '' "$fgc"
  printf '%s   %s acento %s\n' "$(abg "$acc")    $Z" '' "$acc"
  printf '%s   %s selecao %s\n' "$(abg "$sbg")    $Z" '' "$sbg"
}

preview_layout(){
  local f="$LAY/$1.rasi"
  [ -f "$f" ] || { echo "sem layout"; return; }
  case "$1" in
    minimal)   echo "minimal — mono, cantos retos, sem icones,";
               echo "          contador N/total, barra no item ativo.";;
    spotlight) echo "spotlight — arredondado, com icones grandes,";
               echo "            item ativo pintado com o acento.";;
    *)         echo "$1";;
  esac
  echo; sed -n '1,6p' "$f"
  echo; grep -E '^\s*(width|border-radius|lines|padding):' "$f" | sed 's/^\s*/  /' | head -8
}

# ---------- configuracao validada (usada pelos menus e pela CLI) ----------
set_value(){
  local key="$1" value="$2"
  case "$key" in
    fonte|font|font-family) key=font_face ;;
    tamanho-fonte|font-size) key=font_size ;;
    borda) key=border ;;
    cantos|raio) key=radius ;;
    densidade) key=density ;;
    colunas) key=columns ;;
    espaco|espacamento) key=row_gap ;;
    tamanho-icone) key=icon_size ;;
    contador) key=counter ;;
    rolagem) key=scrollbar ;;
    busca) key=matching ;;
    ordenacao) key=sorting ;;
    ordenar) key=sort_enabled ;;
    maiusculas) key=case_mode ;;
    tokens) key=tokenize ;;
    circular) key=cycle ;;
    mouse) key=hover ;;
    clique-fora) key=click_exit ;;
    formato) key=drun_format ;;
    largura) key=width ;;
    linhas) key=lines ;;
    posicao) key=pos ;;
    opacidade) key=opacity ;;
    icones) key=icons ;;
  esac
  case "$key" in
    layout) [ -f "$LAY/$value.rasi" ] || { echo "layout invalido: $value" >&2; return 2; } ;;
    width) valid_int "$value" 360 1600 || { echo "largura: use 360..1600" >&2; return 2; } ;;
    lines) valid_int "$value" 3 30 || { echo "linhas: use 3..30" >&2; return 2; } ;;
    pos) case "$value" in centro|topo|baixo|esquerda|direita|sup-esquerda|sup-direita|inf-esquerda|inf-direita) :;; *) echo "posicao invalida: $value" >&2; return 2;; esac ;;
    opacity) valid_int "$value" 40 100 || { echo "opacidade: use 40..100" >&2; return 2; } ;;
    font_face)
      if [ "$value" != auto ] && { [[ "$value" =~ [\;\{\}\"] ]] || [ -z "$value" ]; }; then
        echo "nome de fonte invalido" >&2; return 2
      fi ;;
    font_size) [ "$value" = auto ] || valid_int "$value" 8 28 || { echo "tamanho da fonte: auto ou 8..28" >&2; return 2; } ;;
    border) [ "$value" = auto ] || valid_int "$value" 0 8 || { echo "borda: auto ou 0..8" >&2; return 2; } ;;
    radius) [ "$value" = auto ] || valid_int "$value" 0 48 || { echo "cantos: auto ou 0..48" >&2; return 2; } ;;
    density) case "$value" in compacta|normal|confortavel) :;; *) echo "densidade: compacta, normal ou confortavel" >&2; return 2;; esac ;;
    columns) valid_int "$value" 1 4 || { echo "colunas: use 1..4" >&2; return 2; } ;;
    row_gap) [ "$value" = auto ] || valid_int "$value" 0 20 || { echo "espacamento: auto ou 0..20" >&2; return 2; } ;;
    icon_size) [ "$value" = auto ] || valid_int "$value" 12 64 || { echo "icone: auto ou 12..64" >&2; return 2; } ;;
    prompt) case "$value" in auto|shell|search|texto|none) :;; *) echo "prompt: auto, shell, search, texto ou none" >&2; return 2;; esac ;;
    counter) [ "$value" = auto ] || valid_bool "$value" || { echo "contador: auto, true ou false" >&2; return 2; } ;;
    scrollbar|sort_enabled|tokenize|cycle|hover|click_exit) valid_bool "$value" || { echo "$key: use true ou false" >&2; return 2; } ;;
    matching) case "$value" in normal|regex|glob|fuzzy|prefix) :;; *) echo "busca: normal, regex, glob, fuzzy ou prefix" >&2; return 2;; esac ;;
    sorting) case "$value" in fzf|levenshtein) :;; *) echo "ordenacao: fzf ou levenshtein" >&2; return 2;; esac ;;
    case_mode) case "$value" in ignore|smart|sensitive) :;; *) echo "maiusculas: ignore, smart ou sensitive" >&2; return 2;; esac ;;
    drun_format) case "$value" in name|generic|exec) :;; *) echo "formato: name, generic ou exec" >&2; return 2;; esac ;;
    icons) valid_bool "$value" || { echo "icones: use true ou false" >&2; return 2; }; set_icons "$value"; return 0 ;;
    *) echo "chave desconhecida: $key" >&2; return 2 ;;
  esac
  sset "$key" "$value"
}

apply_setting(){
  local key="$1" value="$2" label="${3:-$1}"
  set_value "$key" "$value" || return
  rebuild && printf '  %s: %s\n' "$label" "$value"
}

pick_bool(){
  local prompt="$1" current="$2" sel
  sel=$(printf 'true\tligado\nfalse\tdesligado' | FZF --delimiter=$'\t' --with-nth=1,2 \
      --prompt="$prompt (agora: $current) > " --header='ENTER escolhe   ESC volta')
  [ -n "${sel:-}" ] && printf '%s' "${sel%%$'\t'*}"
}

pick_number(){
  local values="$1" prompt="$2" header="$3" sel
  sel=$(printf '%b' "$values" | FZF --prompt="$prompt > " --header="$header")
  [ -n "${sel:-}" ] && printf '%s' "${sel%% *}"
}

# ---------- pickers ----------
pick_palette(){
  [ -z "$(palettes)" ] && gen_palettes
  local sel; sel=$(palettes | FZF --prompt='paleta > ' \
      --preview "$SELF __prev {1}" --preview-window='right,58%,border-left' \
      --header='ENTER aplica e abre o launcher pra ver   ESC volta')
  [ -z "${sel:-}" ] && return 0
  apply_palette "$sel" && demo
}

pick_layout(){
  local sel; sel=$(layouts | FZF --prompt='layout > ' \
      --preview "$SELF __lprev {1}" --preview-window='right,58%,border-left' \
      --header='estrutura da janela   ENTER aplica')
  [ -z "${sel:-}" ] && return 0
  sset layout "$sel"
  # spotlight combina com icones; minimal e texto puro
  case "$sel" in
    spotlight) set_icons true;;
    minimal)   set_icons false;;
  esac
  rebuild && printf '  layout: %s\n' "$sel" && demo
}

pick_width(){
  local v; v=$(pick_number '420  muito estreito\n480  estreito\n560  equilibrado\n640\n720\n800  largo\n960  muito largo\n' \
      'largura' "atual: $(sget width)px | largura da janela")
  [ -n "${v:-}" ] && apply_setting width "$v" largura
}

pick_lines(){
  local v; v=$(pick_number '4\n6\n8\n10  equilibrado\n12\n14\n16\n20\n24\n' \
      'linhas' "atual: $(sget lines) | resultados visiveis por coluna")
  [ -n "${v:-}" ] && apply_setting lines "$v" linhas
}

pick_opacidade(){
  local o; o=$(pick_number '100  opaco\n97\n94\n90\n85\n78\n70\n60\n' \
      'opacidade' "atual: $(sget opacity)% | transparencia da janela")
  [ -n "${o:-}" ] && apply_setting opacity "$o" opacidade
}

pick_posicao(){
  local p; p=$(printf '%s\n' \
      'centro          no meio, levemente acima' \
      'topo            centro superior' \
      'baixo           centro inferior' \
      'esquerda        meio da lateral esquerda' \
      'direita         meio da lateral direita' \
      'sup-esquerda    canto superior esquerdo' \
      'sup-direita     canto superior direito' \
      'inf-esquerda    canto inferior esquerdo' \
      'inf-direita     canto inferior direito' \
      | FZF --prompt='posicao > ' --header="atual: $(sget pos) | 9 pontos de ancoragem")
  [ -z "${p:-}" ] && return 0
  apply_setting pos "${p%% *}" posicao
}

window_menu(){
  while true; do
    local c; c=$(printf '%s\n' \
      "largura\t$(sget width)px" "linhas\t$(sget lines)" \
      "posicao\t$(sget pos)" "opacidade\t$(sget opacity)%" "voltar\tmenu principal" \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='janela > ' \
        --header='tamanho, quantidade de resultados e local da janela')
    case "${c%%$'\t'*}" in
      largura) pick_width;; linhas) pick_lines;; posicao) pick_posicao;;
      opacidade) pick_opacidade;; voltar|"") break;;
    esac
  done
}

pick_font_face(){
  local sel
  sel=$({ printf 'auto\tfonte original do layout\n'
          fc-list : family 2>/dev/null | cut -d: -f2- | tr ',' '\n' \
            | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed '/^$/d' | sort -fu \
            | sed 's/$/\tinstalada/'; } \
        | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='fonte > ' \
          --header="atual: $(sget font_face) | busca todas as fontes instaladas")
  [ -n "${sel:-}" ] && apply_setting font_face "${sel%%$'\t'*}" fonte
}

pick_font_size(){
  local v; v=$(pick_number 'auto  tamanho original do layout\n8\n9\n10\n11\n12\n13\n14\n16\n18\n20\n22\n24\n28\n' \
      'tamanho' "atual: $(sget font_size) | tamanho base em pontos")
  [ -n "${v:-}" ] && apply_setting font_size "$v" tamanho-da-fonte
}

font_menu(){
  while true; do
    local c; c=$(printf '%s\n' "familia\t$(sget font_face)" "tamanho\t$(sget font_size)" "voltar\tmenu principal" \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='tipografia > ' \
        --header='a fonte vale para busca, resultados, contador e mensagens')
    case "${c%%$'\t'*}" in familia) pick_font_face;; tamanho) pick_font_size;; voltar|"") break;; esac
  done
}

pick_border(){
  local v; v=$(pick_number 'auto  original do layout\n0  sem borda\n1  fina\n2\n3\n4  forte\n6\n8\n' \
      'borda' "atual: $(sget border) | espessura em px")
  [ -n "${v:-}" ] && apply_setting border "$v" borda
}

pick_radius(){
  local v; v=$(pick_number 'auto  original do layout\n0  quadrado\n4\n8\n12\n16\n20\n24\n32\n40\n48  bem redondo\n' \
      'cantos' "atual: $(sget radius) | raio em px")
  [ -n "${v:-}" ] && apply_setting radius "$v" cantos
}

frame_menu(){
  while true; do
    local c; c=$(printf '%s\n' "borda\t$(sget border)" "cantos\t$(sget radius)" "voltar\tmenu principal" \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='moldura > ' \
        --header='contorno externo e arredondamento da janela e dos itens')
    case "${c%%$'\t'*}" in borda) pick_border;; cantos) pick_radius;; voltar|"") break;; esac
  done
}

pick_density(){
  local v; v=$(printf 'compacta\tmais resultados em menos espaco\nnormal\tequilibrada, visual original\nconfortavel\tlinhas altas e mais respiro' \
    | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='densidade > ' --header="atual: $(sget density)")
  [ -n "${v:-}" ] && apply_setting density "${v%%$'\t'*}" densidade
}

pick_columns(){
  local v; v=$(pick_number '1  lista tradicional\n2  grade larga\n3\n4  grade densa\n' \
      'colunas' "atual: $(sget columns) | aumente a largura para 2 ou mais")
  [ -n "${v:-}" ] && apply_setting columns "$v" colunas
}

pick_row_gap(){
  local v; v=$(pick_number 'auto  acompanha a densidade\n0  sem espaco\n1\n2\n3\n4\n6\n8\n12\n16\n20\n' \
      'espacamento' "atual: $(sget row_gap) | distancia vertical em px")
  [ -n "${v:-}" ] && apply_setting row_gap "$v" espacamento
}

pick_scrollbar(){
  local v; v=$(pick_bool 'barra de rolagem' "$(sget scrollbar)")
  [ -n "${v:-}" ] && apply_setting scrollbar "$v" barra-de-rolagem
}

pick_counter(){
  local v; v=$(printf 'auto\tsegue o layout\ntrue\tmostra filtrados/total\nfalse\tesconde o contador' \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='contador > ' --header="atual: $(sget counter)")
  [ -n "${v:-}" ] && apply_setting counter "${v%%$'\t'*}" contador
}

pick_icon_size(){
  local v; v=$(pick_number 'auto  original do layout\n12\n16\n18\n20\n24\n26\n32\n40\n48\n56\n64\n' \
      'icone' "atual: $(sget icon_size) | tamanho em px")
  [ -n "${v:-}" ] && apply_setting icon_size "$v" tamanho-do-icone
}

grid_menu(){
  while true; do
    local c; c=$(printf '%s\n' \
      "densidade\t$(sget density)" "colunas\t$(sget columns)" "espacamento\t$(sget row_gap)" \
      "rolagem\t$(sget scrollbar)" "contador\t$(sget counter)" "tamanho-icone\t$(sget icon_size)" \
      "voltar\tmenu principal" | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='grade > ' \
      --header='densidade, colunas, separacao, scrollbar e escala dos icones')
    case "${c%%$'\t'*}" in
      densidade) pick_density;; colunas) pick_columns;; espacamento) pick_row_gap;;
      rolagem) pick_scrollbar;; contador) pick_counter;; tamanho-icone) pick_icon_size;;
      voltar|"") break;;
    esac
  done
}

pick_prompt(){
  local v; v=$(printf '%s\n' \
      $'auto\tvisual original do layout' \
      $'shell\tmostra o modo e o simbolo ❯' \
      $'search\tlupa e texto "Buscar aplicativos"' \
      $'texto\tapenas "Digite para buscar"' \
      $'none\tcampo completamente limpo' \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='prompt > ' --header="atual: $(sget prompt)")
  [ -n "${v:-}" ] && apply_setting prompt "${v%%$'\t'*}" prompt
}

pick_drun_format(){
  local v; v=$(printf '%s\n' \
      $'name\tsomente o nome do aplicativo' \
      $'generic\tnome e descricao curta' \
      $'exec\tnome e comando executado' \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='texto do item > ' --header="atual: $(sget drun_format)")
  [ -n "${v:-}" ] && apply_setting drun_format "${v%%$'\t'*}" formato-dos-aplicativos
}

prompt_menu(){
  while true; do
    local c; c=$(printf '%s\n' "estilo\t$(sget prompt)" "formato\t$(sget drun_format)" "voltar\tmenu principal" \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='campo de busca > ' \
        --header='texto do campo e informacao exibida em cada aplicativo')
    case "${c%%$'\t'*}" in estilo) pick_prompt;; formato) pick_drun_format;; voltar|"") break;; esac
  done
}

pick_matching(){
  local v; v=$(printf '%s\n' \
      $'fuzzy\tencontra letras fora de sequencia exata' \
      $'normal\tbusca simples por texto' \
      $'prefix\tresultado precisa comecar pelo texto' \
      $'regex\texpressoes regulares' \
      $'glob\tpadroes com asterisco e interrogacao' \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='algoritmo > ' --header="atual: $(sget matching)")
  [ -n "${v:-}" ] && apply_setting matching "${v%%$'\t'*}" algoritmo-de-busca
}

pick_sort_enabled(){
  local v; v=$(pick_bool 'reordenar resultados' "$(sget sort_enabled)")
  [ -n "${v:-}" ] && apply_setting sort_enabled "$v" ordenar-resultados
}

pick_sorting(){
  local v; v=$(printf '%s\n' \
      $'fzf\tprioriza o melhor encaixe fuzzy' \
      $'levenshtein\tdistancia de edicao tradicional' \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='ordenacao > ' --header="atual: $(sget sorting)")
  [ -n "${v:-}" ] && apply_setting sorting "${v%%$'\t'*}" metodo-de-ordenacao
}

pick_case_mode(){
  local v; v=$(printf '%s\n' \
      $'ignore\tignora maiusculas e minusculas' \
      $'smart\tdiferencia somente se voce digitar maiuscula' \
      $'sensitive\tsempre diferencia maiusculas' \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='maiusculas > ' --header="atual: $(sget case_mode)")
  [ -n "${v:-}" ] && apply_setting case_mode "${v%%$'\t'*}" maiusculas
}

pick_tokenize(){
  local v; v=$(pick_bool 'buscar cada palavra separadamente' "$(sget tokenize)")
  [ -n "${v:-}" ] && apply_setting tokenize "$v" busca-por-palavras
}

search_menu(){
  while true; do
    local c; c=$(printf '%s\n' \
      "algoritmo\t$(sget matching)" "ordenar\t$(sget sort_enabled)" \
      "metodo\t$(sget sorting)" "maiusculas\t$(sget case_mode)" \
      "palavras\t$(sget tokenize)" "voltar\tmenu principal" \
      | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='busca > ' \
        --header='como o texto digitado encontra e ordena aplicativos')
    case "${c%%$'\t'*}" in
      algoritmo) pick_matching;; ordenar) pick_sort_enabled;; metodo) pick_sorting;;
      maiusculas) pick_case_mode;; palavras) pick_tokenize;; voltar|"") break;;
    esac
  done
}

pick_cycle(){
  local v; v=$(pick_bool 'navegacao circular' "$(sget cycle)")
  [ -n "${v:-}" ] && apply_setting cycle "$v" navegacao-circular
}

pick_hover(){
  local v; v=$(pick_bool 'selecionar ao passar o mouse' "$(sget hover)")
  [ -n "${v:-}" ] && apply_setting hover "$v" selecao-com-mouse
}

pick_click_exit(){
  local v; v=$(pick_bool 'fechar ao clicar fora' "$(sget click_exit)")
  [ -n "${v:-}" ] && apply_setting click_exit "$v" clique-fora
}

interaction_menu(){
  while true; do
    local c; c=$(printf '%s\n' \
      "circular\t$(sget cycle)" "mouse\t$(sget hover)" "clique-fora\t$(sget click_exit)" \
      "voltar\tmenu principal" | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='interacao > ' \
      --header='comportamento de teclado, ponteiro e fechamento')
    case "${c%%$'\t'*}" in
      circular) pick_cycle;; mouse) pick_hover;; clique-fora) pick_click_exit;; voltar|"") break;;
    esac
  done
}

set_icons(){ # true|false
  if grep -qE '^\s*show-icons:' "$RCONF"; then
    sed -i -E "s|^(\s*)show-icons:.*|\1show-icons:             $1;|" "$RCONF"
  else
    sed -i "0,/^configuration {/s||configuration {\n    show-icons:             $1;|" "$RCONF"
  fi
}
icons_state(){ grep -m1 -oE 'show-icons:\s*(true|false)' "$RCONF" 2>/dev/null | awk '{print $2}'; }
toggle_icones(){
  local cur; cur=$(icons_state)
  local sel; sel=$(printf 'nao   texto puro, cara de terminal\nsim   mostra o icone de cada app' \
      | FZF --prompt="icones (agora: ${cur:-?}) > " --header='icones na lista de resultados')
  [ -z "${sel:-}" ] && return 0
  case "${sel%% *}" in sim) set_icons true;; nao) set_icons false;; esac
  printf '  icones: %s\n' "$(icons_state)"; demo
}

sync_hypr(){
  local h; h=$(cat "$HOME/.config/hypr/themes/.active" 2>/dev/null)
  if [ -z "$h" ]; then echo "  o Hyprland nao tem tema global ativo"; return 1; fi
  [ "$h" = sddm-terminal-red ] && h=terminal-red
  [ -f "$PAL/$h.rasi" ] || gen_palettes >/dev/null
  apply_palette "$h" && printf '  sincronizado com o tema global do Hyprland (%s)\n' "$h"
}

show_config(){
  echo
  printf 'paleta          %s\n' "$(cat "$STATE" 2>/dev/null || echo '-')"
  printf 'layout          %s\n' "$(sget layout)"
  printf 'janela          %spx | %s linhas | %s | %s%%\n' "$(sget width)" "$(sget lines)" "$(sget pos)" "$(sget opacity)"
  printf 'fonte           %s | tamanho %s\n' "$(sget font_face)" "$(sget font_size)"
  printf 'moldura         borda %s | cantos %s\n' "$(sget border)" "$(sget radius)"
  printf 'grade           %s | %s coluna(s) | gap %s\n' "$(sget density)" "$(sget columns)" "$(sget row_gap)"
  printf 'lista           rolagem %s | contador %s\n' "$(sget scrollbar)" "$(sget counter)"
  printf 'icones          %s | tamanho %s\n' "$(icons_state)" "$(sget icon_size)"
  printf 'prompt          %s | itens %s\n' "$(sget prompt)" "$(sget drun_format)"
  printf 'busca           %s | ordenar %s/%s | caso %s | tokens %s\n' \
    "$(sget matching)" "$(sget sort_enabled)" "$(sget sorting)" "$(sget case_mode)" "$(sget tokenize)"
  printf 'interacao       circular %s | mouse %s | clique-fora %s\n' \
    "$(sget cycle)" "$(sget hover)" "$(sget click_exit)"
  printf 'kitty           %s\n' "$(cat "$KTD/.active" 2>/dev/null || echo '-')"
  printf 'atalho          SUPER + ESPAÇO\n'
  if [ "${1:-pause}" = pause ]; then echo; read -rp "  [enter] " _; fi
}

reset_settings(){
  local pair
  for pair in \
    'width=560' 'lines=10' 'pos=centro' 'opacity=100' \
    'font_face=auto' 'font_size=auto' 'border=auto' 'radius=auto' \
    'density=normal' 'columns=1' 'row_gap=auto' 'icon_size=auto' \
    'prompt=auto' 'counter=auto' 'scrollbar=false' 'matching=fuzzy' \
    'sort_enabled=true' 'sorting=fzf' 'case_mode=ignore' 'tokenize=true' \
    'cycle=true' 'hover=true' 'click_exit=true' 'drun_format=name'; do
    sset "${pair%%=*}" "${pair#*=}"
  done
  if [ "$(sget layout)" = spotlight ]; then set_icons true; else set_icons false; fi
  rebuild && printf '  ajustes do Rofi restaurados; paleta e layout foram mantidos\n'
}

confirm_reset(){
  local c; c=$(printf 'cancelar\tnao altera nada\nrestaurar\tmantem paleta e layout' \
    | FZF --delimiter=$'\t' --with-nth=1,2 --prompt='restaurar > ' \
      --header='volta tamanho, fontes, grade, busca e comportamento ao padrao')
  [ "${c%%$'\t'*}" = restaurar ] && reset_settings
}

main_menu(){
  if ! have fzf; then echo "instale o fzf pro menu, ou use: rofitheme <paleta>"; palettes; return; fi
  while true; do
    local c; c=$(printf '%s\n' \
      "paleta         as cores compartilhadas do tema global" \
      "layout         minimal (mono) ou spotlight (arredondado)" \
      "janela         tamanho, linhas, posicao e transparencia" \
      "tipografia     familia e tamanho da fonte" \
      "moldura        espessura da borda e cantos" \
      "grade          densidade, colunas, espacamento e rolagem" \
      "prompt         campo de busca e texto dos resultados" \
      "busca          algoritmo, ordem, maiusculas e palavras" \
      "interacao      teclado, mouse e clique fora" \
      "icones         liga/desliga icone dos apps" \
      "sync           seguir o tema global do Hyprland" \
      "testar         abrir o launcher pra ver" \
      "config         ver a configuracao atual" \
      "restaurar      volta os ajustes sem trocar paleta/layout" \
      "sair" \
      | FZF --prompt='rofi > ' --height=86% --header='central completa de personalizacao do launcher')
    case "${c%% *}" in
      paleta) pick_palette ;;
      layout) pick_layout ;;
      janela) window_menu ;;
      tipografia) font_menu ;;
      moldura) frame_menu ;;
      grade) grid_menu ;;
      prompt) prompt_menu ;;
      busca) search_menu ;;
      interacao) interaction_menu ;;
      icones) toggle_icones ;;
      sync) sync_hypr ;;
      testar) demo ;;
      config) show_config ;;
      restaurar) confirm_reset ;;
      sair|"") break ;;
    esac
  done
}

usage(){
  cat <<'EOF'
rofitheme                       abre a central visual
rofitheme <paleta>              aplica uma paleta
rofitheme paleta|layout|janela|fonte|moldura|grade
rofitheme prompt|busca|comportamento|icones
rofitheme testar|sync|status|reset

Configuracao direta (para scripts e para o visualconf):
  rofitheme set CHAVE VALOR [CHAVE VALOR ...]
  rofitheme get CHAVE

Chaves: layout width lines pos opacity font_face font_size border radius
        density columns row_gap icon_size prompt counter scrollbar icons
        matching sort_enabled sorting case_mode tokenize cycle hover
        click_exit drun_format

Exemplos:
  rofitheme set font_face "JetBrainsMono Nerd Font" font_size 13
  rofitheme set border 2 radius 18 density confortavel
  rofitheme set columns 2 row_gap 4 scrollbar true
  rofitheme set matching fuzzy case_mode smart tokenize true
EOF
}

cli_set(){
  [ "$#" -gt 0 ] && [ $(( $# % 2 )) -eq 0 ] || {
    echo 'uso: rofitheme set CHAVE VALOR [CHAVE VALOR ...]' >&2; return 2; }
  while [ "$#" -gt 0 ]; do
    set_value "$1" "$2" || return
    shift 2
  done
  rebuild && printf '  configuracao do Rofi atualizada\n'
}

get_value(){
  case "$1" in
    palette|paleta) cat "$STATE" 2>/dev/null ;;
    icons|icones) icons_state ;;
    *) sget "$1" ;;
  esac
}

# ---------- CLI ----------
seed_state
case "${1:-}" in
  __prev)  preview_palette "$2" ;;
  __lprev) preview_layout  "$2" ;;
  -l|--list)   palettes ;;
  -g|--gerar)  gen_palettes ;;
  -r|--random) t=$(palettes | shuf -n1); apply_palette "$t" ;;
  -h|--help|help|ajuda) usage ;;
  paleta|tema|cores) pick_palette ;;
  layout)
    if [ -n "${2:-}" ]; then
      if set_value layout "$2"; then
        if [ "$2" = spotlight ]; then set_icons true; else set_icons false; fi
        rebuild && echo "  layout: $2"
      fi
    else pick_layout; fi ;;
  janela|aparencia) window_menu ;;
  largura)     if [ -n "${2:-}" ]; then apply_setting width "$2" largura; else pick_width; fi ;;
  linhas)      if [ -n "${2:-}" ]; then apply_setting lines "$2" linhas; else pick_lines; fi ;;
  opacidade|transp*) if [ -n "${2:-}" ]; then apply_setting opacity "$2" opacidade; else pick_opacidade; fi ;;
  posicao)     if [ -n "${2:-}" ]; then apply_setting pos "$2" posicao; else pick_posicao; fi ;;
  fonte|tipografia)
    if [ -n "${2:-}" ]; then
      set_value font_face "$2" && { [ -z "${3:-}" ] || set_value font_size "$3"; } \
        && rebuild && echo "  fonte: $2 ${3:-}"
    else font_menu; fi ;;
  moldura)
    if [ -n "${2:-}" ]; then
      set_value border "$2" && { [ -z "${3:-}" ] || set_value radius "$3"; } \
        && rebuild && echo "  moldura: borda $2 | cantos ${3:-$(sget radius)}"
    else frame_menu; fi ;;
  grade)       grid_menu ;;
  densidade)  if [ -n "${2:-}" ]; then apply_setting density "$2" densidade; else pick_density; fi ;;
  colunas)     if [ -n "${2:-}" ]; then apply_setting columns "$2" colunas; else pick_columns; fi ;;
  espacamento|gap) if [ -n "${2:-}" ]; then apply_setting row_gap "$2" espacamento; else pick_row_gap; fi ;;
  prompt)      if [ -n "${2:-}" ]; then apply_setting prompt "$2" prompt; else prompt_menu; fi ;;
  busca)       if [ -n "${2:-}" ]; then apply_setting matching "$2" busca; else search_menu; fi ;;
  comportamento|interacao) interaction_menu ;;
  icones)      if [ -n "${2:-}" ]; then set_value icons "$2" && echo "  icones: $2"; else toggle_icones; fi ;;
  set)         shift; cli_set "$@" ;;
  get)         if [ -n "${2:-}" ]; then get_value "$2"; else echo 'uso: rofitheme get CHAVE' >&2; exit 2; fi ;;
  status)      show_config plain ;;
  reset|restaurar) reset_settings ;;
  sync)        sync_hypr ;;
  testar|demo|preview) demo ;;
  config)      show_config ;;
  "")          if have visualconf; then exec visualconf rofi; else main_menu; fi ;;
  *)  if [ -f "$PAL/$1.rasi" ]; then apply_palette "$1"
      else echo "opcao ou paleta '$1' invalida"; main_menu; fi ;;
esac
