#!/usr/bin/env bash
# =====================================================================
#  control-center — o "Configurações do Sistema" do Hyprland, em rofi.
#
#  Junta num lugar so o que no KDE ficava espalhado: rede, som,
#  bluetooth, telas, aparencia e as ferramentas de rede/seguranca.
#
#  So oferece o que esta instalado: cada item e testado antes de entrar
#  no menu, entao nunca aparece opcao que abre e falha.
#
#  Carregar sem executar, para teste:  CC_LIB=1 source control-center
# =====================================================================
set -u

have(){ command -v "$1" >/dev/null 2>&1; }

# Segue o idioma do Hyprism ('hyprism lang en|pt').
LANGX=$(grep -m1 '^lang=' "$HOME/.config/hypr/themes/.state" 2>/dev/null | cut -d= -f2-)
[ "$LANGX" = en ] || LANGX=pt
L(){ [ "$LANGX" = en ] && printf '%s' "$2" || printf '%s' "$1"; }   # L "pt" "en"
term(){ setsid kitty -e "$@" >/dev/null 2>&1 < /dev/null & }
gui(){  setsid "$@" >/dev/null 2>&1 < /dev/null & }

I_NET=$''; I_WIFI=$''; I_SOM=$''; I_BT=$''
I_TELA=$''; I_COR=$''; I_SEG=$''; I_SIS=$''

# Cada linha: "icone|rotulo|comando|tipo"   tipo = gui | term
itens(){
  # ---- Hyprism (a central visual: aparencia de tudo num lugar so) ----
  have visualconf && echo "$I_COR|Hyprism|visualconf|term"

  # ---- rede ----
  echo "$I_WIFI|$(L "Wi-Fi: conectar, salvar, esquecer" "Wi-Fi: connect, save, forget")|wifi-menu|gui"
  have nm-connection-editor && \
    echo "$I_NET|$(L "Rede: VPN, 802.1X, IP fixo, rotas" "Network: VPN, 802.1X, static IP, routes")|nm-connection-editor|gui"
  have nmtui && echo "$I_NET|$(L "Rede no terminal (nmtui)" "Network in the terminal (nmtui)")|nmtui|term"
  have wavemon && echo "$I_WIFI|$(L "Monitor de sinal Wi-Fi (wavemon)" "Wi-Fi signal monitor (wavemon)")|wavemon|term"

  # ---- som ----
  have pavucontrol && echo "$I_SOM|$(L "Som: volume, entradas e saidas" "Sound: volume, inputs and outputs")|pavucontrol|gui"
  have wiremix && echo "$I_SOM|$(L "Som no terminal (wiremix)" "Sound in the terminal (wiremix)")|wiremix|term"

  # ---- bluetooth ----
  have blueman-manager && echo "$I_BT|Bluetooth|blueman-manager|gui"
  have bluetuith && echo "$I_BT|$(L "Bluetooth no terminal" "Bluetooth in the terminal")|bluetuith|term"
  { ! have blueman-manager && have bluetoothctl; } && \
    echo "$I_BT|Bluetooth (bluetoothctl)|bluetoothctl|term"

  # ---- telas ----
  have nwg-displays && echo "$I_TELA|$(L "Telas: posicao e resolucao" "Displays: position and resolution")|nwg-displays|gui"
  have wdisplays && echo "$I_TELA|$(L "Telas (wdisplays)" "Displays (wdisplays)")|wdisplays|gui"

  # ---- aparencia ----
  # O Hyprism (visualconf) ja esta no topo do menu; aqui ficam apenas os
  # configuradores avulsos, para quando o Hyprism nao estiver instalado.
  if ! have visualconf; then
    have hyprtheme  && echo "$I_COR|$(L "Aparencia do Hyprland (hyprtheme)" "Hyprland appearance (hyprtheme)")|hyprtheme|term"
    have rofitheme  && echo "$I_COR|$(L "Aparencia do launcher (rofitheme)" "Launcher appearance (rofitheme)")|rofitheme|term"
    have kittytheme && echo "$I_COR|$(L "Aparencia do terminal (kittytheme)" "Terminal appearance (kittytheme)")|kittytheme|term"
  fi
  have qt6ct      && echo "$I_COR|$(L "Tema dos aplicativos Qt (qt6ct)" "Qt app theme (qt6ct)")|qt6ct|gui"
  have nwg-look   && echo "$I_COR|$(L "Tema dos aplicativos GTK (nwg-look)" "GTK app theme (nwg-look)")|nwg-look|gui"

  # ---- rede e seguranca ----
  have wireshark  && echo "$I_SEG|$(L "Wireshark: captura de pacotes" "Wireshark: packet capture")|wireshark|gui"
  have etherape   && echo "$I_SEG|$(L "EtherApe: trafego ao vivo" "EtherApe: live traffic")|etherape|gui"
  have termshark  && echo "$I_SEG|$(L "Termshark (wireshark no terminal)" "Termshark (wireshark in the terminal)")|termshark|term"
  have kismet     && echo "$I_SEG|$(L "Kismet: varredura de Wi-Fi" "Kismet: Wi-Fi scanning")|kismet|term"
  have zaproxy    && echo "$I_SEG|$(L "OWASP ZAP: seguranca web" "OWASP ZAP: web security")|zaproxy|gui"
  have burpsuite  && echo "$I_SEG|Burp Suite|burpsuite|gui"
  have bandwhich  && echo "$I_SEG|$(L "Banda por processo (bandwhich)" "Bandwidth per process (bandwhich)")|sudo bandwhich|term"
  have iftop      && echo "$I_SEG|$(L "Trafego por conexao (iftop)" "Traffic per connection (iftop)")|sudo iftop|term"
  have nethogs    && echo "$I_SEG|$(L "Trafego por processo (nethogs)" "Traffic per process (nethogs)")|sudo nethogs|term"
  have gping      && echo "$I_SEG|$(L "Ping com grafico (gping)" "Ping with a graph (gping)")|gping 1.1.1.1|term"
  have mtr        && echo "$I_SEG|$(L "Rota ate um destino (mtr)" "Route to a host (mtr)")|mtr 1.1.1.1|term"

  # ---- sistema ----
  have btop      && echo "$I_SIS|$(L "Monitor do sistema (btop)" "System monitor (btop)")|btop|term"
  have hyprlock  && echo "$I_SIS|$(L "Bloquear a tela" "Lock the screen")|hyprlock|gui"
}

main(){
  local -a rot cmd tipo
  while IFS='|' read -r ic label c t; do
    [ -z "${label:-}" ] && continue
    rot+=("$ic  $label")
    cmd+=("$c")
    tipo+=("$t")
  done < <(itens)

  [ "${#rot[@]}" -eq 0 ] && { echo "$(L "nada instalado para mostrar" "nothing installed to show")"; exit 1; }

  local i
  i=$(printf '%s\n' "${rot[@]}" | rofi -dmenu -i -no-custom -format i -p "Hyprism")
  [ -z "${i:-}" ] && exit 0

  # shellcheck disable=SC2086
  if [ "${tipo[$i]}" = "term" ]; then term ${cmd[$i]}; else gui ${cmd[$i]}; fi
}

[ -n "${CC_LIB:-}" ] || main "$@"
