#!/usr/bin/env python3
# =====================================================================
#  hyprism-appmenu — emit the Hyprism desktop menu in jgmenu format.
#
#  Piped into jgmenu by hyprism-desktop on a desktop right-click:
#     hyprism-appmenu | jgmenu --simple --config-file ~/.config/jgmenu/jgmenurc
#
#  jgmenu draws the BlackArch/fluxbox-style cascading menu; the colors come
#  from ~/.config/jgmenu/jgmenurc, which Hyprism generates from the active
#  palette (so the menu always follows the system profile). Content:
#    Applications (freedesktop categories) · BlackArch (by specialty) ·
#    Hyprism (config) · Terminals · Browsers.
#
#  Only installed tools/apps appear. English labels.
# =====================================================================
import re
import shutil
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio  # noqa: E402


def run(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True).stdout
    except OSError:
        return ""


# ---- data: installed blackarch tools by group ------------------------
def load_groups():
    installed = set(run(["pacman", "-Qq"]).split())
    names = sorted({
        line.split()[0] for line in run(["pacman", "-Sg"]).splitlines()
        if line.startswith("blackarch-")
    })
    groups = {}
    if names:
        for line in run(["pacman", "-Sg"] + names).splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1] in installed:
                groups.setdefault(parts[0], []).append(parts[1])
    for g in groups:
        groups[g].sort()
    return groups


GROUPS = load_groups()


def group_tools(group):
    return GROUPS.get(group, [])


SPECIALTIES = [
    ("Recon & OSINT",          ["recon", "fingerprint", "scanner", "social", "database"]),
    ("Web & Apps",             ["webapp", "code-audit", "fuzzer", "proxy", "mobile"]),
    ("Exploitation & Access",  ["exploitation", "backdoor", "dos", "malware", "keylogger", "honeypot"]),
    ("Networks & Wireless",    ["networking", "wireless", "bluetooth", "sniffer", "spoof", "tunnel", "nfc", "voip"]),
    ("Reversing & Binary",     ["reversing", "binary", "debugger", "disassembler", "decompiler", "packer", "unpacker"]),
    ("Forensics & Defense",    ["forensic", "anti-forensic", "defensive", "ids", "threat-model", "stego"]),
    ("Hardware & Radio",       ["hardware", "radio", "firmware", "drone", "automobile", "gpu"]),
    ("Crypto & Wordlists",     ["crypto", "cracker", "wordlist"]),
    ("Misc",                   ["automation", "ai", "config", "windows", "misc"]),
]
GUI_APPS = {"wireshark", "zaproxy", "burpsuite", "ghidra", "cutter", "jd-gui",
            "ettercap-graphical", "zenmap", "remmina", "zenmap"}

APPEARANCE = [
    ("Palette", "palette"), ("Wallpaper", "wallpaper"), ("Bar & style", "style"),
    ("Bar modules", "modules"), ("Cursor", "cursor"), ("Effects", "effects"),
    ("Animations", "animations"), ("Borders", "borders"), ("Lock screen", "lock"),
    ("Notifications", "notifications"), ("Font", "font"),
]
TERMINALS = ["kitty", "alacritty", "foot", "wezterm", "konsole", "gnome-terminal", "xterm", "st"]
BROWSERS = ["firefox", "librewolf", "chromium", "google-chrome-stable", "brave",
            "brave-browser", "vivaldi-stable", "qutebrowser", "tor-browser", "epiphany"]

MAIN_CATS = [
    ("Office", {"Office"}), ("Internet", {"Network"}),
    ("Multimedia", {"AudioVideo", "Audio", "Video"}), ("Graphics", {"Graphics"}),
    ("Development", {"Development"}), ("Games", {"Game"}),
    ("Utilities", {"Utility", "Accessories"}), ("System", {"System", "Settings"}),
    ("Education", {"Education", "Science"}),
]


def app_categories():
    cats = {label: [] for label, _ in MAIN_CATS}
    other = []
    for app in Gio.AppInfo.get_all():
        try:
            if not app.should_show():
                continue
        except Exception:
            continue
        name = (app.get_name() or "").replace(",", " ").strip()
        appid = app.get_id() or ""
        if not name or not appid:
            continue
        raw = getattr(app, "get_categories", lambda: None)() or ""
        decl = {c for c in raw.rstrip(";").split(";") if c}
        placed = False
        for label, keys in MAIN_CATS:
            if decl & keys:
                cats[label].append((name, appid)); placed = True
        if not placed:
            other.append((name, appid))
    for k in cats:
        cats[k].sort(key=lambda x: x[0].lower())
    other.sort(key=lambda x: x[0].lower())
    return cats, other


# ---- jgmenu emission --------------------------------------------------
def title(group):
    return group.replace("-", " ").title()


def sanitize(s):
    return re.sub(r"[^A-Za-z0-9]+", "_", s).strip("_").lower()


def hy(sub):
    return "kitty --class hyprism-center -e hyprism " + sub


def tool_cmd(tool):
    return tool if tool in GUI_APPS else "kitty -e " + tool


ROOT = []
TAGS = []


def tag(tag_id, items):
    TAGS.append(["^tag(%s)" % tag_id] + items)


def emit():
    ROOT.append("Applications,^checkout(apps)")
    ROOT.append("BlackArch,^checkout(blackarch)")
    ROOT.append("Hyprism,^checkout(hyprism)")
    ROOT.append("Terminals,^checkout(terms)")
    ROOT.append("Browsers,^checkout(browsers)")
    ROOT.append("^sep()")
    if shutil.which("thunar"):
        ROOT.append("Files,thunar")
    if shutil.which("hyprlock"):
        ROOT.append("Lock screen,hyprlock")

    # Applications
    cats, other = app_categories()
    app_items = []
    launcher = "gtk-launch" if shutil.which("gtk-launch") else ""
    for label, _ in MAIN_CATS:
        items = cats[label]
        if not items:
            continue
        tid = "app_" + sanitize(label)
        app_items.append("%s,^checkout(%s)" % (label, tid))
        tag(tid, ["%s,%s %s" % (n, launcher, i) for n, i in items])
    if other:
        app_items.append("Other,^checkout(app_other)")
        tag("app_other", ["%s,%s %s" % (n, launcher, i) for n, i in other])
    tag("apps", app_items or ["(none),:"])

    # BlackArch
    ba_items = []
    for idx, (label, groups) in enumerate(SPECIALTIES):
        present = [g for g in groups if group_tools("blackarch-" + g)]
        if not present:
            continue
        sid = "spec_%d" % idx
        ba_items.append("%s,^checkout(%s)" % (label, sid))
        spec_items = []
        for g in present:
            cid = "cat_" + sanitize(g)
            spec_items.append("%s,^checkout(%s)" % (title(g), cid))
            tag(cid, ["%s,%s" % (t, tool_cmd(t)) for t in group_tools("blackarch-" + g)])
        tag(sid, spec_items)
    tag("blackarch", ba_items or ["(none installed),:"])

    # Hyprism config
    tag("hyprism", [
        "Appearance,^checkout(hy_app)",
        "System,^checkout(hy_sys)",
        "Keybindings,%s" % hy("binds"),
        "Language,^checkout(hy_lang)",
        "^sep()",
        "Full center,%s" % hy("menu"),
        "Active config,%s" % hy("config"),
        "Sync theme,%s" % hy("sync"),
    ])
    tag("hy_app", ["%s,%s" % (lbl, hy(sub)) for lbl, sub in APPEARANCE])
    tag("hy_sys", [
        "Network,kitty --class hyprism-center -e nmtui",
        "Sound,%s" % (shutil.which("pavucontrol") and "pavucontrol" or hy("system")),
        "Bluetooth,%s" % (shutil.which("blueman-manager") and "blueman-manager" or hy("system")),
        "Displays,%s" % (shutil.which("nwg-displays") and "nwg-displays" or hy("system")),
    ])
    tag("hy_lang", ["English,hyprism lang en", "Português,hyprism lang pt"])

    # Terminals / Browsers
    tag("terms", ["%s,%s" % (t, t) for t in TERMINALS if shutil.which(t)] or ["(none),:"])
    tag("browsers", ["%s,%s" % (b, b) for b in BROWSERS if shutil.which(b)] or ["(none),:"])

    # No blank lines between blocks: jgmenu treats a blank line as an empty
    # item, which shows up as empty rows/columns.
    out = list(ROOT)
    for block in TAGS:
        out.extend(block)
    sys.stdout.write("\n".join(out) + "\n")


if __name__ == "__main__":
    emit()
