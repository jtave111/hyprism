# Floating desktop — everything floats like KDE/macOS, shadows, bottom bar
# pt: Desktop flutuante — tudo flutua como no KDE/macOS, sombras, barra embaixo
paleta=one-dark
float_all=sim
win_size=60% 60%
border=1
rounding=10
gaps_in=4
gaps_out=8
blur=off
shadow=on
shadow_range=24
active_op=100
inactive_op=97
anim=equilibrada
bar_style=pills
bar_margin=6
bar_radius=12
bar_gap=3
barh=34
barpos=bottom
bar_launcher=on
lock_field_style=pill
